-- Sell
----------------------------------------------------------------------
defs.Sell = {
	Title = "Scrap Exchange",
	Emoji = "💰",
	Color = Color3.fromRGB(60, 200, 100),
	Build = function(content)
		local top =
			UIKit.new("Frame", { Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 64), ZIndex = 13, Parent = content })
		UIKit.label(top, {
			Name = "Summary",
			Text = "",
			Size = UDim2.new(1, -300, 0, 28),
			Position = UDim2.fromOffset(4, 4),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = C.DarkText,
			StrokeThickness = 0,
			ZIndex = 14,
		})
		UIKit.label(top, {
			Name = "Dirty",
			Text = "",
			Size = UDim2.new(1, -300, 0, 22),
			Position = UDim2.fromOffset(4, 36),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = Color3.fromRGB(190, 110, 60),
			Font = UIKit.BodyFont,
			StrokeThickness = 0,
			ZIndex = 14,
		})
		UIKit.button(top, {
			Name = "SellAll",
			Text = "SELL ALL",
			Color = C.Green,
			Size = UDim2.fromOffset(270, 60),
			Position = UDim2.new(1, -4, 0, 2),
			AnchorPoint = Vector2.new(1, 0),
			ZIndex = 14,
			OnClick = function()
				local ok, res = request("Sell", "All")
				if not ok then
					Notify.toast(res or "Nothing to sell", "error")
				end
			end,
		})
		local body = UIKit.new("Frame", {
			Name = "Body",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, -76),
			Position = UDim2.fromOffset(0, 76),
			ZIndex = 13,
			Parent = content,
		})
		UIKit.scrollList(body, 8)
	end,
	Refresh = function(content)
		local d = State.Data
		local top = content:FindFirstChild("Top") :: Frame
		local list = (content:FindFirstChild("Body") :: Frame):FindFirstChild("List") :: ScrollingFrame
		UIKit.clear(list)
		local old = list.Parent:FindFirstChild("Empty")
		if old then
			old:Destroy()
		end
		local stacks = State.stacks(function(_, stars)
			return stars > 0
		end)
		local total, count = 0, 0
		for _, s in ipairs(stacks) do
			local each = Config.SellPrice(s.Id, s.Stars, d.Upgrades.SellBonus or 0, d.Machines.PolishLab or 0)
			total += each * s.Count
			count += s.Count
		end
		top:FindFirstChild("Summary").Text =
			string.format("%d clean item%s  •  Worth %s", count, count == 1 and "" or "s", Format.cash(total))
		local dirty = State.dirtyCount()
		top:FindFirstChild("Dirty").Text = dirty > 0
				and string.format("🧽 %d dirty item%s must be washed before selling", dirty, dirty == 1 and "" or "s")
			or ""
		UIKit.setButton(
			top:FindFirstChild("SellAll") :: TextButton,
			count > 0 and ("SELL ALL " .. Format.cash(total)) or "SELL ALL",
			count > 0 and C.Green or C.Grey
		)
		if #stacks == 0 then
			emptyMessage(list.Parent :: Instance, "No clean scrap to sell!\nWash your scrap at a Wash Station first. 🫧")
			return
		end
		for i, s in ipairs(stacks) do
			local rarity = Config.Rarities[s.Def.Rarity]
			local each = Config.SellPrice(s.Id, s.Stars, d.Upgrades.SellBonus or 0, d.Machines.PolishLab or 0)
			local row = UIKit.card(list, rarity.Color, i)
			row.Size = UDim2.new(1, -8, 0, 84)
			local iconBox = UIKit.new("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.3,
				Size = UDim2.fromOffset(68, 68),
				Position = UDim2.fromOffset(8, 8),
				ZIndex = 14,
				Parent = row,
			})
			UIKit.corner(iconBox, 12)
			UIKit.gradient(iconBox, UIKit.lighten(rarity.Color, 0.6), UIKit.lighten(rarity.Color2, 0.3))
			UIKit.viewport(iconBox, ScrapModels.create(s.Id, true), { ZIndex = 15 })
			UIKit.label(row, {
				Text = string.format("%s  x%d", s.Def.Name, s.Count),
				Size = UDim2.new(0, 300, 0, 28),
				Position = UDim2.fromOffset(88, 10),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = C.DarkText,
				StrokeThickness = 0,
				ZIndex = 15,
			})
			UIKit.label(row, {
				Text = starText(s.Stars),
				Size = UDim2.new(0, 90, 0, 24),
				Position = UDim2.fromOffset(88, 44),
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = C.Yellow,
				StrokeThickness = 2,
				ZIndex = 15,
			})
			UIKit.rarityChip(row, rarity, { Position = UDim2.fromOffset(186, 46) })
			UIKit.label(row, {
				Text = Format.cash(each) .. " each",
				Size = UDim2.new(0, 140, 0, 22),
				Position = UDim2.new(1, -170, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
				TextXAlignment = Enum.TextXAlignment.Right,
				TextColor3 = Color3.fromRGB(40, 150, 70),
				Font = UIKit.BodyFont,
				StrokeThickness = 0,
				ZIndex = 15,
			})
			priceButton(row, {
				Text = "SELL " .. Format.cash(each * s.Count),
				Color = C.Green,
				Size = UDim2.fromOffset(150, 52),
				Position = UDim2.new(1, -12, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
				ZIndex = 16,
				OnClick = function()
					local ok, res = request("Sell", s.Key)
					if not ok then
						Notify.toast(res or "Can't sell", "error")
					end
				end,
			})
		end
	end,
}

----------------------------------------------------------------------
-- Zones
----------------------------------------------------------------------
defs.Zones = {
	Title = "Zones",
	Emoji = "🗺️",
	Color = Color3.fromRGB(170, 100, 255),
	Size = UDim2.fromOffset(820, 500),
	Build = function(content)
		UIKit.scrollGrid(content, UDim2.fromOffset(186, 360), 12)
	end,
	Refresh = function(content)
		local d = State.Data
		local grid = content:FindFirstChild("Grid") :: ScrollingFrame
		UIKit.clear(grid)
		for i, id in ipairs(Config.ZoneOrder) do
			local def = Config.Zones[id]
			local unlocked = d.Zones[id] == true
			local prev = Config.ZoneOrder[def.Order - 1]
			local available = not prev or d.Zones[prev] == true
			local card = UIKit.card(grid, def.Color, i)
			local banner = UIKit.new("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				Size = UDim2.new(1, -16, 0, 100),
				Position = UDim2.fromOffset(8, 8),
				ZIndex = 14,
				Parent = card,
			})
			UIKit.corner(banner, 12)
			UIKit.gradient(banner, UIKit.lighten(def.Color, 0.25), UIKit.darken(def.Color, 0.3))
			UIKit.label(banner, {
				Text = def.Emoji,
				Font = Enum.Font.GothamBold,
				Size = UDim2.fromScale(0.6, 0.8),
				Position = UDim2.fromScale(0.5, 0.5),
				AnchorPoint = Vector2.new(0.5, 0.5),
				StrokeThickness = 0,
				ZIndex = 15,
			})
			if not unlocked then
				UIKit.label(banner, {
					Text = "🔒",
					Font = Enum.Font.GothamBold,
					Size = UDim2.fromOffset(34, 34),
					Position = UDim2.new(1, -4, 0, 4),
					AnchorPoint = Vector2.new(1, 0),
					StrokeThickness = 0,
					ZIndex = 16,
				})
			end
			UIKit.label(card, {
				Text = def.Name,
				Size = UDim2.new(1, -12, 0, 28),
				Position = UDim2.fromOffset(6, 112),
				TextColor3 = UIKit.darken(def.Color, 0.1),
				ZIndex = 15,
				StrokeThickness = 2.5,
			})
			-- drop chances
			local total = 0
			for _, w in pairs(def.Weights) do
				total += w
			end
			local y = 146
			for _, r in ipairs(Config.RarityOrder) do
				local w = def.Weights[r]
				if w then
					local rarity = Config.Rarities[r]
					UIKit.rarityChip(card, rarity, { Position = UDim2.fromOffset(12, y), Size = UDim2.fromOffset(100, 20) })
					UIKit.label(card, {
						Text = string.format("%d%%", math.floor(w / total * 100 + 0.5)),
						Size = UDim2.fromOffset(56, 20),
						Position = UDim2.fromOffset(118, y),
						TextXAlignment = Enum.TextXAlignment.Left,
						TextColor3 = C.DarkText,
						StrokeThickness = 0,
						ZIndex = 15,
					})
					y += 26
				end
			end
			local text, color
			if unlocked then
				text, color = "TELEPORT", C.Blue
			elseif not available then
				text, color = "🔒 LOCKED", C.Grey
			else
				text = "UNLOCK " .. Format.cash(def.Price)
				color = d.Cash >= def.Price and C.Green or C.Red
			end
			priceButton(card, {
				Text = text,
				Color = color,
				Size = UDim2.new(1, -20, 0, 48),
				Position = UDim2.new(0.5, 0, 1, -10),
				AnchorPoint = Vector2.new(0.5, 1),
				ZIndex = 16,
				OnClick = function()
					if unlocked then
						local ok, err = request("Teleport", id)
						if ok then
							Panels.close()
						else
							Notify.toast(err or "Can't teleport", "error")
						end
					elseif available then
						local ok, err = request("UnlockZone", id)
						if ok then
							Notify.banner("ZONE UNLOCKED!", def.Emoji .. " " .. def.Name, def.Color)
						else
							Notify.toast(err or "Can't unlock", "error")
						end
					else
						Notify.toast("Unlock " .. Config.Zones[prev].Name .. " first!", "error")
					end
				end,
			})
		end
	end,
}

----------------------------------------------------------------------
-- Wash station item picker
----------------------------------------------------------------------
defs.CleanSelect = {
	Title = "Pick scrap to wash",
	Emoji = "🫧",
	Color = Color3.fromRGB(60, 170, 255),
	Build = function(content)
		UIKit.label(content, {
			Name = "Hint",
			Text = "",
			Size = UDim2.new(1, 0, 0, 24),
			TextColor3 = C.DarkText,
			Font = UIKit.BodyFont,
			StrokeThickness = 0,
			ZIndex = 14,
		})
		local body = UIKit.new("Frame", {
			Name = "Body",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, -34),
			Position = UDim2.fromOffset(0, 34),
			ZIndex = 13,
			Parent = content,
		})
		UIKit.scrollGrid(body, UDim2.fromOffset(148, 214), 12)
	end,
	Refresh = function(content, ctx)
		local d = State.Data
		local batch = Config.WashBatch(d.Upgrades.WashTub or 0)
		content:FindFirstChild("Hint").Text = string.format("Your tub washes up to %d of the same scrap at once  🛁", batch)
		local grid = (content:FindFirstChild("Body") :: Frame):FindFirstChild("Grid") :: ScrollingFrame
		UIKit.clear(grid)
		local stacks = State.stacks(function(_, stars)
			return stars == 0
		end)
		if #stacks == 0 then
			Panels.close()
			Notify.toast("No dirty scrap left!", "info")
			return
		end
		for i, s in ipairs(stacks) do
			local rarity = Config.Rarities[s.Def.Rarity]
			local card = UIKit.card(grid, rarity.Color, i)
			scrapViewport(card, s.Id, false, false, true)
			UIKit.label(card, {
				Text = "x" .. s.Count,
				Size = UDim2.fromOffset(60, 26),
				Position = UDim2.new(1, -12, 0, 12),
				AnchorPoint = Vector2.new(1, 0),
				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = 17,
				StrokeThickness = 2.5,
			})
			UIKit.label(card, {
				Text = s.Def.Name,
				Size = UDim2.new(1, -12, 0, 22),
				Position = UDim2.fromOffset(6, 116),
				TextColor3 = C.DarkText,
				StrokeThickness = 0,
				ZIndex = 16,
			})
			UIKit.rarityChip(
				card,
				rarity,
				{ Position = UDim2.new(0.5, 0, 0, 142), AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.fromOffset(110, 20) }
			)
			local n = math.min(batch, s.Count)
			UIKit.button(card, {
				Text = "WASH x" .. n,
				Color = C.Blue,
				Size = UDim2.new(1, -20, 0, 38),
				Position = UDim2.new(0.5, 0, 1, -8),
				AnchorPoint = Vector2.new(0.5, 1),
				ZIndex = 16,
				OnClick = function()
					local ok, session = request("StartCleaning", ctx and ctx.Station, s.Id)
					if ok then
						Panels.close()
						onStartCleaning(session, ctx.Station)
					else
						Notify.toast(session or "Can't start washing", "error")
					end
				end,
			})
		end
	end,
}

----------------------------------------------------------------------
-- Framework
----------------------------------------------------------------------
function Panels.init(screen: ScreenGui, requestFn, startCleaningFn)
	gui = screen
	request = requestFn
	onStartCleaning = startCleaningFn
	overlay = UIKit.new("TextButton", {
		Name = "Overlay",
		Text = "",
		AutoButtonColor = false,
		BackgroundColor3 = Color3.fromRGB(10, 12, 30),
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 9,
		Parent = gui,
	})
	overlay.Activated:Connect(function()
		Panels.close()
	end)
	for name, def in pairs(defs) do
		local frame, content, close = UIKit.panel(gui, {
			Name = name .. "Panel",
			Title = def.Title,
			Emoji = def.Emoji,
			Color = def.Color,
			Size = def.Size or UDim2.fromOffset(760, 500),
		})
		def.Frame = frame
		def.Content = content
		def.Build(content)
		close.Activated:Connect(function()
			Sound.play("Click")
			Panels.close()
		end)
	end
	State.Changed.Event:Connect(function()
		if current then
			Panels.refresh()
		end
	end)
end

function Panels.refresh()
	if not current or not State.Data then
		return
	end
	local def = defs[current]
	def.Refresh(def.Content :: Frame, currentCtx)
end

function Panels.open(name: string, ctx: any?)
	local def = defs[name]
	if not def or not State.Data then
		return
	end
	if current == name then
		currentCtx = ctx or currentCtx
		Panels.refresh()
		return
	end
	if current then
		defs[current].Frame.Visible = false
	end
	current = name
	currentCtx = ctx
	Sound.play("Open")
	overlay.Visible = true
	TweenService:Create(overlay, TweenInfo.new(0.2), { BackgroundTransparency = 0.45 }):Play()
	local frame = def.Frame :: Frame
	frame.Visible = true
	UIKit.pop(frame, 0.75)
	Panels.refresh()
end

function Panels.close()
	if not current then
		return
	end
	local def = defs[current]
	current = nil
	currentCtx = nil
	local frame = def.Frame :: Frame
	local s = frame:FindFirstChild("BounceScale") :: UIScale?
	if s then
		local t = TweenService:Create(s, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0.85 })
		t:Play()
	end
	TweenService:Create(overlay, TweenInfo.new(0.15), { BackgroundTransparency = 1 }):Play()
	task.delay(0.15, function()
		if current == nil then
			overlay.Visible = false
		end
		if defs[current or ""] ~= def then
			frame.Visible = false
		end
	end)
end

function Panels.isOpen(name: string?): boolean
	if name then
		return current == name
	end
	return current ~= nil
end

return Panels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Sound</string>
            <string name="Source"><![CDATA[-- Sound: tiny wrapper around UI / gameplay sounds (built-in Roblox sounds,
-- so they work without uploading anything).
local SoundService = game:GetService("SoundService")

local Sound = {}

local LIBRARY = {
	Click = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.5, Speed = 1.1 },
	Collect = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.45, Speed = 1.25 },
	Rare = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.7, Speed = 0.8 },
	Cash = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Speed = 1.6 },
	Swing = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.3, Speed = 1.3 },
	Hit = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.35, Speed = 1.6 },
	Error = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.6, Speed = 0.6 },
	Splash = { Id = "rbxasset://sounds/impact_water.mp3", Volume = 0.5, Speed = 1.2 },
	Scrub = { Id = "rbxasset://sounds/impact_water.mp3", Volume = 0.18, Speed = 2.2 },
	Sparkle = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Speed = 2 },
	Purchase = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.7, Speed = 1.0 },
	Open = { Id = "rbxasset://sounds/clickfast.wav", Volume = 0.4, Speed = 1.5 },
}

Sound.Enabled = true
local cache: { [string]: Sound } = {}

function Sound.play(name: string, speedMul: number?)
	if not Sound.Enabled then
		return
	end
	local def = LIBRARY[name]
	if not def then
		return
	end
	local base = cache[name]
	if not base then
		base = Instance.new("Sound")
		base.SoundId = def.Id
		base.Volume = def.Volume
		base.Parent = SoundService
		cache[name] = base
	end
	local s = base:Clone()
	s.PlaybackSpeed = def.Speed * (speedMul or 1)
	s.Parent = SoundService
	s:Play()
	s.Ended:Once(function()
		s:Destroy()
	end)
	task.delay(4, function()
		if s.Parent then
			s:Destroy()
		end
	end)
end

return Sound
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- State: the latest copy of this player's data, pushed by the server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local State = {}

State.Data = nil :: any
State.Changed = Instance.new("BindableEvent")
State.Ready = false

function State.set(data)
	State.Data = data
	State.Ready = true
	State.Changed:Fire(data)
end

function State.itemCount(): number
	local total = 0
	if State.Data then
		for _, n in pairs(State.Data.Inventory) do
			total += n
		end
	end
	return total
end

function State.capacity(): number
	if not State.Data then
		return 0
	end
	return Config.BackpackCapacity(State.Data.Upgrades.Backpack or 0)
end

-- Inventory as a sorted list of stacks.
function State.stacks(filter: ((string, number) -> boolean)?)
	local list = {}
	if not State.Data then
		return list
	end
	for key, n in pairs(State.Data.Inventory) do
		local id, stars = Config.ParseKey(key)
		if id and n > 0 and (not filter or filter(id, stars)) then
			table.insert(list, { Key = key, Id = id, Stars = stars, Count = n, Def = Config.Scraps[id] })
		end
	end
	table.sort(list, function(a, b)
		local ra = Config.Rarities[a.Def.Rarity].Order
		local rb = Config.Rarities[b.Def.Rarity].Order
		if ra ~= rb then
			return ra > rb
		end
		if a.Id ~= b.Id then
			return a.Def.Value > b.Def.Value
		end
		return a.Stars > b.Stars
	end)
	return list
end

function State.dirtyCount(): number
	local n = 0
	for _, s in
		ipairs(State.stacks(function(_, stars)
			return stars == 0
		end))
	do
		n += s.Count
	end
	return n
end

function State.cleanCount(): number
	local n = 0
	for _, s in
		ipairs(State.stacks(function(_, stars)
			return stars > 0
		end))
	do
		n += s.Count
	end
	return n
end

function State.toolPower(): number
	local d = State.Data
	if not d then
		return 0
	end
	local tool = Config.Tools[d.EquippedTool]
	return tool and tool.Power * Config.ToolPowerMultiplier(d.Upgrades.ToolStrength or 0) or 0
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">ToolController</string>
            <string name="Source"><![CDATA[-- ToolController: point at scrap and hold click (or tap) to work it loose with
-- the equipped tool. Shows hover info, HP bars, damage numbers and hit FX.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local State = require(script.Parent.State)
local Sound = require(script.Parent.Sound)
local UIKit = require(script.Parent.UIKit)

local ToolController = {}

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local remotes: Folder
local scrapsFolder: Folder
local isBlocked: () -> boolean

local equipped: Tool? = nil
local holding = false
local nextSwing = 0
local hovered: Model? = nil
local highlight: Highlight
local hoverGui: BillboardGui
local hoverName: TextLabel
local hoverRarity: TextLabel
local hoverFill: Frame
local hoverWarn: TextLabel

local function scrapFromPart(part: Instance?): Model?
	while part and part ~= workspace do
		if part.Parent == scrapsFolder and part:IsA("Model") then
			return part
		end
		part = part.Parent
	end
	return nil
end

local function rootPart(): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function toolDef()
	local d = State.Data
	return d and Config.Tools[d.EquippedTool]
end

local function scrapPos(m: Model): Vector3
	local pp = m.PrimaryPart
	return pp and pp.Position or m:GetPivot().Position
end

local function inRange(m: Model, def): boolean
	local root = rootPart()
	if not root then
		return false
	end
	local pp = m.PrimaryPart :: BasePart?
	local size = pp and pp.Size.Magnitude / 2 or 2
	return (scrapPos(m) - root.Position).Magnitude <= def.Range + size
end

-- Picks the scrap under the cursor, else the nearest one in front of you.
local function findTargets(def): { Model }
	local targets = {}
	local root = rootPart()
	if not root then
		return targets
	end
	local primary = scrapFromPart(mouse.Target)
	if primary and inRange(primary, def) then
		table.insert(targets, primary)
	end
	local candidates = {}
	for _, m in ipairs(scrapsFolder:GetChildren()) do
		if m:IsA("Model") and m ~= primary and inRange(m, def) then
			local offset = scrapPos(m) - root.Position
			local facing = root.CFrame.LookVector:Dot(offset.Unit)
			table.insert(candidates, { M = m, Score = offset.Magnitude - facing * 6 })
		end
	end
	table.sort(candidates, function(a, b)
		return a.Score < b.Score
	end)
	for _, c in ipairs(candidates) do
		if #targets >= def.Targets then
			break
		end
		table.insert(targets, c.M)
	end
	return targets
end

local function damageNumber(position: Vector3, text: string, color: Color3)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position + Vector3.new(math.random(-10, 10) / 10, 1.5, math.random(-10, 10) / 10))
	anchor.Parent = workspace.CurrentCamera
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(140, 50)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = anchor
	local l = UIKit.label(bb, {
		Text = text,
		Size = UDim2.fromScale(1, 1),
		TextColor3 = color,
		StrokeThickness = 3,
	})
	UIKit.pop(l, 0.4)
	TweenService
		:Create(
			anchor,
			TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ CFrame = anchor.CFrame + Vector3.new(0, 3, 0) }
		)
		:Play()
	TweenService:Create(l, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { TextTransparency = 1 }):Play()
	local st = l:FindFirstChildOfClass("UIStroke")
	if st then
		TweenService:Create(st, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 1 }):Play()
	end
	task.delay(0.85, function()
		anchor:Destroy()
	end)
end

local function hitFX(m: Model, rarity)
	local pos = scrapPos(m)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(pos)
	p.Parent = workspace.CurrentCamera
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), rarity.Color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	e.Lifetime = NumberRange.new(0.25, 0.45)
	e.Speed = NumberRange.new(10, 18)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 1
	e.Rate = 0
	e.Parent = p
	e:Emit(14)
	local dust = Instance.new("ParticleEmitter")
	dust.Texture = "rbxasset://textures/particles/smoke_main.dds"
	dust.Color = ColorSequence.new(Color3.fromRGB(150, 120, 90))
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 2.5) })
	dust.Transparency = NumberSequence.new(0.5, 1)
	dust.Lifetime = NumberRange.new(0.4, 0.7)
	dust.Speed = NumberRange.new(3, 6)
	dust.SpreadAngle = Vector2.new(180, 180)
	dust.Rate = 0
	dust.Parent = p
	dust:Emit(5)
	task.delay(1, function()
		p:Destroy()
	end)
	-- local wobble of the scrap model
	local base = m:GetPivot()
	task.spawn(function()
		for i = 1, 4 do
			if not m.Parent then
				return
			end
			local s = (i % 2 == 0) and 1 or -1
			m:PivotTo(base * CFrame.Angles(math.rad(6 * s), 0, math.rad(-6 * s)))
			task.wait(0.03)
		end
		if m.Parent then
			m:PivotTo(base)
		end
	end)
end

local function swing()
	local def = toolDef()
	local tool = equipped
	if not def or not tool then
		return
	end
	-- play the default slash animation + sound
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = tool
	task.delay(0.3, function()
		anim:Destroy()
	end)
	Sound.play("Swing", 0.9 + math.random() * 0.25)

	local targets = findTargets(def)
	if #targets == 0 then
		return
	end
	local ids = {}
	local power = State.toolPower()
	local full = State.itemCount() >= State.capacity()
	for _, m in ipairs(targets) do
		table.insert(ids, m:GetAttribute("Id"))
		local rarity = Config.Rarities[m:GetAttribute("Rarity") :: string] or Config.Rarities.Common
		local zone = m:GetAttribute("Zone") :: string
		if full then
			break -- the server rejects the hit and shows the backpack warning
		elseif State.Data and not State.Data.Zones[zone] then
			damageNumber(scrapPos(m), "🔒", Color3.fromRGB(255, 120, 120))
		elseif power < rarity.MinPower then
			damageNumber(scrapPos(m), "TOO TOUGH!", Color3.fromRGB(255, 90, 90))
		else
			hitFX(m, rarity)
			Sound.play("Hit", 0.9 + math.random() * 0.3)
			damageNumber(scrapPos(m), "-" .. Format.short(power), Color3.fromRGB(255, 240, 120))
		end
	end
	remotes.Hit:FireServer(ids)
end

----------------------------------------------------------------------
-- hover info
----------------------------------------------------------------------
local function buildHover()
	highlight = Instance.new("Highlight")
	highlight.Name = "ScrapHover"
	highlight.FillTransparency = 0.85
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	highlight.Parent = workspace.CurrentCamera

	hoverGui = Instance.new("BillboardGui")
	hoverGui.Name = "ScrapInfo"
	hoverGui.Size = UDim2.fromOffset(210, 84)
	hoverGui.StudsOffsetWorldSpace = Vector3.new(0, 3.2, 0)
	hoverGui.AlwaysOnTop = true
	hoverGui.LightInfluence = 0
	hoverGui.Enabled = false
	hoverGui.Parent = player:WaitForChild("PlayerGui")
	hoverName = UIKit.label(hoverGui, { Text = "", Size = UDim2.new(1, 0, 0, 30), StrokeThickness = 3 })
	hoverRarity =
		UIKit.label(hoverGui, { Text = "", Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 28), StrokeThickness = 2.5 })
	local _, fill =
		UIKit.bar(hoverGui, { Size = UDim2.new(0.9, 0, 0, 14), Position = UDim2.new(0.05, 0, 0, 52), Color = UIKit.Colors.Green })
	hoverFill = fill
	hoverWarn = UIKit.label(hoverGui, {
		Text = "",
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 68),
		TextColor3 = Color3.fromRGB(255, 110, 110),
		StrokeThickness = 2,
	})
end

local function updateHover()
	local target: Model? = nil
	if not isBlocked() then
		target = scrapFromPart(mouse.Target)
		if not target and UserInputService.TouchEnabled and equipped then
			local def = toolDef()
			if def then
				target = findTargets(def)[1]
			end
		end
	end
	if target ~= hovered then
		hovered = target
		if target then
			local rarity = Config.Rarities[target:GetAttribute("Rarity") :: string] or Config.Rarities.Common
			local scrap = Config.Scraps[target:GetAttribute("ScrapId") :: string]
			highlight.Adornee = target
			highlight.OutlineColor = rarity.Color
			highlight.FillColor = rarity.Color
			highlight.Enabled = true
			hoverGui.Adornee = target.PrimaryPart
			hoverGui.Enabled = true
			hoverName.Text = scrap and scrap.Name or "Scrap"
			hoverRarity.Text = string.upper(rarity.Name)
			hoverRarity.TextColor3 = rarity.Color
			local grad = hoverFill:FindFirstChildOfClass("UIGradient")
			if grad then
				grad.Color = ColorSequence.new(UIKit.lighten(rarity.Color, 0.2), rarity.Color2)
			end
		else
			highlight.Enabled = false
			hoverGui.Enabled = false
		end
	end
	if hovered then
		local hp = (hovered:GetAttribute("HP") :: number?) or 1
		local max = (hovered:GetAttribute("MaxHP") :: number?) or 1
		hoverFill.Size = UDim2.fromScale(math.clamp(hp / max, 0, 1), 1)
		local rarity = Config.Rarities[hovered:GetAttribute("Rarity") :: string] or Config.Rarities.Common
		local zone = hovered:GetAttribute("Zone") :: string
		if State.Data and not State.Data.Zones[zone] then
			hoverWarn.Text = "🔒 Zone locked"
		elseif State.toolPower() < rarity.MinPower then
			hoverWarn.Text = string.format("Needs %d tool power", rarity.MinPower)
		else
			hoverWarn.Text = ""
		end
	end
end

----------------------------------------------------------------------
local hooked = setmetatable({}, { __mode = "k" }) :: { [Tool]: boolean }

local function watchCharacter(char: Model)
	equipped = nil
	holding = false
	local function onChild(child: Instance)
		if child:IsA("Tool") and child:GetAttribute("ToolId") then
			equipped = child
			if hooked[child] then
				return
			end
			hooked[child] = true
			child.Activated:Connect(function()
				holding = true
			end)
			child.Deactivated:Connect(function()
				holding = false
			end)
			child.Unequipped:Connect(function()
				if equipped == child then
					equipped = nil
					holding = false
				end
			end)
		end
	end
	char.ChildAdded:Connect(onChild)
	for _, c in ipairs(char:GetChildren()) do
		onChild(c)
	end
end

function ToolController.init(remoteFolder: Folder, blocked: () -> boolean)
	remotes = remoteFolder
	isBlocked = blocked
	scrapsFolder = workspace:WaitForChild("Scraps") :: Folder
	buildHover()
	player.CharacterAdded:Connect(watchCharacter)
	if player.Character then
		watchCharacter(player.Character)
	end
	RunService.RenderStepped:Connect(function()
		updateHover()
		if holding and equipped and equipped.Parent == player.Character and not isBlocked() then
			local now = os.clock()
			if now >= nextSwing then
				local def = toolDef()
				nextSwing = now + (def and def.Cooldown or 0.5)
				swing()
			end
		end
	end)
end

return ToolController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">UIKit</string>
            <string name="Source"><![CDATA[-- UIKit: the visual language of the game's UI — chunky, glossy, bouncy
-- simulator style. Every screen is built from these helpers.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Assets = require(ReplicatedStorage.Shared.Assets)
local Sound = require(script.Parent.Sound)

local UIKit = {}

UIKit.Font = Enum.Font.FredokaOne
UIKit.BodyFont = Enum.Font.GothamBold

UIKit.Colors = {
	Outline = Color3.fromRGB(28, 30, 52),
	Panel = Color3.fromRGB(255, 255, 255),
	Panel2 = Color3.fromRGB(222, 232, 255),
	Card = Color3.fromRGB(244, 247, 255),
	Text = Color3.fromRGB(255, 255, 255),
	DarkText = Color3.fromRGB(40, 44, 70),
	Green = Color3.fromRGB(70, 220, 100),
	Blue = Color3.fromRGB(60, 160, 255),
	Red = Color3.fromRGB(255, 80, 90),
	Yellow = Color3.fromRGB(255, 200, 50),
	Orange = Color3.fromRGB(255, 140, 50),
	Purple = Color3.fromRGB(160, 100, 255),
	Pink = Color3.fromRGB(255, 100, 190),
	Grey = Color3.fromRGB(150, 156, 176),
	Cash = Color3.fromRGB(110, 255, 120),
}

local function lighten(c: Color3, amt: number): Color3
	return c:Lerp(Color3.new(1, 1, 1), amt)
end
local function darken(c: Color3, amt: number): Color3
	return c:Lerp(Color3.new(0, 0, 0), amt)
end
UIKit.lighten = lighten
UIKit.darken = darken

function UIKit.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local inst = Instance.new(className :: any)
	if props then
		local parent = props.Parent
		for k, v in pairs(props) do
			if k ~= "Parent" then
				inst[k] = v
			end
		end
		if children then
			for _, c in ipairs(children) do
				c.Parent = inst
			end
		end
		if parent then
			inst.Parent = parent
		end
	end
	return inst
end

function UIKit.corner(parent: Instance, radius: number?): UICorner
	return UIKit.new("UICorner", { CornerRadius = UDim.new(0, radius or 14), Parent = parent })
end

function UIKit.round(parent: Instance): UICorner
	return UIKit.new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = parent })
end

function UIKit.stroke(parent: Instance, thickness: number?, color: Color3?, border: boolean?): UIStroke
	return UIKit.new("UIStroke", {
		Thickness = thickness or 3,
		Color = color or UIKit.Colors.Outline,
		ApplyStrokeMode = border and Enum.ApplyStrokeMode.Border or Enum.ApplyStrokeMode.Contextual,
		LineJoinMode = Enum.LineJoinMode.Round,
		Parent = parent,
	})
end

function UIKit.gradient(parent: Instance, c1: Color3, c2: Color3, rotation: number?): UIGradient
	return UIKit.new("UIGradient", {
		Color = ColorSequence.new(c1, c2),
		Rotation = rotation or 90,
		Parent = parent,
	})
end

function UIKit.padding(parent: Instance, px: number)
	return UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		Parent = parent,
	})
end

-- Text with a thick dark outline (the classic simulator look).
function UIKit.label(parent: Instance, props: { [string]: any }): TextLabel
	local strokeThickness = props.StrokeThickness or 2.5
	local strokeColor = props.StrokeColor or UIKit.Colors.Outline
	props.StrokeThickness = nil
	props.StrokeColor = nil
	local base = {
		BackgroundTransparency = 1,
		Font = UIKit.Font,
		TextColor3 = UIKit.Colors.Text,
		TextScaled = true,
		Parent = parent,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	local label = UIKit.new("TextLabel", base)
	if strokeThickness > 0 then
		UIKit.new("UIStroke", {
			Thickness = strokeThickness,
			Color = strokeColor,
			LineJoinMode = Enum.LineJoinMode.Round,
			Parent = label,
		})
	end
	return label
end

-- Soft drop shadow: a sibling frame placed behind `target` (ScreenGuis use
-- Sibling z-ordering, so a child would render on top). Follows visibility.
function UIKit.shadow(target: GuiObject, offset: number?, radius: number?)
	local s = UIKit.new("Frame", {
		Name = target.Name .. "Shadow",
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.6,
		Size = target.Size,
		AnchorPoint = target.AnchorPoint,
		Position = target.Position + UDim2.fromOffset(0, offset or 6),
		ZIndex = math.max(1, target.ZIndex - 1),
		LayoutOrder = target.LayoutOrder,
		Visible = target.Visible,
		Parent = target.Parent,
	})
	UIKit.corner(s, radius or 16)
	target:GetPropertyChangedSignal("Visible"):Connect(function()
		s.Visible = target.Visible
	end)
	return s
end

-- Glossy highlight across the top half of a button/card.
function UIKit.gloss(parent: GuiObject, radius: number?)
	local g = UIKit.new("Frame", {
		Name = "Gloss",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.78,
		Size = UDim2.new(1, -8, 0.45, 0),
		Position = UDim2.new(0, 4, 0, 4),
		ZIndex = parent.ZIndex + 1,
		Parent = parent,
	})
	UIKit.corner(g, radius or 10)
	UIKit.new("UIGradient", {
		Transparency = NumberSequence.new(0.2, 1),
		Rotation = 90,
		Parent = g,
	})
	return g
end

-- Scale tween helper (needs a UIScale child).
local function getScale(gui: GuiObject): UIScale
	local s = gui:FindFirstChild("BounceScale") :: UIScale?
	if not s then
		s = UIKit.new("UIScale", { Name = "BounceScale", Parent = gui })
	end
	return s :: UIScale
end

function UIKit.pop(gui: GuiObject, from: number?)
	local s = getScale(gui)
	s.Scale = from or 0.6
	TweenService:Create(s, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function UIKit.bump(gui: GuiObject, amount: number?)
	local s = getScale(gui)
	s.Scale = amount or 1.15
	TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

function UIKit.shake(gui: GuiObject)
	local start = gui.Position
	task.spawn(function()
		for i = 1, 6 do
			gui.Position = start + UDim2.fromOffset((i % 2 == 0) and 6 or -6, 0)
			task.wait(0.03)
		end
		gui.Position = start
	end)
end

-- Icon: uses a ForgeGUI image when an asset ID is configured, otherwise emoji.
function UIKit.icon(parent: Instance, key: string, props: { [string]: any }?): GuiObject
	local image = Assets.Images[key]
	local base: { [string]: any } = {
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Parent = parent,
	}
	if props then
		for k, v in pairs(props) do
			base[k] = v
		end
	end
	if image and image ~= "" then
		base.Image = image
		base.ScaleType = Enum.ScaleType.Fit
		return UIKit.new("ImageLabel", base)
	end
	base.Text = Assets.Fallback[key] or key
	base.TextScaled = true
	base.Font = Enum.Font.GothamBold
	base.TextColor3 = Color3.new(1, 1, 1)
	return UIKit.new("TextLabel", base)
end

-- Big glossy button. opts: Text, Color, Size, Position, AnchorPoint, Icon, TextSize, OnClick
function UIKit.button(parent: Instance, opts: { [string]: any }): TextButton
	local color: Color3 = opts.Color or UIKit.Colors.Green
	local btn = UIKit.new("TextButton", {
		Name = opts.Name or "Button",
		Size = opts.Size or UDim2.fromOffset(160, 50),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.new(),
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = opts.LayoutOrder or 0,
		ZIndex = opts.ZIndex or 1,
		Parent = parent,
	})
	UIKit.corner(btn, opts.Radius or 12)
	local grad = UIKit.gradient(btn, lighten(color, 0.25), darken(color, 0.12))
	grad.Name = "Fill"
	UIKit.stroke(btn, opts.StrokeThickness or 3, UIKit.Colors.Outline, true)
	local lip = UIKit.new("Frame", {
		Name = "Lip",
		BackgroundColor3 = darken(color, 0.35),
		BackgroundTransparency = 0.25,
		Size = UDim2.new(1, 0, 0, 6),
		Position = UDim2.new(0, 0, 1, -6),
		BorderSizePixel = 0,
		ZIndex = btn.ZIndex,
		Parent = btn,
	})
	UIKit.corner(lip, 6)
	UIKit.gloss(btn)
	local label = UIKit.label(btn, {
		Name = "Label",
		Text = opts.Text or "",
		Size = UDim2.new(1, -16, 1, -12),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = btn.ZIndex + 2,
		RichText = opts.RichText or false,
		StrokeThickness = 2,
	})
	if opts.TextSize then
		label.TextScaled = false
		label.TextSize = opts.TextSize
	end
	local scale = getScale(btn)
	btn.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1.05 }):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12), { Scale = 1 }):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.06), { Scale = 0.93 }):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Scale = 1.05 }):Play()
	end)
	if opts.OnClick then
		btn.Activated:Connect(function()
			Sound.play("Click")
			opts.OnClick()
		end)
	end
	return btn
end

function UIKit.setButton(btn: TextButton, text: string, color: Color3)
	local label = btn:FindFirstChild("Label") :: TextLabel
	label.Text = text
	local fill = btn:FindFirstChild("Fill") :: UIGradient
	fill.Color = ColorSequence.new(lighten(color, 0.25), darken(color, 0.12))
	local lip = btn:FindFirstChild("Lip") :: Frame?
	if lip then
		lip.BackgroundColor3 = darken(color, 0.35)
	end
end

-- Pill-shaped info display used in the HUD.
function UIKit.pill(parent: Instance, opts: { [string]: any }): (Frame, TextLabel)
	local color: Color3 = opts.Color or UIKit.Colors.Green
	local frame = UIKit.new("Frame", {
		Name = opts.Name or "Pill",
		Size = opts.Size or UDim2.fromOffset(220, 54),
		Position = opts.Position or UDim2.new(),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = opts.LayoutOrder or 0,
		Parent = parent,
	})
	UIKit.round(frame)
	UIKit.gradient(frame, lighten(color, 0.2), darken(color, 0.15))
	UIKit.stroke(frame, 3.5, UIKit.Colors.Outline, true)
	UIKit.gloss(frame, 20)
	local iconHolder = UIKit.new("Frame", {
		Name = "Icon",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 70, 0, 70),
		Position = UDim2.new(0, -18, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		ZIndex = 4,
		Parent = frame,
	})
	UIKit.icon(iconHolder, opts.Icon or "Cash", { ZIndex = 4 })
	local text = UIKit.label(frame, {
		Name = "Value",
		Text = opts.Text or "",
		Size = UDim2.new(1, -66, 0.78, 0),
		Position = UDim2.new(0, 56, 0.5, 0),
		AnchorPoint = Vector2.new(0, 0.5),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 4,
		StrokeThickness = 3,
	})
	return frame, text
end

-- Rotating 3D preview of a model inside a ViewportFrame.
function UIKit.viewport(parent: Instance, model: Model, opts: { [string]: any }?): ViewportFrame
	local o = opts or {}
	local vpf = UIKit.new("ViewportFrame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Size = o.Size or UDim2.fromScale(1, 1),
		Position = o.Position or UDim2.new(),
		AnchorPoint = o.AnchorPoint or Vector2.new(),
		Ambient = Color3.fromRGB(170, 170, 185),
		LightColor = Color3.fromRGB(255, 250, 240),
		LightDirection = Vector3.new(-1, -1.4, -0.8),
		ZIndex = o.ZIndex or 2,
		Parent = parent,
	})
	local world = UIKit.new("WorldModel", { Parent = vpf })
	model.Parent = world
	local cf, size = model:GetBoundingBox()
	local radius = size.Magnitude / 2
	local cam = UIKit.new("Camera", { FieldOfView = 30, Parent = vpf })
	vpf.CurrentCamera = cam
	local dist = radius / math.tan(math.rad(cam.FieldOfView / 2)) * (o.Zoom or 1.05)
	local angle = o.Angle or 0.6
	local center = cf.Position
	local function place(a: number)
		local offset = Vector3.new(math.sin(a), 0.42, math.cos(a)).Unit * dist
		cam.CFrame = CFrame.lookAt(center + offset, center)
	end
	place(angle)
	if o.Spin then
		local a = angle
		local conn
		conn = game:GetService("RunService").RenderStepped:Connect(function(dt)
			if not vpf.Parent then
				conn:Disconnect()
				return
			end
			if vpf.Visible then
				a += dt * (o.SpinSpeed or 0.8)
				place(a)
			end
		end)
	end
	return vpf
end

-- Rarity tag chip.
function UIKit.rarityChip(parent: Instance, rarity, props: { [string]: any }?): Frame
	local chip = UIKit.new("Frame", {
		Name = "Rarity",
		Size = UDim2.fromOffset(90, 22),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 5,
		Parent = parent,
	})
	if props then
		for k, v in pairs(props) do
			chip[k] = v
		end
	end
	UIKit.round(chip)
	UIKit.gradient(chip, rarity.Color, rarity.Color2, 0)
	UIKit.stroke(chip, 2, UIKit.Colors.Outline, true)
	UIKit.label(chip, {
		Text = string.upper(rarity.Name),
		Size = UDim2.new(1, -8, 1, -4),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 6,
		StrokeThickness = 1.5,
	})
	return chip
end

-- Standard modal panel with header, close button and content area.
function UIKit.panel(parent: Instance, opts: { [string]: any }): (Frame, Frame, TextButton)
	local color: Color3 = opts.Color or UIKit.Colors.Blue
	local panel = UIKit.new("Frame", {
		Name = opts.Name or "Panel",
		Size = opts.Size or UDim2.fromOffset(720, 480),
		Position = UDim2.fromScale(0.5, 0.52),
		AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Visible = false,
		ZIndex = 10,
		Parent = parent,
	})
	UIKit.corner(panel, 22)
	UIKit.gradient(panel, UIKit.Colors.Panel, UIKit.Colors.Panel2)
	UIKit.stroke(panel, 5, UIKit.Colors.Outline, true)

	-- header
	local header = UIKit.new("Frame", {
		Name = "Header",
		Size = UDim2.new(1, 0, 0, 70),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = 11,
		Parent = panel,
	})
	UIKit.corner(header, 22)
	UIKit.gradient(header, lighten(color, 0.2), darken(color, 0.1))
	-- square off the header bottom
	local fillBottom = UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 24),
		Position = UDim2.new(0, 0, 1, -24),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 11,
		Parent = header,
	})
	UIKit.gradient(fillBottom, lighten(color, 0.05), darken(color, 0.1))
	-- diagonal stripes for texture
	for i = 0, 14 do
		local stripe = UIKit.new("Frame", {
			Size = UDim2.new(0, 18, 2, 0),
			Position = UDim2.new(0, i * 52 - 20, -0.5, 0),
			Rotation = 25,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.9,
			BorderSizePixel = 0,
			ZIndex = 11,
			Parent = header,
		})
		local _ = stripe
	end
	header.ClipsDescendants = true
	local headerLine = UIKit.new("Frame", {
		Size = UDim2.new(1, 0, 0, 5),
		Position = UDim2.new(0, 0, 0, 68),
		BackgroundColor3 = UIKit.Colors.Outline,
		BorderSizePixel = 0,
		ZIndex = 12,
		Parent = panel,
	})
	local _ = headerLine
	UIKit.label(panel, {
		Name = "Title",
		Text = (opts.Emoji and (opts.Emoji .. "  ") or "") .. (opts.Title or ""),
		Size = UDim2.new(1, -160, 0, 50),
		Position = UDim2.new(0, 24, 0, 10),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 13,
		StrokeThickness = 3.5,
	})

	local close = UIKit.button(panel, {
		Name = "Close",
		Text = "✕",
		Color = UIKit.Colors.Red,
		Size = UDim2.fromOffset(56, 56),
		Position = UDim2.new(1, 14, 0, -14),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 20,
		Radius = 28,
		StrokeThickness = 4,
	})
	close.Rotation = 0

	local content = UIKit.new("Frame", {
		Name = "Content",
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -36, 1, -96),
		Position = UDim2.new(0, 18, 0, 84),
		ZIndex = 12,
		Parent = panel,
	})
	return panel, content, close
end

-- Scrolling grid used by most panels.
function UIKit.scrollGrid(parent: Instance, cellSize: UDim2, padding: number?): ScrollingFrame
	local sf = UIKit.new("ScrollingFrame", {
		Name = "Grid",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = UIKit.Colors.Outline,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 12,
		Parent = parent,
	})
	UIKit.new("UIGridLayout", {
		CellSize = cellSize,
		CellPadding = UDim2.fromOffset(padding or 12, padding or 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = sf,
	})
	UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, 8),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 12),
		Parent = sf,
	})
	return sf
end

function UIKit.scrollList(parent: Instance, padding: number?): ScrollingFrame
	local sf = UIKit.new("ScrollingFrame", {
		Name = "List",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = UIKit.Colors.Outline,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ZIndex = 12,
		Parent = parent,
	})
	UIKit.new("UIListLayout", {
		Padding = UDim.new(0, padding or 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = sf,
	})
	UIKit.new("UIPadding", {
		PaddingTop = UDim.new(0, 6),
		PaddingBottom = UDim.new(0, 12),
		PaddingLeft = UDim.new(0, 4),
		PaddingRight = UDim.new(0, 12),
		Parent = sf,
	})
	return sf
end

-- White card with a coloured border.
function UIKit.card(parent: Instance, color: Color3, layoutOrder: number?): Frame
	local card = UIKit.new("Frame", {
		Name = "Card",
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = layoutOrder or 0,
		ZIndex = 13,
		Parent = parent,
	})
	UIKit.corner(card, 16)
	UIKit.gradient(card, Color3.fromRGB(255, 255, 255), lighten(color, 0.78))
	local st = UIKit.stroke(card, 3.5, darken(color, 0.25), true)
	st.Name = "Border"
	return card
end

function UIKit.clear(container: Instance)
	for _, c in ipairs(container:GetChildren()) do
		if not c:IsA("UIGridLayout") and not c:IsA("UIListLayout") and not c:IsA("UIPadding") then
			c:Destroy()
		end
	end
end

-- Horizontal progress bar.
function UIKit.bar(parent: Instance, props: { [string]: any }): (Frame, Frame)
	local back = UIKit.new("Frame", {
		Name = props.Name or "Bar",
		Size = props.Size or UDim2.fromOffset(200, 18),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.new(),
		BackgroundColor3 = Color3.fromRGB(40, 42, 66),
		ZIndex = props.ZIndex or 5,
		Parent = parent,
	})
	UIKit.round(back)
	UIKit.stroke(back, 2.5, UIKit.Colors.Outline, true)
	local fill = UIKit.new("Frame", {
		Name = "Fill",
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ZIndex = (props.ZIndex or 5) + 1,
		Parent = back,
	})
	UIKit.round(fill)
	local c: Color3 = props.Color or UIKit.Colors.Green
	UIKit.gradient(fill, lighten(c, 0.25), darken(c, 0.1))
	return back, fill
end

return UIKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">WorldFX</string>
            <string name="Source"><![CDATA[-- WorldFX: everything 3D the client handles locally — scrap pop-in, break and
-- collect effects, per-player machine holograms, gates, radar markers, the
-- guide beam and opening menus from world prompts.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local ScrapModels = require(ReplicatedStorage.Shared.ScrapModels)
local State = require(script.Parent.State)
local UIKit = require(script.Parent.UIKit)
local HUD = require(script.Parent.HUD)
local Sound = require(script.Parent.Sound)

local WorldFX = {}

local player = Players.LocalPlayer
local scrapsFolder: Folder
local hub: Instance
local openPanel: (string, any?) -> ()

local machineOriginals: { [BasePart]: { Color: Color3, Material: Enum.Material, Transparency: number } } = {}
local machineInfo: { [string]: { Name: TextLabel, Level: TextLabel } } = {}
local radarMarkers: { [Model]: BillboardGui } = {}

local function rootPart(): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function tempPart(cf: CFrame): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = cf
	p.Parent = workspace.CurrentCamera
	return p
end

----------------------------------------------------------------------
-- Scrap spawn pop-in
----------------------------------------------------------------------
local function popIn(m: Model)
	task.defer(function()
		if not m.Parent then
			return
		end
		local ok = pcall(function()
			m:ScaleTo(0.05)
		end)
		if not ok then
			return
		end
		local v = Instance.new("NumberValue")
		v.Value = 0.05
		v.Changed:Connect(function(x)
			if m.Parent then
				pcall(function()
					m:ScaleTo(math.max(0.05, x))
				end)
			end
		end)
		local tw = TweenService:Create(v, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Value = 1 })
		tw:Play()
		tw.Completed:Connect(function()
			v:Destroy()
		end)
	end)
end

----------------------------------------------------------------------
-- FX events
----------------------------------------------------------------------
local function breakFX(position: Vector3, rarityId: string)
	local rarity = Config.Rarities[rarityId] or Config.Rarities.Common
	local p = tempPart(CFrame.new(position))
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(rarity.Color, rarity.Color2)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	e.Lifetime = NumberRange.new(0.5, 0.9)
	e.Speed = NumberRange.new(12, 24)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -25, 0)
	e.LightEmission = 1
	e.Rate = 0
	e.Parent = p
	e:Emit(20 + rarity.Order * 8)
	local smoke = Instance.new("ParticleEmitter")
	smoke.Texture = "rbxasset://textures/particles/smoke_main.dds"
	smoke.Color = ColorSequence.new(Color3.fromRGB(180, 160, 130))
	smoke.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2), NumberSequenceKeypoint.new(1, 5) })
	smoke.Transparency = NumberSequence.new(0.4, 1)
	smoke.Lifetime = NumberRange.new(0.6, 1)
	smoke.Speed = NumberRange.new(4, 8)
	smoke.SpreadAngle = Vector2.new(180, 180)
	smoke.Rate = 0
	smoke.Parent = p
	smoke:Emit(8)
	if rarity.Order >= 4 then
		local flash = Instance.new("PointLight")
		flash.Color = rarity.Color
		flash.Range = 24
		flash.Brightness = 6
		flash.Parent = p
		TweenService:Create(flash, TweenInfo.new(0.6), { Brightness = 0 }):Play()
	end
	task.delay(1.5, function()
		p:Destroy()
	end)
end

-- A small copy of the scrap flies into the player.
local function collectFX(scrapId: string, position: Vector3?)
	local root = rootPart()
	if not root or not position then
		return
	end
	local model = ScrapModels.create(scrapId, false)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CastShadow = false
		end
	end
	model:PivotTo(CFrame.new(position))
	model.Parent = workspace.CurrentCamera
	local start = position
	local t0 = os.clock()
	local duration = 0.45
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - t0) / duration, 0, 1)
		local r = rootPart()
		if not r or a >= 1 then
			conn:Disconnect()
			model:Destroy()
			return
		end
		local target = r.Position + Vector3.new(0, 1, 0)
		local pos = start:Lerp(target, a * a) + Vector3.new(0, math.sin(a * math.pi) * 5, 0)
		pcall(function()
			model:ScaleTo(math.max(0.1, 1 - a * 0.85))
		end)
		model:PivotTo(CFrame.new(pos) * CFrame.Angles(a * 8, a * 10, 0))
	end)
end

function WorldFX.onFX(payload)
	local kind = payload.Kind
	if kind == "Break" then
		breakFX(payload.Position, payload.Rarity)
	elseif kind == "Collect" then
		collectFX(payload.ScrapId, payload.Position)
	end
end

----------------------------------------------------------------------
-- Machines: hologram when not owned, alive when owned
----------------------------------------------------------------------
local function setupMachines()
	local bay = hub:WaitForChild("MachineBay")
	for _, pad in ipairs(bay:GetChildren()) do
		local id = pad:GetAttribute("MachineId")
		local machine = pad:FindFirstChild("Machine")
		if id and machine and Config.Machines[id] then
			for _, d in ipairs(machine:GetDescendants()) do
				if d:IsA("BasePart") then
					machineOriginals[d] = { Color = d.Color, Material = d.Material, Transparency = d.Transparency }
				end
			end
			-- floating info sign
			local anchor = pad:FindFirstChild("InfoAnchor") :: BasePart
			local bb = Instance.new("BillboardGui")
			bb.Size = UDim2.fromOffset(260, 90)
			bb.LightInfluence = 0
			bb.MaxDistance = 90
			bb.Adornee = anchor
			bb.Parent = player:WaitForChild("PlayerGui")
			local def = Config.Machines[id]
			local name = UIKit.label(bb, {
				Text = def.Emoji .. " " .. def.Name,
				Size = UDim2.new(1, 0, 0, 40),
				TextColor3 = UIKit.lighten(def.Color, 0.2),
				StrokeThickness = 3.5,
			})
			local level =
				UIKit.label(bb, { Text = "", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 42), StrokeThickness = 3 })
			machineInfo[id] = { Name = name, Level = level }
		end
	end
end

local function refreshMachines(d)
	local bay = hub:FindFirstChild("MachineBay")
	if not bay then
		return
	end
	for _, pad in ipairs(bay:GetChildren()) do
		local id = pad:GetAttribute("MachineId")
		local machine = pad:FindFirstChild("Machine")
		if id and machine and Config.Machines[id] then
			local lvl = d.Machines[id] or 0
			local owned = lvl > 0
			machine:SetAttribute("Owned", owned)
			for _, part in ipairs(machine:GetDescendants()) do
				if part:IsA("BasePart") then
					local orig = machineOriginals[part]
					if orig and part.Name ~= "Pivot" then
						if owned then
							part.Color = orig.Color
							part.Material = orig.Material
							part.Transparency = orig.Transparency
						else
							part.Material = Enum.Material.ForceField
							part.Color = Color3.fromRGB(90, 200, 255)
							part.Transparency = 0
						end
					end
				elseif part:IsA("ParticleEmitter") and part.Name == "MachineFX" then
					part.Enabled = owned
				end
			end
			local info = machineInfo[id]
			if info then
				if owned then
					info.Level.Text = lvl >= Config.Machines[id].MaxLevel and "⭐ MAX LEVEL ⭐" or ("Level " .. lvl)
					info.Level.TextColor3 = UIKit.Colors.Yellow
				else
					info.Level.Text = "Build for " .. Format.cash(Config.MachineCost(id, 0))
					info.Level.TextColor3 = UIKit.Colors.Cash
				end
			end
		end
	end
end

-- Spins every Rotor model on owned machines (plus the Teleporter) and the
-- scrap sitting on wash stations.
local function spinLoop(dt: number)
	local bay = hub:FindFirstChild("MachineBay")
	if bay then
		for _, pad in ipairs(bay:GetChildren()) do
			local machine = pad:FindFirstChild("Machine")
			if machine and (machine:GetAttribute("Owned") or pad:GetAttribute("MachineId") == "Teleporter") then
				for _, r in ipairs(machine:GetChildren()) do
					if r:IsA("Model") and r.Name == "Rotor" and r.PrimaryPart then
						local speed = (r:GetAttribute("Speed") :: number?) or 1
						local axis = r:GetAttribute("Axis")
						local rot
						if axis == "X" then
							rot = CFrame.Angles(speed * dt, 0, 0)
						elseif axis == "Z" then
							rot = CFrame.Angles(0, 0, speed * dt)
						else
							rot = CFrame.Angles(0, speed * dt, 0)
						end
						r:PivotTo(r:GetPivot() * rot)
					end
				end
			end
		end
	end
	local shed = hub:FindFirstChild("CleaningShed")
	if shed then
		for _, st in ipairs(shed:GetChildren()) do
			local display = st:FindFirstChild("Display")
			if display and display:IsA("Model") then
				display:PivotTo(display:GetPivot() * CFrame.Angles(0, dt * 1.2, 0))
			end
		end
	end
end

----------------------------------------------------------------------
-- Gates (unlocked zones lose their barrier locally)
----------------------------------------------------------------------
local function refreshGates(d)
	local root = workspace:FindFirstChild("Scrapyard")
	if not root then
		return
	end
	for _, id in ipairs(Config.ZoneOrder) do
		local gate = root:FindFirstChild("Gate_" .. id)
		local barrier = gate and gate:FindFirstChild("Barrier") :: BasePart?
		if barrier then
			local open = d.Zones[id] == true
			barrier.CanCollide = not open
			barrier.Transparency = open and 1 or 0
			barrier.CanQuery = not open
			local tag = barrier:FindFirstChild("PriceTag") :: BillboardGui?
			if tag then
				tag.Enabled = not open
			end
			local prompt = barrier:FindFirstChild("GatePrompt") :: ProximityPrompt?
			if prompt then
				prompt.Enabled = not open
			end
		end
	end
end

----------------------------------------------------------------------
-- Rarity radar markers
----------------------------------------------------------------------
local function radarThreshold(): number?
	local d = State.Data
	local lvl = d and d.Machines.RarityRadar or 0
	if lvl <= 0 then
		return nil
	end
	return Config.MachineStats.RadarThreshold[lvl]
end

local function addMarker(m: Model)
	local threshold = radarThreshold()
	if not threshold or radarMarkers[m] then
		return
	end
	local rarity = Config.Rarities[m:GetAttribute("Rarity") :: string]
	if not rarity or rarity.Order < threshold then
		return
	end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(40, 40)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 4, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 260
	bb.Adornee = m.PrimaryPart
	bb.Parent = player:WaitForChild("PlayerGui")
	local diamond = UIKit.new("Frame", {
		Size = UDim2.fromScale(0.62, 0.62),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Rotation = 45,
		BackgroundColor3 = Color3.new(1, 1, 1),
		Parent = bb,
	})
	UIKit.corner(diamond, 4)
	UIKit.gradient(diamond, rarity.Color, rarity.Color2, 0)
	UIKit.stroke(diamond, 2.5, UIKit.Colors.Outline, true)
	radarMarkers[m] = bb
end

local function refreshRadar()
	for m, bb in pairs(radarMarkers) do
		bb:Destroy()
		radarMarkers[m] = nil
	end
	for _, m in ipairs(scrapsFolder:GetChildren()) do
		if m:IsA("Model") then
			addMarker(m)
		end
	end
end

----------------------------------------------------------------------
-- Guide beam towards the current goal
----------------------------------------------------------------------
local beam: Beam
local beamA0: Attachment
local beamA1: Attachment
local beamTargetPart: Part

local function setupBeam()
	beamTargetPart = tempPart(CFrame.new())
	beamTargetPart.Name = "GuideTarget"
	beamA1 = Instance.new("Attachment")
	beamA1.Parent = beamTargetPart
	beamA0 = Instance.new("Attachment")
	beam = Instance.new("Beam")
	beam.Attachment0 = beamA0
	beam.Attachment1 = beamA1
	beam.Width0 = 1.2
	beam.Width1 = 1.2
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Segments = 20
	beam.CurveSize0 = 0
	beam.CurveSize1 = 0
	beam.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	beam.TextureMode = Enum.TextureMode.Static
	beam.TextureLength = 3
	beam.TextureSpeed = 2
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 230, 80), Color3.fromRGB(120, 255, 140))
	beam.Transparency =
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(0.2, 0.3), NumberSequenceKeypoint.new(1, 0.1) })
	beam.Enabled = false
	beam.Parent = beamTargetPart
end

local function guideTarget(): Vector3?
	local d = State.Data
	if not d then
		return nil
	end
	local root = workspace:FindFirstChild("Scrapyard")
	if not root then
		return nil
	end
	local count, cap = State.itemCount(), State.capacity()
	local goal = HUD.CurrentGoal
	local target = goal and goal.Target
	-- full backpack overrides: go wash / sell
	if count >= cap and cap > 0 then
		target = State.cleanCount() > 0 and "Sell" or "Wash"
	end
	if target == "Wash" then
		if State.dirtyCount() == 0 then
			return nil
		end
		local shed = hub:FindFirstChild("CleaningShed")
		local best, bestDist = nil, math.huge
		local r = rootPart()
		if shed and r then
			for _, st in ipairs(shed:GetChildren()) do
				local spot = st:FindFirstChild("ItemSpot") :: BasePart?
				if spot then
					local dist = (spot.Position - r.Position).Magnitude
					if dist < bestDist then
						best, bestDist = spot.Position, dist
					end
				end
			end
		end
		return best
	elseif target == "Sell" then
		if State.cleanCount() == 0 then
			return nil
		end
		local shop = hub:FindFirstChild("ScrapExchange")
		local pad = shop and shop:FindFirstChild("SellPad") :: BasePart?
		return pad and pad.Position
	elseif target == "Tools" then
		local nextTool
		for _, id in ipairs(Config.ToolOrder) do
			if not d.Tools[id] then
				nextTool = Config.Tools[id]
				break
			end
		end
		if not nextTool or d.Cash < nextTool.Price then
			return nil
		end
		local shop = hub:FindFirstChild("ToolShop")
		local pp = shop and shop:FindFirstChild("PromptPart") :: BasePart?
		return pp and pp.Position
	elseif typeof(target) == "string" and string.sub(target, 1, 5) == "Gate_" then
		local zoneId = string.sub(target, 6)
		local zone = Config.Zones[zoneId]
		if not zone or d.Cash < zone.Price then
			return nil
		end
		local gate = root:FindFirstChild(target)
		local barrier = gate and gate:FindFirstChild("Barrier") :: BasePart?
		return barrier and barrier.Position
	elseif typeof(target) == "string" and string.sub(target, 1, 4) == "Pad_" then
		local id = string.sub(target, 5)
		if not Config.Machines[id] or d.Cash < Config.MachineCost(id, 0) then
			return nil
		end
		local bay = hub:FindFirstChild("MachineBay")
		local pad = bay and bay:FindFirstChild(target)
		local pp = pad and pad:FindFirstChild("PromptPart") :: BasePart?
		return pp and pp.Position
	end
	return nil
end

local function updateBeam()
	local r = rootPart()
	local target = guideTarget()
	if not r or not target or (target - r.Position).Magnitude < 14 then
		beam.Enabled = false
		return
	end
	if beamA0.Parent ~= r then
		beamA0.Parent = r
	end
	beamA0.Position = Vector3.new(0, -2.4, 0)
	beamTargetPart.CFrame = CFrame.new(target)
	beam.Enabled = true
end

----------------------------------------------------------------------
-- Zone detection for the banner
----------------------------------------------------------------------
local currentZone: string? = nil
local function zoneAt(pos: Vector3): string
	for _, id in ipairs(Config.ZoneOrder) do
		local z = Config.Zones[id]
		if pos.Z >= z.ZMin - 8 and pos.Z <= z.ZMax + 8 then
			return id
		end
	end
	return "Hub"
end

----------------------------------------------------------------------
function WorldFX.init(open: (string, any?) -> ())
	openPanel = open
	scrapsFolder = workspace:WaitForChild("Scraps") :: Folder
	hub = workspace:WaitForChild("Scrapyard"):WaitForChild("Hub")

	scrapsFolder.ChildAdded:Connect(function(m)
		if m:IsA("Model") then
			popIn(m)
			task.defer(addMarker, m)
		end
	end)
	scrapsFolder.ChildRemoved:Connect(function(m)
		local bb = radarMarkers[m :: Model]
		if bb then
			bb:Destroy()
			radarMarkers[m :: Model] = nil
		end
	end)

	setupMachines()
	setupBeam()

	local lastRadar = -1
	local function onState(d)
		refreshMachines(d)
		refreshGates(d)
		local lvl = d.Machines.RarityRadar or 0
		if lvl ~= lastRadar then
			lastRadar = lvl
			refreshRadar()
		end
	end
	State.Changed.Event:Connect(onState)
	if State.Data then
		onState(State.Data)
	end

	-- prompts that open menus
	ProximityPromptService.PromptTriggered:Connect(function(prompt, who)
		if who ~= player then
			return
		end
		local ui = prompt:GetAttribute("OpenUI")
		if ui == "Gate" then
			openPanel("Zones")
		elseif typeof(ui) == "string" then
			openPanel(ui, { MachineId = prompt:GetAttribute("MachineId") })
		end
	end)

	-- stepping on the sell pad opens the sell menu
	local shop = hub:WaitForChild("ScrapExchange")
	local pad = shop:WaitForChild("SellPad") :: BasePart
	local lastPad = 0
	pad.Touched:Connect(function(hit)
		local char = player.Character
		if char and hit:IsDescendantOf(char) and os.clock() - lastPad > 3 then
			lastPad = os.clock()
			openPanel("Sell")
		end
	end)

	RunService.RenderStepped:Connect(spinLoop)

	task.spawn(function()
		while true do
			task.wait(0.4)
			updateBeam()
			local r = rootPart()
			if r then
				local z = zoneAt(r.Position)
				if z ~= currentZone then
					local first = currentZone == nil
					currentZone = z
					if not first then
						if z == "Hub" then
							HUD.showZone("🏠 Scrapyard Hub", UIKit.Colors.Yellow)
						else
							local def = Config.Zones[z]
							HUD.showZone(def.Emoji .. " " .. def.Name, def.Color)
							Sound.play("Open")
						end
					end
				end
			end
		end
	end)
end

return WorldFX
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>