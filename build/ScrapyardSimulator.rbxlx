  <Item class="ServerScriptService" referent="9">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="10">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Scrapyard Simulator — server entry point.
-- Builds the shared scrapyard, creates remotes and wires up every service.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Remotes ------------------------------------------------------------
local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in ipairs({ "State", "Notify", "Open", "Hit", "FX" }) do
	local r = Instance.new("RemoteEvent")
	r.Name = name
	r.Parent = remotes
end
local action = Instance.new("RemoteFunction")
action.Name = "Action"
action.Parent = remotes
remotes.Parent = ReplicatedStorage

-- World --------------------------------------------------------------
local WorldBuilder = require(script.WorldBuilder)
WorldBuilder.build()

-- Services -----------------------------------------------------------
local DataService = require(script.DataService)
local ToolService = require(script.ToolService)
local ScrapService = require(script.ScrapService)
local CleaningService = require(script.CleaningService)
local EconomyService = require(script.EconomyService)
local MachineService = require(script.MachineService)

DataService.init(remotes)
ScrapService.init(remotes)
CleaningService.init(remotes)
EconomyService.init(remotes)
MachineService.init(remotes)

-- Actions (client -> server requests) --------------------------------
local lastAction: { [Player]: number } = {}

action.OnServerInvoke = function(player: Player, name: any, a: any, b: any)
	if typeof(name) ~= "string" or not DataService.isLoaded(player) then
		return false, "Loading..."
	end
	-- light rate limit
	local now = os.clock()
	if now - (lastAction[player] or 0) < 0.08 then
		return false, "Slow down!"
	end
	lastAction[player] = now

	local ok, result, extra = pcall(function()
		local r1, r2 = CleaningService.handleAction(player, name, a, b)
		if r1 ~= nil then
			return r1, r2
		end
		return EconomyService.handleAction(player, name, a)
	end)
	if not ok then
		warn("[Action]", name, result)
		return false, "Something went wrong"
	end
	if result == nil then
		return false, "Unknown action"
	end
	return result, extra
end

-- Players -------------------------------------------------------------
local function onPlayerAdded(player: Player)
	player.CharacterAdded:Connect(function(char)
		while player.Parent and not DataService.isLoaded(player) do
			task.wait(0.1)
		end
		ToolService.onCharacter(player, char)
	end)
	-- restore the upgrade speed after an admin /reset
	player:GetAttributeChangedSignal("SpeedOverride"):Connect(function()
		ToolService.applyStats(player)
	end)
	DataService.load(player)
	if player.Character then
		task.spawn(ToolService.onCharacter, player, player.Character)
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, p)
end

Players.PlayerRemoving:Connect(function(player)
	CleaningService.cancel(player)
	EconomyService.forget(player)
	lastAction[player] = nil
	DataService.release(player)
end)

-- Refresh walk speed whenever data changes (upgrades)
DataService.Changed.Event:Connect(function(player: Player)
	ToolService.applyStats(player)
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">CleaningService</string>
          <string name="Source"><![CDATA[-- CleaningService: runs the wash stations and validates the scrubbing
-- minigame that the client plays.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Config = require(ReplicatedStorage.Shared.Config)
local ScrapModels = require(ReplicatedStorage.Shared.ScrapModels)
local DataService = require(script.Parent.DataService)
local WorldBuilder = require(script.Parent.WorldBuilder)

local CleaningService = {}

type Session = {
	Id: string,
	Station: number,
	ScrapId: string,
	Count: number,
	Started: number,
	MinTime: number,
	ParTime: number,
	Spots: { any },
}

local sessions: { [Player]: Session } = {}
local stationOwner: { [number]: Player? } = {}
local remotes: Folder
local rng = Random.new()

local GREEN = Color3.fromRGB(90, 255, 120)
local RED = Color3.fromRGB(255, 80, 80)

local function notify(player: Player, text: string, kind: string?)
	remotes.Notify:FireClient(player, text, kind or "info")
end

local function station(index: number): Model?
	return WorldBuilder.Stations[index]
end

local function setStationBusy(index: number, busy: boolean)
	local st = station(index)
	if not st then
		return
	end
	local light = st:FindFirstChild("StatusLight") :: BasePart?
	if light then
		light.Color = busy and RED or GREEN
	end
	local spot = st:FindFirstChild("ItemSpot")
	local bubbles = spot and spot:FindFirstChild("Bubbles") :: ParticleEmitter?
	if bubbles then
		bubbles.Enabled = busy
	end
	local nozzle = st:FindFirstChild("Nozzle")
	local spray = nozzle and nozzle:FindFirstChild("Spray") :: ParticleEmitter?
	if spray then
		spray.Enabled = busy
	end
	local prompt = st:FindFirstChild("CleanPrompt", true) :: ProximityPrompt?
	if prompt then
		prompt.Enabled = not busy
	end
end

local function setDisplay(index: number, scrapId: string?, clean: boolean)
	local st = station(index)
	if not st then
		return
	end
	local old = st:FindFirstChild("Display")
	if old then
		old:Destroy()
	end
	if not scrapId then
		return
	end
	local spot = st:FindFirstChild("ItemSpot") :: BasePart
	local model = ScrapModels.create(scrapId, clean)
	model.Name = "Display"
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		end
	end
	model:PivotTo(spot.CFrame)
	model.Parent = st
end

local function nearStation(player: Player, index: number): boolean
	local st = station(index)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not st or not root then
		return false
	end
	local spot = st:FindFirstChild("ItemSpot") :: BasePart
	return (spot.Position - root.Position).Magnitude < 20
end

local function endSession(player: Player, keepDisplayClean: boolean)
	local s = sessions[player]
	if not s then
		return
	end
	sessions[player] = nil
	local index = s.Station
	if keepDisplayClean then
		setDisplay(index, s.ScrapId, true)
		local st = station(index)
		local spot = st and st:FindFirstChild("ItemSpot")
		local sparkle = spot and spot:FindFirstChild("Sparkle") :: ParticleEmitter?
		if sparkle then
			sparkle:Emit(60)
		end
		local bubbles = spot and spot:FindFirstChild("Bubbles") :: ParticleEmitter?
		if bubbles then
			bubbles.Enabled = false
		end
		task.delay(2.5, function()
			if stationOwner[index] == player and not sessions[player] then
				stationOwner[index] = nil
				setDisplay(index, nil, false)
				setStationBusy(index, false)
			end
		end)
	else
		stationOwner[index] = nil
		setDisplay(index, nil, false)
		setStationBusy(index, false)
	end
end

function CleaningService.cancel(player: Player)
	local s = sessions[player]
	if not s then
		return
	end
	-- give the dirty items back
	DataService.addItem(player, Config.ItemKey(s.ScrapId, 0), s.Count)
	DataService.markDirty(player)
	endSession(player, false)
end

local function generateSpots(rarity: Config.Rarity, count: number): { any }
	local spots = {}
	local n = math.min(26, rarity.DirtSpots + math.floor((count - 1) * 1.5))
	local types = math.clamp(rarity.DirtLayers, 1, #Config.Cleaning.DirtTypes)
	for i = 1, n do
		local typeIndex = ((i - 1) % types) + 1
		if types > 1 and rng:NextNumber() < 0.35 then
			typeIndex = rng:NextInteger(1, types)
		end
		local dirt = Config.Cleaning.DirtTypes[typeIndex]
		local size = rng:NextNumber(0.13, 0.22)
		table.insert(spots, {
			Type = typeIndex,
			X = rng:NextNumber(0.14, 0.86),
			Y = rng:NextNumber(0.16, 0.84),
			Size = size,
			Rot = rng:NextNumber(0, 360),
			HP = dirt.HP,
		})
	end
	return spots
end

local function start(player: Player, index: any, scrapId: any)
	if typeof(index) ~= "number" or typeof(scrapId) ~= "string" then
		return false, "Invalid request"
	end
	index = math.floor(index)
	local data = DataService.get(player)
	local scrap = Config.Scraps[scrapId]
	if not data or not scrap or not station(index) then
		return false, "Invalid request"
	end
	if sessions[player] then
		return false, "You're already cleaning!"
	end
	if stationOwner[index] and stationOwner[index] ~= player then
		return false, "Station in use"
	end
	if not nearStation(player, index) then
		return false, "Walk closer to the station"
	end
	local key = Config.ItemKey(scrapId, 0)
	local have = data.Inventory[key] or 0
	if have <= 0 then
		return false, "You don't have that scrap"
	end
	local count = math.min(have, Config.WashBatch(data.Upgrades.WashTub or 0))
	DataService.addItem(player, key, -count)
	DataService.markDirty(player)

	local rarity = Config.Rarities[scrap.Rarity]
	local spots = generateSpots(rarity, count)
	local totalHP = 0
	for _, s in ipairs(spots) do
		totalHP += s.HP
	end
	local rate = Config.Cleaning.BaseScrubRate * Config.ScrubMultiplier(data.Upgrades.ScrubPower or 0)
	local expected = totalHP / rate
	local session: Session = {
		Id = HttpService:GenerateGUID(false),
		Station = index,
		ScrapId = scrapId,
		Count = count,
		Started = os.clock(),
		MinTime = math.max(1, #spots * Config.Cleaning.MinSecondsPerSpot, expected * 0.35),
		ParTime = expected * 1.6 + rarity.ParTime * 0.35,
		Spots = spots,
	}
	sessions[player] = session
	stationOwner[index] = player
	setStationBusy(index, true)
	setDisplay(index, scrapId, false)
	return true,
		{
			Id = session.Id,
			ScrapId = scrapId,
			Count = count,
			Spots = spots,
			ScrubRate = rate,
			ParTime = session.ParTime,
		}
end

local function finish(player: Player, sessionId: any)
	local s = sessions[player]
	if not s or s.Id ~= sessionId then
		return false, "No active wash"
	end
	local elapsed = os.clock() - s.Started
	if elapsed < s.MinTime then
		-- too quick to be real scrubbing: make the player wait it out
		task.wait(s.MinTime - elapsed)
		if sessions[player] ~= s then
			return false, "Wash cancelled"
		end
	end
	local data = DataService.get(player)
	if not data then
		return false, "No data"
	end
	local stars = 1
	if elapsed <= s.ParTime then
		stars = 3
	elseif elapsed <= s.ParTime * 1.8 then
		stars = 2
	end
	DataService.addItem(player, Config.ItemKey(s.ScrapId, stars), s.Count)
	data.ItemsCleaned += s.Count
	DataService.markDirty(player)
	local value = Config.SellPrice(s.ScrapId, stars, data.Upgrades.SellBonus or 0, data.Machines.PolishLab or 0) * s.Count
	endSession(player, true)
	return true, {
		Stars = stars,
		Count = s.Count,
		ScrapId = s.ScrapId,
		Value = value,
		Time = elapsed,
	}
end

function CleaningService.handleAction(player: Player, action: string, a: any, b: any)
	if action == "StartCleaning" then
		return start(player, a, b)
	elseif action == "FinishCleaning" then
		return finish(player, a)
	elseif action == "CancelCleaning" then
		CleaningService.cancel(player)
		return true
	end
	return nil
end

function CleaningService.init(remoteFolder: Folder)
	remotes = remoteFolder
	for index, st in ipairs(WorldBuilder.Stations) do
		setStationBusy(index, false)
		local prompt = st:FindFirstChild("CleanPrompt", true) :: ProximityPrompt
		prompt.Triggered:Connect(function(player)
			local data = DataService.get(player)
			if not data then
				return
			end
			if sessions[player] then
				return
			end
			if stationOwner[index] and stationOwner[index] ~= player then
				notify(player, "That station is busy — try another!", "error")
				return
			end
			local hasDirty = false
			for key, n in pairs(data.Inventory) do
				local _, stars = Config.ParseKey(key)
				if stars == 0 and n > 0 then
					hasDirty = true
					break
				end
			end
			if not hasDirty then
				notify(player, "No dirty scrap! Go collect some in the yard.", "error")
				return
			end
			remotes.Open:FireClient(player, "CleanSelect", { Station = index })
		end)
	end
	-- free stations if a session is abandoned
	task.spawn(function()
		while true do
			task.wait(5)
			for player, s in pairs(sessions) do
				if not player.Parent or os.clock() - s.Started > 240 or not nearStation(player, s.Station) then
					if player.Parent then
						notify(player, "Wash cancelled — you walked away.", "error")
						remotes.Open:FireClient(player, "CloseCleaning")
					end
					CleaningService.cancel(player)
				end
			end
		end
	end)
end

return CleaningService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[-- DataService: loads, holds, saves and replicates each player's progress.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)

local DataService = {}

local store: DataStore? = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.DataStoreName)
	end)
	if ok then
		store = result
	else
		warn("[DataService] DataStore unavailable (enable Studio API access to save):", result)
	end
end

local profiles: { [Player]: any } = {}
local loaded: { [Player]: boolean } = {}
local canSave: { [Player]: boolean } = {}
local dirty: { [Player]: boolean } = {}

local stateRemote: RemoteEvent

DataService.Changed = Instance.new("BindableEvent")

local function defaultData()
	local upgrades = {}
	for id in pairs(Config.Upgrades) do
		upgrades[id] = 0
	end
	local machines = {}
	for id in pairs(Config.Machines) do
		machines[id] = 0
	end
	return {
		Version = 1,
		Cash = Config.StartingCash,
		TotalEarned = 0,
		ScrapsCollected = 0,
		ItemsCleaned = 0,
		Tools = { RustyGrabber = true },
		EquippedTool = "RustyGrabber",
		Upgrades = upgrades,
		Machines = machines,
		Zones = { Junkyard = true },
		Inventory = {} :: { [string]: number },
		Discovered = {} :: { [string]: boolean },
		Settings = { Music = true, Sfx = true },
	}
end

-- Fill in any fields added after a player's data was first saved.
local function reconcile(data, template)
	for k, v in pairs(template) do
		if data[k] == nil then
			if type(v) == "table" then
				data[k] = table.clone(v)
			else
				data[k] = v
			end
		elseif type(v) == "table" and type(data[k]) == "table" and k ~= "Inventory" and k ~= "Discovered" then
			reconcile(data[k], v)
		end
	end
	return data
end

function DataService.init(remotes: Folder)
	stateRemote = remotes:WaitForChild("State") :: RemoteEvent
end

function DataService.get(player: Player)
	return profiles[player]
end

function DataService.isLoaded(player: Player): boolean
	return loaded[player] == true
end

----------------------------------------------------------------------
-- Inventory helpers
----------------------------------------------------------------------
function DataService.itemCount(player: Player): number
	local data = profiles[player]
	if not data then
		return 0
	end
	local total = 0
	for _, n in pairs(data.Inventory) do
		total += n
	end
	return total
end

function DataService.capacity(player: Player): number
	local data = profiles[player]
	if not data then
		return 0
	end
	return Config.BackpackCapacity(data.Upgrades.Backpack or 0)
end

function DataService.freeSpace(player: Player): number
	return math.max(0, DataService.capacity(player) - DataService.itemCount(player))
end

function DataService.addItem(player: Player, key: string, amount: number)
	local data = profiles[player]
	if not data or amount == 0 then
		return
	end
	local n = (data.Inventory[key] or 0) + amount
	if n <= 0 then
		data.Inventory[key] = nil
	else
		data.Inventory[key] = n
	end
	local id = Config.ParseKey(key)
	if id and amount > 0 then
		data.Discovered[id] = true
	end
end

function DataService.addCash(player: Player, amount: number)
	local data = profiles[player]
	if not data then
		return
	end
	data.Cash = math.max(0, math.floor(data.Cash + amount))
	if amount > 0 then
		data.TotalEarned += amount
	end
	local ls = player:FindFirstChild("leaderstats")
	local cash = ls and ls:FindFirstChild("Cash")
	if cash then
		cash.Value = data.Cash
	end
end

function DataService.trySpend(player: Player, amount: number): boolean
	local data = profiles[player]
	if not data or data.Cash < amount then
		return false
	end
	DataService.addCash(player, -amount)
	return true
end

----------------------------------------------------------------------
-- Replication: send the full (small) state to the owning client.
----------------------------------------------------------------------
function DataService.markDirty(player: Player)
	dirty[player] = true
end

function DataService.push(player: Player)
	local data = profiles[player]
	if not data then
		return
	end
	dirty[player] = false
	stateRemote:FireClient(player, data)
	local ls = player:FindFirstChild("leaderstats")
	if ls then
		local cash = ls:FindFirstChild("Cash")
		if cash then
			cash.Value = data.Cash
		end
		local scraps = ls:FindFirstChild("Scraps")
		if scraps then
			scraps.Value = data.ScrapsCollected
		end
	end
	DataService.Changed:Fire(player)
end

RunService.Heartbeat:Connect(function()
	for player, isDirty in pairs(dirty) do
		if isDirty then
			DataService.push(player)
		end
	end
end)

----------------------------------------------------------------------
-- Loading / saving
----------------------------------------------------------------------
local function key(player: Player): string
	return "Player_" .. player.UserId
end

function DataService.save(player: Player)
	local data = profiles[player]
	if not data or not store or not canSave[player] then
		return
	end
	local ok, err = pcall(function()
		store:UpdateAsync(key(player), function()
			return data
		end)
	end)
	if not ok then
		warn("[DataService] Save failed for", player.Name, err)
	end
end

local function setupLeaderstats(player: Player)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		ls.Parent = player
	end
	local cash = Instance.new("NumberValue")
	cash.Name = "Cash"
	cash.Parent = ls
	local scraps = Instance.new("NumberValue")
	scraps.Name = "Scraps"
	scraps.Parent = ls
end

function DataService.load(player: Player)
	local data = nil
	local success = true
	if store then
		for attempt = 1, (RunService:IsStudio() and 1 or 3) do
			local ok, result = pcall(function()
				return (store :: DataStore):GetAsync(key(player))
			end)
			if ok then
				data = result
				success = true
				break
			else
				success = false
				warn("[DataService] Load attempt", attempt, "failed:", result)
				if attempt < 3 and not RunService:IsStudio() then
					task.wait(1.5)
				end
			end
		end
	end
	if type(data) ~= "table" then
		data = defaultData()
	else
		data = reconcile(data, defaultData())
	end
	if not player.Parent then
		return nil
	end
	profiles[player] = data
	-- Never overwrite real data if loading failed (DataStore outage).
	canSave[player] = store ~= nil and success
	setupLeaderstats(player)
	loaded[player] = true
	DataService.push(player)
	return data
end

function DataService.release(player: Player)
	DataService.save(player)
	profiles[player] = nil
	loaded[player] = nil
	canSave[player] = nil
	dirty[player] = nil
end

task.spawn(function()
	while true do
		task.wait(Config.AutoSaveInterval)
		for _, player in ipairs(Players:GetPlayers()) do
			task.spawn(DataService.save, player)
		end
	end
end)

game:BindToClose(function()
	if RunService:IsStudio() and not store then
		return
	end
	local threads = 0
	for _, player in ipairs(Players:GetPlayers()) do
		threads += 1
		task.spawn(function()
			DataService.save(player)
			threads -= 1
		end)
	end
	local start = os.clock()
	while threads > 0 and os.clock() - start < 25 do
		task.wait(0.1)
	end
end)

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[-- EconomyService: selling, buying tools / upgrades / machines / zones,
-- equipping tools and teleporting between unlocked zones.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local DataService = require(script.Parent.DataService)
local ToolService = require(script.Parent.ToolService)
local WorldBuilder = require(script.Parent.WorldBuilder)

local EconomyService = {}

local remotes: Folder
local lastTeleport: { [Player]: number } = {}

local function fx(player: Player, payload)
	remotes.FX:FireClient(player, payload)
end

local function rootOf(player: Player): BasePart?
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function sellPad(): BasePart?
	local hub = workspace:FindFirstChild("Scrapyard") and workspace.Scrapyard:FindFirstChild("Hub")
	local shop = hub and hub:FindFirstChild("ScrapExchange")
	return shop and shop:FindFirstChild("SellPad") :: BasePart?
end

-- Sells clean items. `filter(scrapId, stars)` decides which stacks are sold.
function EconomyService.sellWhere(player: Player, filter: (string, number) -> boolean, source: string): (number, number)
	local data = DataService.get(player)
	if not data then
		return 0, 0
	end
	local total, count = 0, 0
	local sellLvl = data.Upgrades.SellBonus or 0
	local polishLvl = data.Machines.PolishLab or 0
	for key, n in pairs(data.Inventory) do
		local id, stars = Config.ParseKey(key)
		if id and stars >= 1 and n > 0 and filter(id, stars) then
			total += Config.SellPrice(id, stars, sellLvl, polishLvl) * n
			count += n
			data.Inventory[key] = nil
		end
	end
	if count > 0 then
		DataService.addCash(player, total)
		DataService.markDirty(player)
		fx(player, { Kind = "Sell", Amount = total, Count = count, Source = source })
		if source == "Shop" then
			local pad = sellPad()
			local coins = pad and pad:FindFirstChild("CoinFX") :: ParticleEmitter?
			if coins then
				coins:Emit(math.clamp(count * 4, 10, 80))
			end
		end
	end
	return total, count
end

local function sell(player: Player, key: any)
	local root = rootOf(player)
	local pad = sellPad()
	if not root or not pad or (root.Position - pad.Position).Magnitude > 45 then
		return false, "Go to the Sell Shop to sell!"
	end
	local total, count
	if key == "All" then
		total, count = EconomyService.sellWhere(player, function()
			return true
		end, "Shop")
	elseif typeof(key) == "string" then
		local wantId, wantStars = Config.ParseKey(key)
		if not wantId then
			return false, "Invalid item"
		end
		total, count = EconomyService.sellWhere(player, function(id, stars)
			return id == wantId and stars == wantStars
		end, "Shop")
	else
		return false, "Invalid item"
	end
	if count == 0 then
		return false, "Nothing clean to sell! Wash your scrap first."
	end
	return true, { Amount = total, Count = count }
end

local function buyTool(player: Player, toolId: any)
	local data = DataService.get(player)
	local def = typeof(toolId) == "string" and Config.Tools[toolId]
	if not data or not def then
		return false, "Invalid tool"
	end
	if data.Tools[toolId] then
		return false, "Already owned"
	end
	if not DataService.trySpend(player, def.Price) then
		return false, "Not enough cash!"
	end
	data.Tools[toolId] = true
	data.EquippedTool = toolId
	DataService.markDirty(player)
	ToolService.give(player)
	fx(player, { Kind = "Purchase", Text = def.Name })
	return true
end

local function equipTool(player: Player, toolId: any)
	local data = DataService.get(player)
	if not data or typeof(toolId) ~= "string" or not data.Tools[toolId] then
		return false, "You don't own that tool"
	end
	data.EquippedTool = toolId
	DataService.markDirty(player)
	ToolService.give(player)
	return true
end

local function buyUpgrade(player: Player, id: any)
	local data = DataService.get(player)
	local def = typeof(id) == "string" and Config.Upgrades[id]
	if not data or not def then
		return false, "Invalid upgrade"
	end
	local level = data.Upgrades[id] or 0
	if level >= def.MaxLevel then
		return false, "Maxed out!"
	end
	if not DataService.trySpend(player, Config.UpgradeCost(id, level)) then
		return false, "Not enough cash!"
	end
	data.Upgrades[id] = level + 1
	DataService.markDirty(player)
	ToolService.applyStats(player)
	fx(player, { Kind = "Purchase", Text = def.Name .. " Lv." .. (level + 1) })
	return true
end

local function buyMachine(player: Player, id: any)
	local data = DataService.get(player)
	local def = typeof(id) == "string" and Config.Machines[id]
	if not data or not def then
		return false, "Invalid machine"
	end
	local level = data.Machines[id] or 0
	if level >= def.MaxLevel then
		return false, "Maxed out!"
	end
	if not DataService.trySpend(player, Config.MachineCost(id, level)) then
		return false, "Not enough cash!"
	end
	data.Machines[id] = level + 1
	DataService.markDirty(player)
	fx(player, { Kind = "Purchase", Text = level == 0 and (def.Name .. " built!") or (def.Name .. " Lv." .. (level + 1)) })
	return true
end

local function unlockZone(player: Player, id: any)
	local data = DataService.get(player)
	local def = typeof(id) == "string" and Config.Zones[id]
	if not data or not def then
		return false, "Invalid zone"
	end
	if data.Zones[id] then
		return false, "Already unlocked"
	end
	local prev = Config.ZoneOrder[def.Order - 1]
	if prev and not data.Zones[prev] then
		return false, "Unlock " .. Config.Zones[prev].Name .. " first!"
	end
	if not DataService.trySpend(player, def.Price) then
		return false, "Need " .. Format.cash(def.Price) .. "!"
	end
	data.Zones[id] = true
	DataService.markDirty(player)
	fx(player, { Kind = "ZoneUnlocked", Zone = id })
	return true
end

local function teleport(player: Player, id: any)
	local data = DataService.get(player)
	local root = rootOf(player)
	if not data or not root then
		return false, "Can't teleport right now"
	end
	if os.clock() - (lastTeleport[player] or 0) < 2 then
		return false, "Teleporter recharging..."
	end
	local target: CFrame?
	if id == "Hub" then
		target = WorldBuilder.HubSpawn
	elseif typeof(id) == "string" and Config.Zones[id] then
		if not data.Zones[id] then
			return false, "Zone locked!"
		end
		target = WorldBuilder.ZoneSpawns[id]
	end
	if not target then
		return false, "Invalid destination"
	end
	lastTeleport[player] = os.clock()
	local char = player.Character :: Model
	char:PivotTo(target)
	return true
end

function EconomyService.handleAction(player: Player, action: string, a: any)
	if action == "Sell" then
		return sell(player, a)
	elseif action == "BuyTool" then
		return buyTool(player, a)
	elseif action == "EquipTool" then
		return equipTool(player, a)
	elseif action == "BuyUpgrade" then
		return buyUpgrade(player, a)
	elseif action == "BuyMachine" then
		return buyMachine(player, a)
	elseif action == "UnlockZone" then
		return unlockZone(player, a)
	elseif action == "Teleport" then
		return teleport(player, a)
	end
	return nil
end

function EconomyService.init(remoteFolder: Folder)
	remotes = remoteFolder
end

function EconomyService.forget(player: Player)
	lastTeleport[player] = nil
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">MachineModels</string>
          <string name="Source"><![CDATA[-- MachineModels: the purchasable machines shown in the Machine Bay.
-- Moving parts are grouped in Models named "Rotor" (attribute Speed = rad/s,
-- Axis = "X"/"Y"/"Z"); the client spins them while the machine is owned.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Build = require(ReplicatedStorage.Shared.Build)

local C = Build.Colors
local M = Enum.Material
local rad = math.rad
local CF = CFrame.new
local ANG = CFrame.Angles
local V3 = Vector3.new
local RGB = Color3.fromRGB

local MachineModels = {}

local function rotor(parent: Instance, pivot: CFrame, speed: number, axis: string?): Model
	local r = Instance.new("Model")
	r.Name = "Rotor"
	r:SetAttribute("Speed", speed)
	r:SetAttribute("Axis", axis or "Y")
	r.Parent = parent
	local p = Build.part(r, "Part", {
		Name = "Pivot",
		Size = V3(0.2, 0.2, 0.2),
		CFrame = pivot,
		Transparency = 1,
		CanQuery = false,
	})
	r.PrimaryPart = p
	return r
end

local function emitter(parent: Instance, color: Color3, rate: number, texture: string?): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = "MachineFX"
	e.Texture = texture or "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	e.Lifetime = NumberRange.new(0.8, 1.6)
	e.Rate = rate
	e.Speed = NumberRange.new(2, 5)
	e.SpreadAngle = Vector2.new(25, 25)
	e.LightEmission = 0.7
	e.Enabled = false
	e.Parent = parent
	return e
end

local builders: { [string]: (Model, CFrame) -> () } = {}

builders.AutoWasher = function(m, o)
	local body = RGB(240, 246, 255)
	local blue = RGB(60, 150, 255)
	local b = o * CF(0, 4.6, 0)
	Build.block(m, V3(9, 9, 7), b, body, M.SmoothPlastic)
	Build.block(m, V3(9.2, 0.6, 7.2), b * CF(0, -4.5, 0), blue, M.SmoothPlastic)
	Build.block(m, V3(9.2, 1.6, 7.2), b * CF(0, 3.9, 0), blue, M.SmoothPlastic)
	-- control panel
	local panel = b * CF(0, 3.9, -3.62)
	Build.block(m, V3(5, 1.0, 0.1), panel * CF(-1.4, 0, 0), RGB(20, 24, 34), M.Glass)
	Build.block(m, V3(3.4, 0.6, 0.12), panel * CF(-1.4, 0, -0.02), RGB(90, 255, 160), M.Neon).Name = "Light"
	for i = 0, 2 do
		Build.cylZ(m, 0.3, 0.6, panel * CF(1.8 + i * 0.9, 0, -0.1), ({ C.Red, C.Yellow, RGB(80, 230, 110) })[i + 1], M.SmoothPlastic)
	end
	-- door
	local door = b * CF(0, -0.4, -3.55)
	Build.torus(m, door * ANG(rad(90), 0, 0), 2.7, 0.35, 24, C.Chrome, M.Metal)
	local glass = Build.cylZ(m, 0.2, 5.2, door * CF(0, 0, -0.05), RGB(170, 230, 255), M.Glass)
	glass.Transparency = 0.45
	Build.cylZ(m, 0.1, 5.4, door * CF(0, 0, 0.3), RGB(30, 40, 60), M.Metal)
	Build.block(m, V3(0.5, 1.4, 0.5), door * CF(2.9, 0, -0.3), C.Chrome, M.Metal)
	-- spinning drum (laundry + water)
	local r = rotor(m, door * CF(0, 0, 0.15), 6, "Z")
	Build.cylZ(r, 0.1, 4.6, door * CF(0, 0, 0.18), RGB(90, 190, 255), M.Neon)
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		Build.block(r, V3(0.6, 1.8, 0.4), door * ANG(0, 0, a) * CF(0, 1.2, 0.05), RGB(255, 255, 255), M.SmoothPlastic)
		Build.ball(r, 0.9, door * ANG(0, 0, a + 0.7) * CF(0, 1.6, 0.05), Build.Colors.Yellow, M.SmoothPlastic)
	end
	-- pipes + soap bottle
	Build.cylY(m, 5, 0.7, b * CF(3.2, 6.8, 2.2), C.Chrome, M.Metal)
	Build.ball(m, 0.9, b * CF(3.2, 9.3, 2.2), C.Chrome, M.Metal)
	Build.cylX(m, 2.5, 0.7, b * CF(2.0, 9.3, 2.2), C.Chrome, M.Metal)
	local bottle = b * CF(-2.6, 5.4, 1)
	Build.block(m, V3(1.6, 2.4, 1.2), bottle, RGB(255, 90, 200), M.SmoothPlastic)
	Build.cylY(m, 0.6, 0.6, bottle * CF(0, 1.5, 0), C.White)
	local fx = Build.block(m, V3(4, 0.2, 4), b * CF(0, 4.9, 0), body, M.SmoothPlastic)
	fx.Transparency = 1
	emitter(fx, RGB(200, 240, 255), 14)
end

builders.MagnetCrane = function(m, o)
	local red = RGB(235, 60, 60)
	local dark = RGB(50, 54, 64)
	Build.cylY(m, 1.2, 8, o * CF(0, 0.6, 0), dark, M.DiamondPlate)
	local r = rotor(m, o * CF(0, 1.2, 0), 0.6, "Y")
	Build.cylY(r, 1.4, 6, o * CF(0, 1.9, 0), red, M.Metal)
	Build.block(r, V3(3.6, 3.6, 3.4), o * CF(0, 4.4, 1), red, M.Metal)
	local win = Build.block(r, V3(3.4, 1.8, 0.2), o * CF(0, 5, -0.8), RGB(150, 210, 255), M.Glass)
	win.Transparency = 0.3
	-- column + arm
	Build.block(r, V3(1.6, 12, 1.6), o * CF(0, 8, 2.2), RGB(255, 196, 40), M.Metal)
	for i = 0, 5 do
		Build.block(r, V3(1.7, 0.3, 1.7), o * CF(0, 3 + i * 2, 2.2) * ANG(0, 0, rad(30)), dark, M.Metal)
	end
	Build.block(r, V3(1.2, 1.2, 12), o * CF(0, 13.6, -2.5), RGB(255, 196, 40), M.Metal)
	Build.block(r, V3(1.6, 1.6, 2), o * CF(0, 13.6, 4.5), dark, M.Metal)
	-- cable + magnet
	Build.cylY(r, 5, 0.2, o * CF(0, 10.6, -8), RGB(30, 30, 30), M.Metal)
	Build.cylY(r, 0.9, 4, o * CF(0, 7.6, -8), dark, M.Metal)
	Build.cylY(r, 0.3, 4.2, o * CF(0, 7.05, -8), red, M.Metal)
	local glow = Build.cylY(r, 0.1, 3.6, o * CF(0, 6.88, -8), RGB(120, 200, 255), M.Neon)
	glow.Name = "Light"
	-- scrap held by the magnet
	Build.block(r, V3(2, 1.4, 1.6), o * CF(0, 6.0, -8) * ANG(rad(10), rad(20), 0), C.Rust, M.CorrodedMetal)
	emitter(glow, RGB(120, 200, 255), 10)
end

builders.RarityRadar = function(m, o)
	local green = RGB(90, 230, 120)
	local dark = RGB(48, 52, 62)
	Build.block(m, V3(7, 1, 7), o * CF(0, 0.5, 0), dark, M.DiamondPlate)
	-- lattice tower
	for _, x in ipairs({ -1.6, 1.6 }) do
		for _, z in ipairs({ -1.6, 1.6 }) do
			Build.block(m, V3(0.4, 11, 0.4), o * CF(x * 0.8, 6, z * 0.8) * ANG(rad(-z * 2), 0, rad(x * 2)), green, M.Metal)
		end
	end
	for i = 0, 4 do
		Build.block(m, V3(3, 0.3, 0.3), o * CF(0, 2 + i * 2, 1.3) * ANG(0, 0, rad(i % 2 == 0 and 35 or -35)), green, M.Metal)
		Build.block(m, V3(3, 0.3, 0.3), o * CF(0, 2 + i * 2, -1.3) * ANG(0, 0, rad(i % 2 == 0 and -35 or 35)), green, M.Metal)
	end
	-- rotating dish
	local r = rotor(m, o * CF(0, 11.5, 0), 1.2, "Y")
	Build.cylY(r, 1, 1.4, o * CF(0, 11.8, 0), dark, M.Metal)
	local dish = o * CF(0, 13.4, -0.6) * ANG(rad(-35), 0, 0)
	Build.cylY(r, 0.5, 7, dish, RGB(235, 240, 250), M.SmoothPlastic)
	Build.cylY(r, 0.6, 5, dish * CF(0, 0.15, 0), RGB(210, 220, 235), M.SmoothPlastic)
	Build.cylY(r, 2.6, 0.25, dish * CF(0, 1.5, 0), C.Steel, M.Metal)
	local tip = Build.ball(r, 0.7, dish * CF(0, 2.9, 0), RGB(255, 60, 80), M.Neon)
	tip.Name = "Light"
	-- screen
	local screen = Build.block(m, V3(3.2, 2, 0.3), o * CF(0, 2.4, -3.2), RGB(20, 30, 30), M.Glass)
	Build.block(m, V3(2.8, 1.6, 0.1), o * CF(0, 2.4, -3.36), RGB(60, 255, 120), M.Neon).Name = "Light"
	Build.torus(m, o * CF(0, 2.4, -3.42) * ANG(rad(90), 0, 0), 0.5, 0.05, 12, RGB(10, 60, 30), M.SmoothPlastic)
	local _ = screen
	emitter(tip, RGB(120, 255, 140), 6)
end

builders.AutoSeller = function(m, o)
	local yellow = RGB(255, 196, 40)
	local dark = RGB(48, 50, 58)
	-- conveyor
	local belt = o * CF(-1.5, 2.6, 0)
	Build.block(m, V3(11, 0.4, 3.6), belt, RGB(30, 30, 34), M.Fabric)
	Build.block(m, V3(11, 0.9, 0.4), belt * CF(0, 0.1, 1.9), yellow, M.Metal)
	Build.block(m, V3(11, 0.9, 0.4), belt * CF(0, 0.1, -1.9), yellow, M.Metal)
	for _, x in ipairs({ -5, -1.6, 1.8, 5 }) do
		Build.block(m, V3(0.5, 2.4, 0.5), belt * CF(x, -1.3, 1.6), dark, M.Metal)
		Build.block(m, V3(0.5, 2.4, 0.5), belt * CF(x, -1.3, -1.6), dark, M.Metal)
	end
	for i = 0, 2 do
		local box = belt * CF(-4 + i * 3.2, 0.9, 0) * ANG(0, rad(i * 17), 0)
		Build.block(m, V3(1.6, 1.4, 1.6), box, RGB(200, 150, 90), M.Cardboard)
		Build.block(m, V3(1.62, 0.2, 0.4), box * CF(0, 0.6, 0), RGB(230, 210, 160), M.Fabric)
	end
	-- gear rotor on the side
	local r = rotor(m, belt * CF(-5.6, 0, -2.2), 2.5, "Z")
	Build.cylZ(r, 0.4, 2.0, belt * CF(-5.6, 0, -2.2), C.Steel, M.Metal)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Build.block(r, V3(0.4, 0.5, 0.4), belt * CF(-5.6, 0, -2.2) * ANG(0, 0, a) * CF(0, 1.1, 0), C.Steel, M.Metal)
	end
	-- cash machine
	local cash = o * CF(6.2, 3.8, 0)
	Build.block(m, V3(4, 7.6, 5), cash, RGB(70, 200, 110), M.SmoothPlastic)
	Build.block(m, V3(4.2, 1, 5.2), cash * CF(0, 3.6, 0), RGB(40, 150, 80), M.SmoothPlastic)
	Build.block(m, V3(0.3, 2, 3), cash * CF(-2.1, 1, 0), RGB(20, 30, 20), M.Glass)
	local sign = Build.block(m, V3(0.2, 1.6, 2.4), cash * CF(-2.2, 1, 0), RGB(255, 230, 80), M.Neon)
	sign.Name = "Light"
	Build.sign(sign, Enum.NormalId.Left, "$", RGB(40, 120, 40), RGB(255, 255, 255))
	Build.block(m, V3(1.2, 1.4, 3.8), cash * CF(-2.4, -1.4, 0), dark, M.Metal)
	emitter(sign, RGB(255, 230, 80), 8)
end

builders.PolishLab = function(m, o)
	local purple = RGB(170, 100, 255)
	local white = RGB(245, 245, 252)
	-- lab bench
	Build.block(m, V3(12, 0.6, 5), o * CF(0, 3.4, 0), white, M.SmoothPlastic)
	Build.block(m, V3(11.6, 3, 4.6), o * CF(0, 1.6, 0), RGB(90, 70, 140), M.SmoothPlastic)
	for i = 0, 3 do
		Build.block(m, V3(2.6, 2.4, 0.1), o * CF(-4.2 + i * 2.8, 1.6, -2.32), RGB(110, 90, 170), M.SmoothPlastic)
		Build.block(m, V3(0.8, 0.2, 0.2), o * CF(-4.2 + i * 2.8, 2.4, -2.42), C.Chrome, M.Metal)
	end
	-- tanks
	local colors = { RGB(255, 80, 180), RGB(80, 220, 255), RGB(255, 220, 60) }
	for i, col in ipairs(colors) do
		local t = o * CF(-5 + i * 1.6, 5.4, 1.2)
		local g = Build.cylY(m, 3.4, 1.3, t, RGB(220, 240, 255), M.Glass)
		g.Transparency = 0.5
		Build.cylY(m, 2.4, 1.05, t * CF(0, -0.4, 0), col, M.Neon).Name = "Light"
		Build.cylY(m, 0.3, 1.4, t * CF(0, 1.8, 0), C.Chrome, M.Metal)
	end
	-- floating gem in rings
	local center = o * CF(3, 7, 0)
	Build.cylY(m, 0.6, 2.6, o * CF(3, 3.9, 0), C.Chrome, M.Metal)
	local r = rotor(m, center, 1.5, "Y")
	local gem = Build.block(r, V3(1.6, 1.6, 1.6), center * ANG(rad(45), 0, rad(45)), RGB(120, 230, 255), M.Neon)
	gem.Name = "Light"
	Build.torus(r, center * ANG(rad(60), 0, 0), 2.2, 0.1, 18, purple, M.Neon)
	Build.torus(r, center * ANG(rad(-60), 0, rad(30)), 2.6, 0.1, 18, RGB(255, 140, 220), M.Neon)
	-- robot polishing arm
	Build.cylY(m, 1, 1.4, o * CF(-1, 4.2, -1.2), RGB(60, 60, 70), M.Metal)
	Build.block(m, V3(0.6, 3, 0.6), o * CF(-1, 5.8, -1.2) * ANG(0, 0, rad(-25)), RGB(255, 200, 60), M.Metal)
	Build.block(m, V3(0.5, 2.4, 0.5), o * CF(0.1, 7.4, -1.2) * ANG(0, 0, rad(-80)), RGB(255, 200, 60), M.Metal)
	Build.cylX(m, 0.6, 1.0, o * CF(1.4, 7.6, -1.2), C.Chrome, M.Metal)
	emitter(gem, RGB(200, 160, 255), 12)
end

builders.Teleporter = function(m, o)
	local cyan = RGB(80, 220, 255)
	Build.cylY(m, 1, 12, o * CF(0, 0.5, 0), RGB(50, 54, 70), M.DiamondPlate)
	Build.cylY(m, 1.1, 9, o * CF(0, 0.55, 0), cyan, M.Neon)
	local ring = o * CF(0, 7, 0) * ANG(rad(90), 0, 0)
	Build.torus(m, ring, 5.5, 0.6, 28, RGB(60, 64, 84), M.Metal)
	for _, p in ipairs(Build.torus(m, ring, 5.5, 0.66, 28, cyan, M.Neon)) do
		p.Size = Vector3.new(p.Size.X * 0.3, p.Size.Y, p.Size.Z)
	end
	local portal = Build.cylZ(m, 0.2, 10.4, o * CF(0, 7, 0), RGB(140, 90, 255), M.Neon)
	portal.Transparency = 0.35
	portal.Name = "Light"
	for _, x in ipairs({ -5.8, 5.8 }) do
		Build.block(m, V3(1.6, 3, 2.4), o * CF(x, 1.5, 0), RGB(60, 64, 84), M.Metal)
	end
	local r = rotor(m, o * CF(0, 7, 0), 2, "Z")
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		Build.ball(r, 0.7, o * CF(0, 7, 0) * ANG(0, 0, a) * CF(0, 4.2, 0), RGB(255, 255, 255), M.Neon)
	end
	local fx = emitter(portal, RGB(160, 120, 255), 20)
	fx.Enabled = true
	Build.light(portal, RGB(140, 90, 255), 20, 2)
end

function MachineModels.create(id: string, parent: Instance, cf: CFrame): Model
	local m = Instance.new("Model")
	m.Name = id
	local b = builders[id]
	if b then
		b(m, cf)
	end
	Build.setAll(m, { CanCollide = true })
	for _, d in ipairs(m:GetDescendants()) do
		if d:IsA("BasePart") and d.Name == "Pivot" then
			d.CanCollide = false
		end
	end
	m.Parent = parent
	return m
end

return MachineModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">MachineService</string>
          <string name="Source"><![CDATA[-- MachineService: runs every owned machine for every player once a second.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)
local ScrapService = require(script.Parent.ScrapService)
local EconomyService = require(script.Parent.EconomyService)

local MachineService = {}

local timers: { [Player]: { [string]: number } } = {}
local remotes: Folder

local function fx(player: Player, payload)
	remotes.FX:FireClient(player, payload)
end

local function tick(player: Player, data, t: { [string]: number })
	local stats = Config.MachineStats

	-- Auto Washer: cleans dirty scrap to 1 star
	local washer = data.Machines.AutoWasher or 0
	if washer > 0 then
		t.AutoWasher = (t.AutoWasher or 0) + 1
		if t.AutoWasher >= stats.AutoWasherInterval[washer] then
			t.AutoWasher = 0
			local budget = washer
			local cleanedId, cleaned = nil, 0
			local dirtyKeys = {}
			for key, n in pairs(data.Inventory) do
				local id, stars = Config.ParseKey(key)
				if id and stars == 0 and n > 0 then
					table.insert(dirtyKeys, key)
				end
			end
			for _, key in ipairs(dirtyKeys) do
				local id = Config.ParseKey(key)
				local n = data.Inventory[key] or 0
				if id and n > 0 then
					local take = math.min(n, budget)
					DataService.addItem(player, key, -take)
					DataService.addItem(player, Config.ItemKey(id, 1), take)
					data.ItemsCleaned += take
					budget -= take
					cleaned += take
					cleanedId = id
					if budget <= 0 then
						break
					end
				end
			end
			if cleaned > 0 then
				DataService.markDirty(player)
				fx(player, {
					Kind = "Machine",
					Machine = "AutoWasher",
					Text = string.format("+%d washed %s", cleaned, Config.Scraps[cleanedId :: string].Name),
				})
			end
		end
	end

	-- Magnet Crane: grabs scrap for you
	local crane = data.Machines.MagnetCrane or 0
	if crane > 0 then
		t.MagnetCrane = (t.MagnetCrane or 0) + 1
		if t.MagnetCrane >= stats.MagnetCraneInterval[crane] then
			t.MagnetCrane = 0
			ScrapService.grantRandom(player)
		end
	end

	-- Conveyor Seller: auto-sells low rarity clean scrap
	local seller = data.Machines.AutoSeller or 0
	if seller > 0 then
		t.AutoSeller = (t.AutoSeller or 0) + 1
		if t.AutoSeller >= stats.AutoSellerInterval[seller] then
			t.AutoSeller = 0
			local maxOrder = math.clamp(seller + 1, 1, 6)
			EconomyService.sellWhere(player, function(id)
				return Config.Rarities[Config.Scraps[id].Rarity].Order <= maxOrder
			end, "AutoSeller")
		end
	end
end

function MachineService.init(remoteFolder: Folder)
	remotes = remoteFolder
	Players.PlayerRemoving:Connect(function(player)
		timers[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.get(player)
				if data then
					local t = timers[player]
					if not t then
						t = {}
						timers[player] = t
					end
					local ok, err = pcall(tick, player, data, t)
					if not ok then
						warn("[MachineService]", err)
					end
				end
			end
		end
	end)
end

return MachineService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Props</string>
          <string name="Source"><![CDATA[-- Props: detailed decorative models for the scrapyard map.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Build = require(ReplicatedStorage.Shared.Build)

local C = Build.Colors
local M = Enum.Material
local rad = math.rad
local CF = CFrame.new
local ANG = CFrame.Angles
local V3 = Vector3.new
local RGB = Color3.fromRGB

local Props = {}

local rng = Random.new(1337)

local BRIGHT = {
	RGB(255, 90, 90),
	RGB(255, 170, 50),
	RGB(255, 220, 60),
	RGB(90, 210, 110),
	RGB(70, 170, 255),
	RGB(150, 110, 255),
	RGB(255, 110, 200),
	RGB(60, 210, 210),
}

function Props.randomBright(): Color3
	return BRIGHT[rng:NextInteger(1, #BRIGHT)]
end

local function model(parent: Instance, name: string): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function collide(m: Model)
	Build.setAll(m, { CanCollide = true })
end

----------------------------------------------------------------------
-- Shipping container with ribbed walls and doors.
----------------------------------------------------------------------
function Props.container(parent: Instance, cf: CFrame, color: Color3?): Model
	local m = model(parent, "Container")
	local col = color or Props.randomBright()
	local dark = col:Lerp(Color3.new(0, 0, 0), 0.25)
	local L, H, W = 24, 10, 9.6
	Build.block(m, V3(L, H, W), cf * CF(0, H / 2, 0), col, M.Metal)
	-- ribs
	for i = 0, 15 do
		local x = -L / 2 + 0.9 + i * ((L - 1.8) / 15)
		Build.block(m, V3(0.5, H - 0.8, W + 0.3), cf * CF(x, H / 2, 0), dark, M.Metal)
	end
	-- top / bottom rails
	Build.block(m, V3(L + 0.2, 0.6, W + 0.4), cf * CF(0, H - 0.3, 0), dark, M.Metal)
	Build.block(m, V3(L + 0.2, 0.6, W + 0.4), cf * CF(0, 0.3, 0), dark, M.Metal)
	-- doors
	local door = cf * CF(L / 2 + 0.1, H / 2, 0)
	Build.block(m, V3(0.3, H - 1.2, W - 0.6), door, dark, M.Metal)
	for _, z in ipairs({ -2.6, -1.2, 1.2, 2.6 }) do
		Build.cylY(m, H - 1.6, 0.25, door * CF(0.3, 0, z), C.Steel, M.Metal)
	end
	Build.block(m, V3(0.1, H - 1.2, 0.12), door * CF(0.2, 0, 0), RGB(20, 20, 24))
	-- corner castings
	for _, x in ipairs({ -L / 2, L / 2 }) do
		for _, y in ipairs({ 0.5, H - 0.5 }) do
			for _, z in ipairs({ -W / 2, W / 2 }) do
				Build.block(m, V3(1, 1, 1), cf * CF(x, y, z), RGB(60, 60, 64), M.Metal)
			end
		end
	end
	-- logo stripe
	local stripe = Build.block(m, V3(10, 2.4, 0.2), cf * CF(-2, H * 0.62, -W / 2 - 0.2), C.White, M.SmoothPlastic)
	Build.sign(stripe, Enum.NormalId.Front, "SCRAPCO", col, RGB(30, 30, 30))
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Oil drum. `toxic` makes it leak glowing goo.
----------------------------------------------------------------------
function Props.barrel(parent: Instance, cf: CFrame, color: Color3?, toxic: boolean?, tipped: boolean?): Model
	local m = model(parent, "Barrel")
	local col = color or Props.randomBright()
	local base = cf
	if tipped then
		base = cf * CF(0, 1.5, 0) * ANG(0, 0, rad(90)) * CF(0, -1.5, 0) * CF(-1.5, 0, 0)
	end
	local body = base * CF(0, 1.9, 0)
	Build.cylY(m, 3.8, 2.6, body, col, M.Metal)
	for _, y in ipairs({ -1.85, -0.65, 0.65, 1.85 }) do
		Build.cylY(m, 0.18, 2.72, body * CF(0, y, 0), col:Lerp(Color3.new(0, 0, 0), 0.3), M.Metal)
	end
	Build.cylY(m, 0.08, 2.4, body * CF(0, 1.92, 0), col:Lerp(Color3.new(1, 1, 1), 0.2), M.Metal)
	Build.cylY(m, 0.2, 0.4, body * CF(0.7, 1.98, 0), C.DarkSteel, M.Metal)
	if toxic then
		local label = Build.block(m, V3(0.1, 1.0, 1.0), body * CF(1.31, 0, 0), RGB(255, 220, 40))
		Build.sign(label, Enum.NormalId.Right, "☢", RGB(20, 20, 20), RGB(255, 220, 40))
		local goo = Build.cylY(m, 0.2, 3.6, (tipped and base or cf) * CF(2.4, 0.1, 0), RGB(120, 255, 60), M.Neon)
		goo.Transparency = 0.15
		Build.light(goo, RGB(120, 255, 60), 10, 1.5)
	end
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Wooden crate with plank frame.
----------------------------------------------------------------------
function Props.crate(parent: Instance, cf: CFrame, size: number?): Model
	local m = model(parent, "Crate")
	local s = size or 4
	local wood = RGB(196, 140, 80)
	local frame = RGB(150, 98, 52)
	local c = cf * CF(0, s / 2, 0)
	Build.block(m, V3(s, s, s), c, wood, M.WoodPlanks)
	local t = s * 0.12
	for _, a in ipairs({ { 1, 1 }, { 1, -1 }, { -1, 1 }, { -1, -1 } }) do
		Build.block(m, V3(t, s + 0.05, t), c * CF(a[1] * (s / 2 - t / 2 + 0.02), 0, a[2] * (s / 2 - t / 2 + 0.02)), frame, M.Wood)
		Build.block(m, V3(s + 0.05, t, t), c * CF(0, a[1] * (s / 2 - t / 2 + 0.02), a[2] * (s / 2 - t / 2 + 0.02)), frame, M.Wood)
		Build.block(m, V3(t, t, s + 0.05), c * CF(a[1] * (s / 2 - t / 2 + 0.02), a[2] * (s / 2 - t / 2 + 0.02), 0), frame, M.Wood)
	end
	-- diagonal braces
	for _, z in ipairs({ -1, 1 }) do
		Build.block(m, V3(s * 1.25, t, t * 0.6), c * CF(0, 0, z * (s / 2 + 0.03)) * ANG(0, 0, rad(45)), frame, M.Wood)
	end
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Stack of tyres.
----------------------------------------------------------------------
function Props.tireStack(parent: Instance, cf: CFrame, count: number?): Model
	local m = model(parent, "Tires")
	local n = count or rng:NextInteger(2, 5)
	for i = 0, n - 1 do
		local t = cf * CF(rng:NextNumber(-0.25, 0.25), 0.75 + i * 1.35, rng:NextNumber(-0.25, 0.25)) * ANG(0, rng:NextNumber(0, 6.28), 0)
		Build.torus(m, t, 1.6, 0.68, 14, C.Rubber, M.Rubber)
		Build.cylY(m, 1.1, 2.2, t, RGB(28, 28, 30), M.Rubber)
		if i == n - 1 then
			Build.cylY(m, 1.14, 1.6, t, C.Steel, M.Metal)
		end
	end
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Wrecked car (rusty, wheels missing, broken windows).
----------------------------------------------------------------------
function Props.carWreck(parent: Instance, cf: CFrame, color: Color3?): Model
	local m = model(parent, "CarWreck")
	local col = (color or Props.randomBright()):Lerp(C.Rust, 0.35)
	local body = cf * CF(0, 1.9, 0) * ANG(rad(rng:NextNumber(-3, 3)), 0, rad(rng:NextNumber(-4, 4)))
	-- chassis + body
	Build.block(m, V3(13, 2.2, 6), body, col, M.CorrodedMetal)
	Build.block(m, V3(13.2, 0.6, 6.2), body * CF(0, -1.1, 0), RGB(50, 46, 44), M.Metal)
	-- hood & trunk slopes
	Build.wedge(m, V3(6, 0.8, 3.2), body * CF(0, 1.5, -3.4) * ANG(0, rad(90), 0), col, M.CorrodedMetal)
	-- cabin
	local cabin = body * CF(0.6, 2.4, 0)
	Build.block(m, V3(6, 2.4, 5.6), cabin, col, M.CorrodedMetal)
	Build.block(m, V3(6.2, 0.3, 5.8), cabin * CF(0, 1.3, 0), col:Lerp(Color3.new(0, 0, 0), 0.2), M.CorrodedMetal)
	-- windows (broken glass)
	local glass = RGB(150, 200, 220)
	for _, z in ipairs({ -2.82, 2.82 }) do
		local w = Build.block(m, V3(2.4, 1.4, 0.1), cabin * CF(-1.4, 0.2, z), glass, M.Glass)
		w.Transparency = 0.5
		local w2 = Build.block(m, V3(2.2, 0.8, 0.1), cabin * CF(1.4, -0.1, z) * ANG(0, 0, rad(8)), glass, M.Glass)
		w2.Transparency = 0.5
	end
	local wind = Build.block(m, V3(0.1, 1.8, 5.2), cabin * CF(-3.05, 0.1, 0) * ANG(0, 0, rad(-20)), glass, M.Glass)
	wind.Transparency = 0.55
	-- lights / bumpers
	for _, z in ipairs({ -2.2, 2.2 }) do
		Build.cylX(m, 0.2, 0.9, body * CF(-6.55, 0.3, z), RGB(255, 245, 200), M.Glass)
		Build.block(m, V3(0.2, 0.5, 1), body * CF(6.55, 0.4, z), RGB(220, 40, 40), M.Glass)
	end
	Build.block(m, V3(0.5, 0.6, 6.4), body * CF(-6.7, -0.7, 0), C.Steel, M.Metal)
	Build.block(m, V3(0.5, 0.6, 6.4), body * CF(6.7, -0.7, 0) * ANG(rad(6), 0, 0), C.Steel, M.CorrodedMetal)
	-- remaining wheels
	for _, p in ipairs({ { -4.2, -3 }, { 4.2, 3 } }) do
		local w = body * CF(p[1], -1.1, p[2])
		Build.cylZ(m, 1.2, 2.6, w, C.Rubber, M.Rubber)
		Build.cylZ(m, 1.3, 1.4, w, C.Steel, M.Metal)
	end
	-- cinder blocks under the bare axles
	for _, p in ipairs({ { -4.2, 2.4 }, { 4.2, -2.4 } }) do
		Build.block(m, V3(1.6, 1.6, 1.2), cf * CF(p[1], 0.8, p[2]), RGB(150, 150, 150), M.Concrete)
	end
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Crushed car cube (for stacks / walls).
----------------------------------------------------------------------
function Props.crushedCube(parent: Instance, cf: CFrame, color: Color3?): Model
	local m = model(parent, "CrushedCar")
	local col = (color or Props.randomBright()):Lerp(C.Rust, 0.25)
	local c = cf * CF(0, 2.5, 0)
	Build.block(m, V3(6, 5, 5), c, col, M.CorrodedMetal)
	for i = 0, 4 do
		local y = -2 + i
		local shade = (i % 2 == 0) and col:Lerp(Color3.new(0, 0, 0), 0.25) or col:Lerp(Color3.new(1, 1, 1), 0.1)
		Build.block(
			m,
			V3(6.2, 0.35, 5.2),
			c * CF(rng:NextNumber(-0.15, 0.15), y, 0) * ANG(0, 0, rad(rng:NextNumber(-3, 3))),
			shade,
			M.CorrodedMetal
		)
	end
	-- bits poking out
	Build.cylZ(m, 0.4, 2.0, c * CF(-2.3, -1.4, 2.6), C.Rubber, M.Rubber)
	Build.block(m, V3(1.6, 0.8, 0.15), c * CF(1.2, 0.9, -2.6), RGB(170, 210, 230), M.Glass)
	Build.cylX(m, 2.0, 0.3, c * CF(3.6, 1.6, 0.8) * ANG(0, rad(20), rad(15)), C.Steel, M.Metal)
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Traffic cone.
----------------------------------------------------------------------
function Props.cone(parent: Instance, cf: CFrame): Model
	local m = model(parent, "Cone")
	local orange = RGB(255, 120, 30)
	Build.block(m, V3(2, 0.3, 2), cf * CF(0, 0.15, 0), orange)
	local steps = 5
	for i = 0, steps - 1 do
		local d = 1.4 - i * 0.24
		local col = (i == 2 or i == 3) and C.White or orange
		Build.cylY(m, 0.5, d, cf * CF(0, 0.55 + i * 0.5, 0), col)
	end
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Street lamp with a warm light.
----------------------------------------------------------------------
function Props.lamp(parent: Instance, cf: CFrame, color: Color3?): Model
	local m = model(parent, "Lamp")
	local pole = RGB(52, 56, 70)
	Build.cylY(m, 1, 1.6, cf * CF(0, 0.5, 0), pole, M.Metal)
	Build.cylY(m, 18, 0.6, cf * CF(0, 9.5, 0), pole, M.Metal)
	Build.block(m, V3(4, 0.4, 0.4), cf * CF(1.8, 18.3, 0), pole, M.Metal)
	local head = cf * CF(3.6, 17.9, 0)
	Build.block(m, V3(1.8, 0.6, 1.2), head, pole, M.Metal)
	local bulb = Build.block(m, V3(1.5, 0.2, 0.9), head * CF(0, -0.38, 0), color or RGB(255, 230, 170), M.Neon)
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = 40
	light.Angle = 100
	light.Brightness = 2.5
	light.Color = color or RGB(255, 220, 160)
	light.Parent = bulb
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Rusty steel girder pile.
----------------------------------------------------------------------
function Props.girders(parent: Instance, cf: CFrame): Model
	local m = model(parent, "Girders")
	for i = 0, 3 do
		local g = cf * CF(rng:NextNumber(-1, 1), 0.6 + i * 1.1, (i - 1.5) * 1.6) * ANG(0, rad(rng:NextNumber(-20, 20)), 0)
		local col = C.Rust:Lerp(RGB(200, 90, 40), rng:NextNumber())
		Build.block(m, V3(16, 0.25, 1.4), g * CF(0, 0.5, 0), col, M.CorrodedMetal)
		Build.block(m, V3(16, 0.25, 1.4), g * CF(0, -0.5, 0), col, M.CorrodedMetal)
		Build.block(m, V3(16, 1.0, 0.25), g, col, M.CorrodedMetal)
	end
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Pile of junk (mound + random clutter).
----------------------------------------------------------------------
function Props.junkPile(parent: Instance, cf: CFrame, radius: number): Model
	local m = model(parent, "JunkPile")
	local mound = Build.ball(m, radius * 2, cf * CF(0, -radius * 0.45, 0), RGB(110, 92, 74), M.Ground)
	mound.Size = V3(radius * 2, radius * 2, radius * 2)
	for _ = 1, math.floor(radius * 1.4) do
		local a = rng:NextNumber(0, math.pi * 2)
		local d = rng:NextNumber(0, radius * 0.75)
		local h = math.sqrt(math.max(0, radius * radius - d * d)) - radius * 0.45
		local p = cf * CF(math.cos(a) * d, h, math.sin(a) * d) * ANG(rng:NextNumber(-1, 1), rng:NextNumber(0, 6), rng:NextNumber(-1, 1))
		local kind = rng:NextInteger(1, 5)
		local col = Props.randomBright():Lerp(C.Rust, 0.45)
		if kind == 1 then
			Build.block(m, V3(rng:NextNumber(2, 5), rng:NextNumber(0.3, 1), rng:NextNumber(2, 4)), p, col, M.CorrodedMetal)
		elseif kind == 2 then
			Build.cylX(m, rng:NextNumber(3, 7), rng:NextNumber(0.5, 1.2), p, C.Rust, M.CorrodedMetal)
		elseif kind == 3 then
			Build.torus(m, p, 1.2, 0.5, 10, C.Rubber, M.Rubber)
		elseif kind == 4 then
			Build.block(m, V3(2, 2, 2), p, RGB(180, 130, 80), M.WoodPlanks)
		else
			Build.wedge(m, V3(rng:NextNumber(2, 4), rng:NextNumber(1, 3), rng:NextNumber(2, 4)), p, col, M.CorrodedMetal)
		end
	end
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Huge junkyard crane (landmark).
----------------------------------------------------------------------
function Props.crane(parent: Instance, cf: CFrame): Model
	local m = model(parent, "Crane")
	local yellow = RGB(255, 190, 30)
	local dark = RGB(50, 52, 60)
	-- tracks
	for _, z in ipairs({ -5, 5 }) do
		Build.block(m, V3(16, 3, 3.2), cf * CF(0, 1.5, z), dark, M.DiamondPlate)
		for i = 0, 6 do
			Build.cylZ(m, 3.4, 2.4, cf * CF(-6.6 + i * 2.2, 1.4, z), RGB(70, 72, 80), M.Metal)
		end
	end
	-- body
	local body = cf * CF(0, 6, 0)
	Build.block(m, V3(14, 6, 10), body, yellow, M.Metal)
	Build.block(m, V3(6, 5, 8), body * CF(-3, 5.5, 0), yellow, M.Metal)
	local win = Build.block(m, V3(0.2, 3, 6), body * CF(-6.1, 6, 0), RGB(140, 210, 255), M.Glass)
	win.Transparency = 0.3
	Build.block(m, V3(14.2, 0.8, 10.2), body * CF(0, -2.6, 0), C.Black, M.Metal)
	for i = 0, 5 do
		Build.block(m, V3(1.2, 0.82, 10.25), body * CF(-6 + i * 2.4, -2.6, 0) * ANG(0, 0, rad(30)), yellow, M.SmoothPlastic)
	end
	-- exhaust
	Build.cylY(m, 5, 0.8, body * CF(4, 5, 3), C.DarkSteel, M.Metal)
	-- lattice boom
	local boomBase = body * CF(3, 3, 0) * ANG(0, 0, rad(55))
	local boomLen = 46
	for _, z in ipairs({ -1.6, 1.6 }) do
		for _, y in ipairs({ -1.6, 1.6 }) do
			Build.block(m, V3(0.5, boomLen, 0.5), boomBase * CF(y, boomLen / 2, z), yellow, M.Metal)
		end
	end
	for i = 0, 14 do
		local y = 1.5 + i * 3
		Build.block(m, V3(3.4, 0.35, 0.35), boomBase * CF(0, y, 1.6) * ANG(0, 0, rad(45)), yellow, M.Metal)
		Build.block(m, V3(3.4, 0.35, 0.35), boomBase * CF(0, y, -1.6) * ANG(0, 0, rad(-45)), yellow, M.Metal)
		Build.block(m, V3(0.35, 0.35, 3.4), boomBase * CF(1.6, y, 0), yellow, M.Metal)
	end
	-- cable + magnet
	local tip = boomBase * CF(0, boomLen, 0)
	local tipPos = tip.Position
	local magnetPos = Vector3.new(tipPos.X, cf.Position.Y + 14, tipPos.Z)
	local cableLen = (tipPos - magnetPos).Magnitude
	Build.cylY(m, cableLen, 0.3, CFrame.new((tipPos + magnetPos) / 2), RGB(30, 30, 30), M.Metal)
	local mag = CFrame.new(magnetPos)
	Build.cylY(m, 1.6, 7, mag, RGB(60, 62, 70), M.Metal)
	Build.cylY(m, 0.4, 7.4, mag * CF(0, -0.9, 0), RGB(230, 60, 60), M.Metal)
	Build.cylY(m, 1.4, 1.4, mag * CF(0, 1.4, 0), yellow, M.Metal)
	-- dangling car under the magnet
	Props.crushedCube(m, mag * CF(0, -6.5, 0) * ANG(rad(8), rad(30), rad(-6)))
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Corrugated metal fence panel (for perimeter walls).
----------------------------------------------------------------------
function Props.fencePanel(parent: Instance, cf: CFrame, length: number, height: number, color: Color3): Model
	local m = model(parent, "Fence")
	Build.block(m, V3(length, height, 0.6), cf * CF(0, height / 2, 0), color, M.Metal)
	local ribs = math.floor(length / 1.6)
	local dark = color:Lerp(Color3.new(0, 0, 0), 0.22)
	for i = 0, ribs - 1 do
		local x = -length / 2 + 0.8 + i * 1.6
		Build.block(m, V3(0.6, height, 0.9), cf * CF(x, height / 2, 0), dark, M.Metal)
	end
	Build.block(m, V3(length, 0.8, 1.2), cf * CF(0, height, 0), RGB(70, 72, 80), M.Metal)
	-- barbed wire
	for i = 0, math.floor(length / 4) - 1 do
		local x = -length / 2 + 2 + i * 4
		Build.torus(m, cf * CF(x, height + 1.0, 0) * ANG(0, 0, rad(90)), 0.8, 0.06, 8, RGB(170, 170, 176), M.Metal)
	end
	-- support posts
	for _, x in ipairs({ -length / 2, length / 2 }) do
		Build.block(m, V3(1.4, height + 2, 1.4), cf * CF(x, (height + 2) / 2, 0), RGB(60, 62, 70), M.Metal)
		Build.block(m, V3(1.8, 0.6, 1.8), cf * CF(x, height + 2.2, 0), RGB(255, 196, 40), M.SmoothPlastic)
	end
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Toxic pool.
----------------------------------------------------------------------
function Props.toxicPool(parent: Instance, cf: CFrame, radius: number): Model
	local m = model(parent, "ToxicPool")
	local pool = Build.cylY(m, 0.6, radius * 2, cf * CF(0, 0.15, 0), RGB(110, 255, 50), M.Neon)
	pool.Transparency = 0.15
	Build.torus(m, cf * CF(0, 0.3, 0), radius, 0.7, 18, RGB(70, 60, 50), M.Slate)
	Build.light(pool, RGB(120, 255, 60), radius * 1.6, 1.4)
	local att = Instance.new("Attachment")
	att.Parent = pool
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	bubbles.Color = ColorSequence.new(RGB(150, 255, 90))
	bubbles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	bubbles.Lifetime = NumberRange.new(1, 2)
	bubbles.Rate = radius * 1.5
	bubbles.Speed = NumberRange.new(1, 3)
	bubbles.SpreadAngle = Vector2.new(20, 20)
	bubbles.EmissionDirection = Enum.NormalId.Top
	bubbles.Shape = Enum.ParticleEmitterShape.Cylinder
	bubbles.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	bubbles.LightEmission = 0.8
	bubbles.Parent = pool
	return m
end

----------------------------------------------------------------------
-- Glowing crystal cluster (meteor crater).
----------------------------------------------------------------------
function Props.crystals(parent: Instance, cf: CFrame, color: Color3): Model
	local m = model(parent, "Crystals")
	for i = 1, rng:NextInteger(4, 7) do
		local h = rng:NextNumber(3, 9)
		local w = rng:NextNumber(0.8, 1.8)
		local c = cf
			* CF(rng:NextNumber(-2, 2), 0, rng:NextNumber(-2, 2))
			* ANG(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 6), rng:NextNumber(-0.5, 0.5))
		local p = Build.block(m, V3(w, h, w), c * CF(0, h / 2, 0), color, M.Neon)
		p.Transparency = 0.2
		Build.block(
			m,
			V3(w * 0.7, w * 0.7, w * 0.7),
			c * CF(0, h, 0) * ANG(rad(45), 0, rad(45)),
			color:Lerp(Color3.new(1, 1, 1), 0.3),
			M.Neon
		)
		if i == 1 then
			Build.light(p, color, 18, 2)
		end
	end
	collide(m)
	return m
end

----------------------------------------------------------------------
-- Dead tree (toxic zone).
----------------------------------------------------------------------
function Props.deadTree(parent: Instance, cf: CFrame): Model
	local m = model(parent, "DeadTree")
	local bark = RGB(70, 58, 50)
	Build.cylY(m, 10, 1.4, cf * CF(0, 5, 0) * ANG(0, 0, rad(rng:NextNumber(-6, 6))), bark, M.Wood)
	for i = 1, 4 do
		local a = rng:NextNumber(0, 6.28)
		local b = cf * CF(0, 5 + i * 1.2, 0) * ANG(0, a, 0) * ANG(0, 0, rad(-50)) * CF(0, 2, 0)
		Build.cylY(m, 4, 0.5, b, bark, M.Wood)
	end
	collide(m)
	return m
end

return Props
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">ScrapService</string>
          <string name="Source"><![CDATA[-- ScrapService: spawns collectable scrap across the zones and handles tool hits.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local ScrapModels = require(ReplicatedStorage.Shared.ScrapModels)
local DataService = require(script.Parent.DataService)

local ScrapService = {}

type ScrapState = {
	Id: number,
	Model: Model,
	ScrapId: string,
	Rarity: string,
	Zone: string,
	HP: number,
	MaxHP: number,
	Position: Vector3,
}

local scraps: { [number]: ScrapState } = {}
local zoneCounts: { [string]: number } = {}
local nextId = 0
local rng = Random.new()
local folder: Folder
local remotes: Folder
local lastHit: { [Player]: number } = {}
local lastFullWarn: { [Player]: number } = {}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function notify(player: Player, text: string, kind: string?)
	remotes.Notify:FireClient(player, text, kind or "info")
end

local function pickRarity(weights: { [string]: number }, luckBoost: number?): string
	local total = 0
	for rarity, w in pairs(weights) do
		local boost = 1 + (luckBoost or 0) * (Config.Rarities[rarity].Order - 1) * 0.15
		total += w * boost
	end
	local roll = rng:NextNumber(0, total)
	local acc = 0
	for _, rarity in ipairs(Config.RarityOrder) do
		local w = weights[rarity]
		if w then
			local boost = 1 + (luckBoost or 0) * (Config.Rarities[rarity].Order - 1) * 0.15
			acc += w * boost
			if roll <= acc then
				return rarity
			end
		end
	end
	return "Common"
end

local function pickScrap(rarity: string): string
	local list = Config.ScrapsByRarity[rarity]
	return list[rng:NextInteger(1, #list)]
end

local function addRarityFX(model: Model, rarity: string)
	local def = Config.Rarities[rarity]
	local hb = model.PrimaryPart :: BasePart
	if not def.Glow then
		return
	end
	local light = Instance.new("PointLight")
	light.Color = def.Color
	light.Range = 6 + def.Order * 2
	light.Brightness = 1.2 + def.Order * 0.3
	light.Shadows = false
	light.Parent = hb
	local sparkles = Instance.new("ParticleEmitter")
	sparkles.Name = "RarityFX"
	sparkles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	if rarity == "Mythic" then
		sparkles.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)),
			ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 255, 120)),
			ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 180, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 90, 255)),
		})
	else
		sparkles.Color = ColorSequence.new(def.Color)
	end
	sparkles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	sparkles.Lifetime = NumberRange.new(0.8, 1.5)
	sparkles.Rate = 3 + def.Order * 2
	sparkles.Speed = NumberRange.new(1, 3)
	sparkles.SpreadAngle = Vector2.new(180, 180)
	sparkles.LightEmission = 1
	sparkles.Parent = hb
	if def.Order >= 5 then
		-- tall beacon so legendary / mythic scrap is visible from afar
		local beam = Instance.new("Part")
		beam.Name = "Beacon"
		beam.Anchored = true
		beam.CanCollide = false
		beam.CanQuery = false
		beam.CanTouch = false
		beam.CastShadow = false
		beam.Material = Enum.Material.Neon
		beam.Color = def.Color
		beam.Transparency = 0.55
		beam.Shape = Enum.PartType.Cylinder
		beam.Size = Vector3.new(60, 1.2, 1.2)
		beam.CFrame = CFrame.new(hb.Position + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.rad(90))
		beam.Parent = model
	end
end

local function findSpot(zone: Config.ZoneDef): Vector3?
	for _ = 1, 14 do
		local x = rng:NextNumber(-zone.HalfWidth + 8, zone.HalfWidth - 8)
		local z = rng:NextNumber(zone.ZMin + 6, zone.ZMax - 6)
		local origin = Vector3.new(x, 120, z)
		rayParams.FilterDescendantsInstances = { folder }
		local result = workspace:Raycast(origin, Vector3.new(0, -200, 0), rayParams)
		if result and result.Instance == workspace.Terrain and result.Normal.Y > 0.8 then
			local pos = result.Position
			local clear = true
			for _, s in pairs(scraps) do
				if (s.Position - pos).Magnitude < 7 then
					clear = false
					break
				end
			end
			if clear and result.Material ~= Enum.Material.Water then
				return pos
			end
		end
	end
	return nil
end

function ScrapService.spawn(zoneId: string): boolean
	local zone = Config.Zones[zoneId]
	local pos = findSpot(zone)
	if not pos then
		return false
	end
	local rarity = pickRarity(zone.Weights)
	local scrapId = pickScrap(rarity)
	local model = ScrapModels.create(scrapId, false)
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = d.Name == "Hitbox"
		end
	end
	local hb = model.PrimaryPart :: BasePart
	local height = hb.Size.Y
	model:PivotTo(CFrame.new(pos + Vector3.new(0, height / 2 - 0.25, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	nextId += 1
	local hp = Config.Rarities[rarity].HP
	model.Name = "Scrap_" .. nextId
	model:SetAttribute("Id", nextId)
	model:SetAttribute("ScrapId", scrapId)
	model:SetAttribute("Rarity", rarity)
	model:SetAttribute("Zone", zoneId)
	model:SetAttribute("HP", hp)
	model:SetAttribute("MaxHP", hp)
	addRarityFX(model, rarity)
	model.Parent = folder
	scraps[nextId] = {
		Id = nextId,
		Model = model,
		ScrapId = scrapId,
		Rarity = rarity,
		Zone = zoneId,
		HP = hp,
		MaxHP = hp,
		Position = pos,
	}
	zoneCounts[zoneId] = (zoneCounts[zoneId] or 0) + 1
	return true
end

local function remove(state: ScrapState)
	scraps[state.Id] = nil
	zoneCounts[state.Zone] = math.max(0, (zoneCounts[state.Zone] or 1) - 1)
	state.Model:Destroy()
end

local function playerPower(data): number
	local tool = Config.Tools[data.EquippedTool]
	if not tool then
		return 0
	end
	return tool.Power * Config.ToolPowerMultiplier(data.Upgrades.ToolStrength or 0)
end

-- Gives a collected scrap to the player (with the lucky double roll).
local function award(player: Player, scrapId: string, rarity: string, position: Vector3?, source: string)
	local data = DataService.get(player)
	if not data then
		return
	end
	local free = DataService.freeSpace(player)
	if free <= 0 then
		return
	end
	local amount = 1
	local lucky = false
	local chance = Config.LuckChance(data.Upgrades.Luck or 0, data.Machines.RarityRadar or 0)
	if free >= 2 and rng:NextNumber() < chance then
		amount = 2
		lucky = true
	end
	local firstTime = not data.Discovered[scrapId]
	DataService.addItem(player, Config.ItemKey(scrapId, 0), amount)
	data.ScrapsCollected += amount
	DataService.markDirty(player)
	remotes.FX:FireClient(player, {
		Kind = "Collect",
		ScrapId = scrapId,
		Rarity = rarity,
		Amount = amount,
		Lucky = lucky,
		Position = position,
		New = firstTime,
		Source = source,
	})
	if Config.Rarities[rarity].Order >= 5 then
		for _, other in ipairs(Players:GetPlayers()) do
			notify(other, string.format("%s found a %s %s!", player.DisplayName, rarity, Config.Scraps[scrapId].Name), rarity)
		end
	end
end

local function onHit(player: Player, ids: any)
	if type(ids) ~= "table" then
		return
	end
	local data = DataService.get(player)
	if not data then
		return
	end
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local tool = char and char:FindFirstChildOfClass("Tool")
	if not root or not tool or tool:GetAttribute("ToolId") ~= data.EquippedTool then
		return
	end
	local toolDef = Config.Tools[data.EquippedTool]
	local now = os.clock()
	if now - (lastHit[player] or 0) < toolDef.Cooldown * 0.75 then
		return
	end
	lastHit[player] = now

	if DataService.freeSpace(player) <= 0 then
		if now - (lastFullWarn[player] or 0) > 2 then
			lastFullWarn[player] = now
			notify(player, "🎒 Backpack full! Clean and sell your scrap.", "error")
			remotes.FX:FireClient(player, { Kind = "BackpackFull" })
		end
		return
	end

	local power = playerPower(data)
	local hits = 0
	for _, rawId in ipairs(ids) do
		if hits >= toolDef.Targets then
			break
		end
		local id = tonumber(rawId)
		local state = id and scraps[id]
		if state and state.Model.Parent then
			local dist = (state.Position - root.Position).Magnitude
			local size = (state.Model.PrimaryPart :: BasePart).Size.Magnitude / 2
			if dist <= toolDef.Range + size + 6 then
				hits += 1
				local rarityDef = Config.Rarities[state.Rarity]
				if not data.Zones[state.Zone] then
					notify(player, "🔒 Unlock this zone first!", "error")
				elseif power < rarityDef.MinPower then
					remotes.FX:FireClient(player, { Kind = "TooWeak", Id = id, Rarity = state.Rarity })
				else
					state.HP -= power
					state.Model:SetAttribute("HP", math.max(0, state.HP))
					if state.HP <= 0 then
						local pos = (state.Model.PrimaryPart :: BasePart).Position
						remove(state)
						award(player, state.ScrapId, state.Rarity, pos, "Tool")
						remotes.FX:FireAllClients({ Kind = "Break", Position = pos, Rarity = state.Rarity, Player = player.UserId })
						if DataService.freeSpace(player) <= 0 then
							break
						end
					end
				end
			end
		end
	end
end

-- Used by the Magnet Crane machine: grabs a virtual scrap from the best zone
-- the player has unlocked, limited to rarities their tool can handle.
function ScrapService.grantRandom(player: Player): boolean
	local data = DataService.get(player)
	if not data or DataService.freeSpace(player) <= 0 then
		return false
	end
	local best = "Junkyard"
	for _, id in ipairs(Config.ZoneOrder) do
		if data.Zones[id] then
			best = id
		end
	end
	local power = playerPower(data)
	local weights = {}
	for rarity, w in pairs(Config.Zones[best].Weights) do
		if Config.Rarities[rarity].MinPower <= power then
			weights[rarity] = w
		end
	end
	if next(weights) == nil then
		weights = { Common = 1 }
	end
	local rarity = pickRarity(weights)
	award(player, pickScrap(rarity), rarity, nil, "Crane")
	return true
end

function ScrapService.init(remoteFolder: Folder)
	remotes = remoteFolder
	folder = workspace:WaitForChild("Scraps") :: Folder
	remotes.Hit.OnServerEvent:Connect(onHit)
	Players.PlayerRemoving:Connect(function(player)
		lastHit[player] = nil
		lastFullWarn[player] = nil
	end)
	-- initial fill
	for _, zoneId in ipairs(Config.ZoneOrder) do
		local zone = Config.Zones[zoneId]
		zoneCounts[zoneId] = 0
		for _ = 1, zone.MaxScraps do
			ScrapService.spawn(zoneId)
		end
	end
	-- respawn loop
	task.spawn(function()
		while true do
			task.wait(Config.ScrapRespawnTime)
			for _, zoneId in ipairs(Config.ZoneOrder) do
				local zone = Config.Zones[zoneId]
				local missing = zone.MaxScraps - (zoneCounts[zoneId] or 0)
				for _ = 1, math.min(3, missing) do
					ScrapService.spawn(zoneId)
				end
			end
		end
	end)
end

return ScrapService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ToolService</string>
          <string name="Source"><![CDATA[-- ToolService: builds the player's equipped collection tool and applies
-- character stats (walk speed) from upgrades.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local ToolModels = require(ReplicatedStorage.Shared.ToolModels)
local DataService = require(script.Parent.DataService)

local ToolService = {}

local function buildTool(toolId: string): Tool
	local def = Config.Tools[toolId]
	local tool = Instance.new("Tool")
	tool.Name = def.Name
	tool.ToolTip = string.format("Power %d • Range %d", def.Power, def.Range)
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("ToolId", toolId)
	tool.Grip = CFrame.new(0, -0.2, 0)

	local model, handle = ToolModels.create(toolId)
	for _, d in ipairs(model:GetChildren()) do
		d.Parent = tool
	end
	model:Destroy()
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = false
			d.CanCollide = false
			d.CanTouch = false
			d.CanQuery = false
			d.Massless = true
			d.CastShadow = false
		end
	end
	for _, d in ipairs(tool:GetDescendants()) do
		if d:IsA("BasePart") and d ~= handle then
			local w = Instance.new("WeldConstraint")
			w.Part0 = handle
			w.Part1 = d
			w.Parent = d
		end
	end
	-- swing / hit sounds
	local swing = Instance.new("Sound")
	swing.Name = "SwingSound"
	swing.SoundId = "rbxasset://sounds/swordslash.wav"
	swing.Volume = 0.35
	swing.PlaybackSpeed = 1.2
	swing.Parent = handle
	return tool
end

function ToolService.give(player: Player)
	local data = DataService.get(player)
	if not data then
		return
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	local char = player.Character
	for _, container in ipairs({ backpack, char } :: { Instance? }) do
		if container then
			for _, t in ipairs(container:GetChildren()) do
				if t:IsA("Tool") and t:GetAttribute("ToolId") then
					t:Destroy()
				end
			end
		end
	end
	if not backpack then
		return
	end
	local tool = buildTool(data.EquippedTool)
	tool.Parent = backpack
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if humanoid then
		task.defer(function()
			if tool.Parent == backpack and humanoid.Parent and humanoid.Health > 0 then
				humanoid:EquipTool(tool)
			end
		end)
	end
end

function ToolService.applyStats(player: Player)
	local data = DataService.get(player)
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	if not data or not humanoid then
		return
	end
	if player:GetAttribute("SpeedOverride") then
		return
	end
	humanoid.WalkSpeed = Config.WalkSpeed(data.Upgrades.WalkSpeed or 0)
end

function ToolService.onCharacter(player: Player, char: Model)
	local humanoid = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	ToolService.applyStats(player)
	task.wait(0.2)
	ToolService.give(player)
end

return ToolService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">WorldBuilder</string>
          <string name="Source"><![CDATA[-- WorldBuilder: generates the whole shared scrapyard at server start.
-- Hub (spawn, wash stations, sell shop, tool shop, upgrade lab, machine bay)
-- followed by four gated scrap zones.

local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Build = require(ReplicatedStorage.Shared.Build)
local Config = require(ReplicatedStorage.Shared.Config)
local ToolModels = require(ReplicatedStorage.Shared.ToolModels)
local Format = require(ReplicatedStorage.Shared.Format)
local Props = require(script.Parent.Props)
local MachineModels = require(script.Parent.MachineModels)

local C = Build.Colors
local M = Enum.Material
local rad = math.rad
local CF = CFrame.new
local ANG = CFrame.Angles
local V3 = Vector3.new
local RGB = Color3.fromRGB

local WorldBuilder = {}

local rng = Random.new(2024)
local terrain = workspace.Terrain

WorldBuilder.Stations = {} :: { Model }
WorldBuilder.ZoneSpawns = {} :: { [string]: CFrame }
WorldBuilder.HubSpawn = CFrame.new(0, 4, -20)

local root: Folder

local function folder(name: string, parent: Instance): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

local function newModel(name: string, parent: Instance): Model
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = parent
	return m
end

local function collide(m: Instance)
	Build.setAll(m, { CanCollide = true })
end

local function prompt(parent: BasePart, action: string, object: string, openUI: string?, holdTime: number?): ProximityPrompt
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = holdTime or 0
	p.MaxActivationDistance = 12
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.Style = Enum.ProximityPromptStyle.Default
	if openUI then
		p:SetAttribute("OpenUI", openUI)
	end
	p.Parent = parent
	return p
end

local function promptPart(parent: Instance, cf: CFrame, size: Vector3?): BasePart
	return Build.part(parent, "Part", {
		Name = "PromptPart",
		Size = size or V3(2, 2, 2),
		CFrame = cf,
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
end

-- Big chunky sign with a coloured frame.
local function bigSign(parent: Instance, cf: CFrame, size: Vector3, text: string, bg: Color3, textColor: Color3?): BasePart
	local board = Build.block(parent, size, cf, bg, M.SmoothPlastic, "Sign")
	Build.block(
		parent,
		size + V3(0.6, 0.6, -size.Z * 0.4),
		cf * CF(0, 0, size.Z * 0.3),
		bg:Lerp(Color3.new(0, 0, 0), 0.35),
		M.SmoothPlastic
	)
	Build.sign(board, Enum.NormalId.Front, text, textColor or C.White, bg:Lerp(Color3.new(0, 0, 0), 0.55))
	Build.sign(board, Enum.NormalId.Back, text, textColor or C.White, bg:Lerp(Color3.new(0, 0, 0), 0.55))
	-- bulbs around the edge
	local bulbs = math.floor(size.X / 2.2)
	for i = 0, bulbs - 1 do
		local x = -size.X / 2 + 1.1 + i * ((size.X - 2.2) / math.max(1, bulbs - 1))
		for _, y in ipairs({ size.Y / 2 + 0.3, -size.Y / 2 - 0.3 }) do
			Build.ball(parent, 0.5, cf * CF(x, y, -size.Z / 2), RGB(255, 240, 160), M.Neon)
		end
	end
	return board
end

----------------------------------------------------------------------
-- Lighting / atmosphere for the bright simulator look
----------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 3
	Lighting.GlobalShadows = true
	Lighting.Ambient = RGB(110, 105, 120)
	Lighting.OutdoorAmbient = RGB(150, 150, 165)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.ExposureCompensation = 0.1
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	for _, c in ipairs(Lighting:GetChildren()) do
		if c:IsA("PostEffect") or c:IsA("Atmosphere") or c:IsA("Sky") then
			c:Destroy()
		end
	end
	local atmo = Instance.new("Atmosphere")
	atmo.Density = 0.28
	atmo.Offset = 0.1
	atmo.Color = RGB(205, 225, 255)
	atmo.Decay = RGB(255, 190, 140)
	atmo.Glare = 0.3
	atmo.Haze = 1.2
	atmo.Parent = Lighting
	local sky = Instance.new("Sky")
	sky.SunAngularSize = 14
	sky.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.55
	bloom.Size = 28
	bloom.Threshold = 1.25
	bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Saturation = 0.28
	cc.Contrast = 0.1
	cc.Brightness = 0.02
	cc.TintColor = RGB(255, 250, 245)
	cc.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
end

----------------------------------------------------------------------
-- Terrain
----------------------------------------------------------------------
local function setupTerrain()
	terrain:Clear()
	terrain:SetMaterialColor(M.Ground, RGB(132, 104, 76))
	terrain:SetMaterialColor(M.Mud, RGB(98, 76, 58))
	terrain:SetMaterialColor(M.LeafyGrass, RGB(110, 190, 80))
	terrain:SetMaterialColor(M.Grass, RGB(110, 190, 80))
	terrain:SetMaterialColor(M.Sandstone, RGB(222, 132, 74))
	terrain:SetMaterialColor(M.Sand, RGB(240, 180, 110))
	terrain:SetMaterialColor(M.Rock, RGB(170, 96, 62))
	terrain:SetMaterialColor(M.Slate, RGB(70, 84, 72))
	terrain:SetMaterialColor(M.Basalt, RGB(74, 56, 98))
	terrain:SetMaterialColor(M.CrackedLava, RGB(255, 90, 160))
	terrain:SetMaterialColor(M.Asphalt, RGB(70, 72, 80))

	local function slab(x0: number, x1: number, z0: number, z1: number, material: Enum.Material)
		local size = V3(x1 - x0, 8, z1 - z0)
		terrain:FillBlock(CF((x0 + x1) / 2, -4, (z0 + z1) / 2), size, material)
	end
	-- whole map base
	slab(-150, 150, -120, 870, M.Ground)
	-- hub surroundings: grass verge
	slab(-150, 150, -120, 74, M.LeafyGrass)
	-- zone grounds
	slab(-150, 150, 74, 276, M.Ground)
	slab(-150, 150, 276, 466, M.Sandstone)
	slab(-150, 150, 466, 656, M.Slate)
	slab(-150, 150, 656, 870, M.Basalt)

	-- mud patches in the junk fields
	for _ = 1, 14 do
		local x = rng:NextNumber(-110, 110)
		local z = rng:NextNumber(90, 260)
		terrain:FillCylinder(CF(x, -0.9, z), 2, rng:NextNumber(6, 14), M.Mud)
	end
	-- sand dunes in rust canyon
	for _ = 1, 10 do
		local x = rng:NextNumber(-110, 110)
		local z = rng:NextNumber(300, 455)
		terrain:FillCylinder(CF(x, -0.9, z), 2, rng:NextNumber(6, 12), M.Sand)
	end
	-- canyon walls
	for z = 285, 465, 12 do
		for _, side in ipairs({ -1, 1 }) do
			local x = side * rng:NextNumber(118, 128)
			terrain:FillBall(V3(x, rng:NextNumber(2, 10), z), rng:NextNumber(12, 18), M.Rock)
			terrain:FillBall(V3(x + side * 8, rng:NextNumber(14, 22), z + 5), rng:NextNumber(8, 12), M.Sandstone)
		end
	end
	-- rock mesas in the canyon
	for _, p in ipairs({ V3(-70, 0, 340), V3(75, 0, 410), V3(-55, 0, 440), V3(60, 0, 320) }) do
		terrain:FillCylinder(CF(p.X, 6, p.Z), 14, 9, M.Rock)
		terrain:FillCylinder(CF(p.X, 14, p.Z), 3, 11, M.Sandstone)
	end
	-- meteor crater: carve a bowl and line its floor with glowing lava rock
	local crater = V3(0, 0, 760)
	terrain:FillBall(crater + V3(0, 50, 0), 62, M.Air)
	for a = 0, 330, 30 do
		local p = crater + V3(math.cos(rad(a)) * 42, 1, math.sin(rad(a)) * 42)
		terrain:FillBall(p, rng:NextNumber(7, 11), M.Basalt)
	end
	local floor = Region3.new(crater + V3(-24, -16, -24), crater + V3(24, -6, 24)):ExpandToGrid(4)
	terrain:ReplaceMaterial(floor, 4, M.Basalt, M.CrackedLava)
end

----------------------------------------------------------------------
-- Hub
----------------------------------------------------------------------
local function buildPlaza(hub: Instance)
	local plaza = newModel("Plaza", hub)
	Build.block(plaza, V3(180, 1, 160), CF(0, -0.3, -10), RGB(196, 200, 210), M.Pavement)
	-- coloured tile ring around the spawn
	Build.cylY(plaza, 0.3, 34, CF(0, 0.3, -20), RGB(80, 170, 255), M.SmoothPlastic)
	Build.cylY(plaza, 0.35, 30, CF(0, 0.33, -20), RGB(240, 245, 255), M.SmoothPlastic)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		Build.block(plaza, V3(5, 0.4, 2), CF(0, 0.36, -20) * ANG(0, a, 0) * CF(12.5, 0, 0), RGB(255, 200, 60), M.SmoothPlastic)
	end
	-- road to the junk fields
	Build.block(plaza, V3(26, 0.4, 92), CF(0, 0.22, 26), RGB(70, 72, 82), M.Asphalt)
	for z = -14, 66, 10 do
		Build.block(plaza, V3(0.8, 0.45, 5), CF(0, 0.25, z), RGB(255, 210, 60), M.SmoothPlastic)
	end
	Build.block(plaza, V3(0.8, 0.45, 92), CF(-12.6, 0.25, 26), C.White, M.SmoothPlastic)
	Build.block(plaza, V3(0.8, 0.45, 92), CF(12.6, 0.25, 26), C.White, M.SmoothPlastic)
	collide(plaza)

	-- spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HubSpawn"
	spawn.Size = V3(12, 1, 12)
	spawn.CFrame = CF(0, 0.5, -20) * ANG(0, math.pi, 0)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Material = M.Neon
	spawn.Color = RGB(90, 200, 255)
	spawn.Transparency = 0.2
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = hub
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end

	-- lamps around the plaza
	for _, p in ipairs({ V3(-20, 0, -40), V3(20, 0, -40), V3(-18, 0, 10), V3(18, 0, 10), V3(-18, 0, 60), V3(18, 0, 60) }) do
		Props.lamp(hub, CF(p) * ANG(0, p.X > 0 and math.pi or 0, 0))
	end
	-- benches/planters
	for _, x in ipairs({ -26, 26 }) do
		for _, z in ipairs({ -60, -2 }) do
			local planter = newModel("Planter", hub)
			Build.block(planter, V3(8, 2, 8), CF(x, 1, z), RGB(150, 110, 80), M.WoodPlanks)
			Build.block(planter, V3(7, 0.4, 7), CF(x, 2, z), RGB(90, 70, 50), M.Ground)
			Build.ball(planter, 5.5, CF(x, 4.2, z), RGB(90, 200, 90), M.Grass)
			Build.ball(planter, 3.5, CF(x + 1.5, 6, z - 1), RGB(110, 220, 100), M.Grass)
			for i = 0, 4 do
				local a = i / 5 * math.pi * 2
				Build.ball(planter, 0.8, CF(x, 4.4, z) * ANG(0, a, 0) * CF(2.6, 0.5, 0), Props.randomBright(), M.SmoothPlastic)
			end
			collide(planter)
		end
	end
end

local function buildArch(parent: Instance, z: number, text: string, color: Color3)
	local arch = newModel("Arch", parent)
	for _, x in ipairs({ -17, 17 }) do
		Props.crushedCube(arch, CF(x, 0, z) * ANG(0, rad(8), 0), RGB(80, 150, 255))
		Props.crushedCube(arch, CF(x, 5, z) * ANG(0, rad(-6), 0), RGB(255, 90, 90))
		Props.crushedCube(arch, CF(x, 10, z) * ANG(0, rad(4), 0), RGB(255, 200, 50))
	end
	Build.block(arch, V3(42, 2, 4), CF(0, 16, z), RGB(60, 62, 72), M.Metal)
	bigSign(arch, CF(0, 20.5, z) * ANG(0, math.pi, 0), V3(34, 7, 1.2), text, color)
	collide(arch)
end

-- Wash station: cabinet, tub, faucet, pressure washer, tool shelf.
local function buildStation(parent: Instance, index: number, cf: CFrame): Model
	local st = newModel("Station" .. index, parent)
	st:SetAttribute("StationId", index)
	local blue = RGB(70, 170, 255)
	local white = RGB(245, 248, 255)
	-- cabinet (local -Z faces the player)
	Build.block(st, V3(8, 3.4, 5), cf * CF(0, 1.7, 0), white, M.SmoothPlastic)
	Build.block(st, V3(8.2, 0.4, 5.2), cf * CF(0, 0.2, 0), blue, M.SmoothPlastic)
	for _, x in ipairs({ -2, 2 }) do
		Build.block(st, V3(3.6, 2.4, 0.1), cf * CF(x, 1.8, -2.52), RGB(225, 232, 245), M.SmoothPlastic)
		Build.block(st, V3(1.2, 0.2, 0.2), cf * CF(x, 2.7, -2.62), C.Chrome, M.Metal)
	end
	-- tub rim + water
	local top = cf * CF(0, 3.5, 0)
	Build.block(st, V3(8.4, 0.4, 0.8), top * CF(0, 0, -2.3), blue, M.SmoothPlastic)
	Build.block(st, V3(8.4, 0.4, 0.8), top * CF(0, 0, 2.3), blue, M.SmoothPlastic)
	Build.block(st, V3(0.8, 0.4, 5.4), top * CF(-3.8, 0, 0), blue, M.SmoothPlastic)
	Build.block(st, V3(0.8, 0.4, 5.4), top * CF(3.8, 0, 0), blue, M.SmoothPlastic)
	local water = Build.block(st, V3(6.8, 0.2, 3.8), top * CF(0, -0.15, 0), RGB(110, 210, 255), M.Glass, "Water")
	water.Transparency = 0.25
	-- foam blobs
	for i = 1, 6 do
		Build.ball(
			st,
			rng:NextNumber(0.6, 1.1),
			top * CF(rng:NextNumber(-3, 3), 0, rng:NextNumber(-1.5, 1.5)),
			RGB(255, 255, 255),
			M.SmoothPlastic
		)
	end
	-- spot where the scrap sits while being cleaned
	local spot = Build.part(st, "Part", {
		Name = "ItemSpot",
		Size = V3(1, 1, 1),
		CFrame = top * CF(0, 2.2, 0),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Name = "Bubbles"
	bubbles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	bubbles.Color = ColorSequence.new(RGB(200, 240, 255), RGB(255, 200, 255))
	bubbles.Size =
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(0.5, 0.9), NumberSequenceKeypoint.new(1, 0) })
	bubbles.Transparency = NumberSequence.new(0.2)
	bubbles.Lifetime = NumberRange.new(1, 2)
	bubbles.Rate = 30
	bubbles.Speed = NumberRange.new(2, 4)
	bubbles.SpreadAngle = Vector2.new(60, 60)
	bubbles.EmissionDirection = Enum.NormalId.Top
	bubbles.LightEmission = 0.4
	bubbles.Enabled = false
	bubbles.Parent = spot
	local sparkle = bubbles:Clone()
	sparkle.Name = "Sparkle"
	sparkle.Color = ColorSequence.new(RGB(255, 240, 120))
	sparkle.Rate = 0
	sparkle.Speed = NumberRange.new(6, 12)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.LightEmission = 1
	sparkle.Parent = spot
	-- backsplash + faucet
	Build.block(st, V3(8.4, 6, 0.6), cf * CF(0, 6.4, 2.8), RGB(190, 230, 255), M.CeramicTiles)
	Build.block(st, V3(8.6, 0.5, 1.6), cf * CF(0, 9.4, 2.4), blue, M.SmoothPlastic)
	local faucet = cf * CF(0, 6.2, 2.3)
	Build.cylZ(st, 1.4, 0.5, faucet, C.Chrome, M.Metal)
	Build.cylY(st, 1.6, 0.45, faucet * CF(0, 0.8, -0.7), C.Chrome, M.Metal)
	Build.cylZ(st, 1.6, 0.42, faucet * CF(0, 1.55, -1.4), C.Chrome, M.Metal)
	Build.cylY(st, 0.6, 0.6, faucet * CF(0, 1.2, -2.2), C.Chrome, M.Metal)
	for _, x in ipairs({ -1, 1 }) do
		Build.cylY(st, 0.5, 0.5, faucet * CF(x * 1.2, 0.4, 0), x < 0 and C.Red or blue, M.SmoothPlastic)
	end
	local nozzle = Build.part(st, "Part", {
		Name = "Nozzle",
		Size = V3(0.4, 0.4, 0.4),
		CFrame = faucet * CF(0, 0.85, -2.2),
		Transparency = 1,
		CanCollide = false,
	})
	local spray = Instance.new("ParticleEmitter")
	spray.Name = "Spray"
	spray.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	spray.Color = ColorSequence.new(RGB(150, 220, 255))
	spray.Size = NumberSequence.new(0.25)
	spray.Lifetime = NumberRange.new(0.3, 0.5)
	spray.Rate = 60
	spray.Speed = NumberRange.new(6, 8)
	spray.SpreadAngle = Vector2.new(8, 8)
	spray.EmissionDirection = Enum.NormalId.Bottom
	spray.Acceleration = V3(0, -20, 0)
	spray.Enabled = false
	spray.Parent = nozzle
	-- shelf with soaps / brushes
	local shelf = cf * CF(0, 8.0, 2.2)
	Build.block(st, V3(7, 0.25, 1.0), shelf, RGB(150, 100, 60), M.Wood)
	for i, col in ipairs({ RGB(255, 90, 200), RGB(90, 220, 255), RGB(255, 220, 60), RGB(120, 255, 120) }) do
		local x = -3 + i * 1.2
		Build.block(st, V3(0.7, 1.1, 0.6), shelf * CF(x, 0.68, 0), col, M.SmoothPlastic)
		Build.cylY(st, 0.25, 0.3, shelf * CF(x, 1.35, 0), C.White)
	end
	Build.block(st, V3(1.2, 0.3, 0.5), shelf * CF(2.8, 0.3, 0), RGB(255, 130, 60))
	Build.block(st, V3(1.1, 0.2, 0.4), shelf * CF(2.8, 0.55, 0), RGB(250, 250, 240), M.Fabric)
	-- pressure washer cart beside the cabinet
	local pw = cf * CF(5.6, 0, 0.5)
	Build.block(st, V3(2.6, 2.4, 3.2), pw * CF(0, 2.0, 0), RGB(255, 200, 40), M.SmoothPlastic)
	Build.block(st, V3(2.7, 0.4, 3.3), pw * CF(0, 3.3, 0), RGB(40, 40, 46), M.SmoothPlastic)
	Build.cylX(st, 0.5, 1.4, pw * CF(1.3, 0.7, 1.1), C.Rubber, M.Rubber)
	Build.cylX(st, 0.5, 1.4, pw * CF(-1.3, 0.7, 1.1), C.Rubber, M.Rubber)
	Build.cylY(st, 1.6, 0.25, pw * CF(0, 4.1, 1.2), C.Chrome, M.Metal)
	Build.torus(st, pw * CF(0, 2.0, -1.65) * ANG(rad(90), 0, 0), 0.7, 0.12, 12, C.Black, M.Rubber)
	-- number sign
	local numberSign = Build.block(st, V3(2.6, 2.2, 0.4), cf * CF(0, 11.2, 2.6), RGB(255, 200, 60), M.SmoothPlastic)
	Build.sign(numberSign, Enum.NormalId.Front, tostring(index), C.White, RGB(150, 90, 20))
	-- status light (server recolours: green = free, red = busy)
	local status = Build.ball(st, 0.9, cf * CF(3.6, 9.9, 2.4), RGB(90, 255, 120), M.Neon)
	status.Name = "StatusLight"
	collide(st)
	-- prompt
	local pp = promptPart(st, cf * CF(0, 3, -3.4), V3(6, 3, 1))
	local p = prompt(pp, "Clean Scrap", "Wash Station " .. index, nil)
	p.Name = "CleanPrompt"
	p:SetAttribute("StationId", index)
	st.PrimaryPart = spot
	return st
end

local function buildCleaningShed(hub: Instance)
	local shed = newModel("CleaningShed", hub)
	local x0 = -62
	-- floor
	Build.block(shed, V3(24, 0.6, 78), CF(x0, 0.3, -10), RGB(180, 230, 255), M.CeramicTiles)
	-- back wall
	Build.block(shed, V3(1.4, 20, 78), CF(x0 - 11.5, 10, -10), RGB(90, 170, 240), M.SmoothPlastic)
	for z = -46, 26, 8 do
		Build.block(shed, V3(1.6, 20, 0.8), CF(x0 - 11.4, 10, z), RGB(70, 140, 210), M.SmoothPlastic)
	end
	-- side walls
	for _, z in ipairs({ -49, 29 }) do
		Build.block(shed, V3(24, 20, 1.4), CF(x0, 10, z), RGB(90, 170, 240), M.SmoothPlastic)
	end
	-- pillars
	for z = -48, 28, 19 do
		Build.block(shed, V3(1.6, 20, 1.6), CF(x0 + 11.2, 10, z), RGB(255, 255, 255), M.SmoothPlastic)
	end
	-- slanted roof with corrugation stripes
	local roof = CF(x0, 21.6, -10) * ANG(0, 0, rad(-8))
	Build.block(shed, V3(28, 1, 82), roof, RGB(70, 200, 230), M.Metal)
	for i = 0, 19 do
		Build.block(
			shed,
			V3(28.2, 1.15, 1.2),
			roof * CF(0, 0, -39 + i * 4.1),
			(i % 2 == 0) and RGB(255, 255, 255) or RGB(110, 220, 240),
			M.Metal
		)
	end
	collide(shed)
	-- sign on front fascia
	bigSign(
		shed,
		CF(x0 + 13, 19, -10) * ANG(0, math.rad(90), 0) * ANG(0, math.pi, 0),
		V3(30, 5.5, 1),
		"🫧 WASH STATION 🫧",
		RGB(60, 160, 255)
	)
	-- stations face east (toward the plaza)
	local zs = { -36, -19, -2, 15 }
	for i, z in ipairs(zs) do
		local pos = V3(x0 - 4, 0.6, z)
		local cf = CFrame.lookAt(pos, pos + V3(1, 0, 0))
		WorldBuilder.Stations[i] = buildStation(shed, i, cf)
	end
	-- soap bubbles drifting from the roof
	local fxPart = Build.part(
		shed,
		"Part",
		{ Name = "FX", Size = V3(20, 1, 70), CFrame = CF(x0, 18, -10), Transparency = 1, CanCollide = false, CanQuery = false }
	)
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(RGB(220, 245, 255), RGB(255, 210, 255))
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1.2) })
	e.Transparency = NumberSequence.new(0.4, 1)
	e.Lifetime = NumberRange.new(4, 6)
	e.Rate = 6
	e.Speed = NumberRange.new(0.5, 1.5)
	e.Acceleration = V3(0, -0.6, 0)
	e.Shape = Enum.ParticleEmitterShape.Box
	e.Parent = fxPart
end

-- Friendly blocky shopkeeper NPC.
local function buildNPC(parent: Instance, cf: CFrame, shirt: Color3, hat: Color3): Model
	local npc = newModel("Shopkeeper", parent)
	local skin = RGB(255, 210, 160)
	Build.block(npc, V3(2, 2, 1), cf * CF(0, 3, 0), shirt, M.SmoothPlastic)
	Build.block(npc, V3(1.6, 1.4, 0.2), cf * CF(0, 3.2, -0.55), RGB(70, 110, 200), M.Fabric)
	for _, x in ipairs({ -0.5, 0.5 }) do
		Build.block(npc, V3(1, 2, 1), cf * CF(x, 1, 0), RGB(70, 110, 200), M.Fabric)
		Build.block(npc, V3(1.02, 0.4, 1.1), cf * CF(x, 0.2, -0.05), RGB(60, 40, 30), M.Leather)
	end
	Build.block(npc, V3(1, 2, 1), cf * CF(-1.5, 3, 0) * ANG(rad(10), 0, 0), skin)
	Build.block(npc, V3(1, 2, 1), cf * CF(1.5, 3.2, -0.4) * ANG(rad(50), 0, rad(-10)), skin)
	local head = Build.cylY(npc, 1.2, 1.25, cf * CF(0, 4.6, 0), skin)
	head.Size = V3(1.2, 1.25, 1.25)
	Build.block(npc, V3(1.0, 1.0, 1.0), cf * CF(0, 4.6, 0), skin)
	for _, x in ipairs({ -0.25, 0.25 }) do
		Build.block(npc, V3(0.16, 0.24, 0.05), cf * CF(x, 4.75, -0.52), RGB(20, 20, 20))
	end
	Build.block(npc, V3(0.5, 0.08, 0.05), cf * CF(0, 4.35, -0.52), RGB(120, 40, 40))
	Build.block(npc, V3(0.12, 0.12, 0.05), cf * CF(-0.28, 4.4, -0.52), RGB(120, 40, 40))
	Build.block(npc, V3(0.12, 0.12, 0.05), cf * CF(0.28, 4.4, -0.52), RGB(120, 40, 40))
	-- hard hat
	Build.cylY(npc, 0.6, 1.5, cf * CF(0, 5.4, 0), hat, M.SmoothPlastic)
	Build.cylY(npc, 0.12, 1.9, cf * CF(0, 5.15, -0.1), hat, M.SmoothPlastic)
	Build.block(npc, V3(0.2, 0.62, 1.52), cf * CF(0, 5.42, 0), hat:Lerp(Color3.new(1, 1, 1), 0.3), M.SmoothPlastic)
	collide(npc)
	return npc
end

local function buildSellShop(hub: Instance)
	local shop = newModel("ScrapExchange", hub)
	local x0 = 62
	local green = RGB(70, 210, 110)
	Build.block(shop, V3(24, 0.6, 78), CF(x0, 0.3, -10), RGB(240, 230, 200), M.WoodPlanks)
	Build.block(shop, V3(1.4, 20, 78), CF(x0 + 11.5, 10, -10), green, M.SmoothPlastic)
	for z = -46, 26, 8 do
		Build.block(shop, V3(1.6, 20, 0.8), CF(x0 + 11.4, 10, z), RGB(50, 170, 90), M.SmoothPlastic)
	end
	for _, z in ipairs({ -49, 29 }) do
		Build.block(shop, V3(24, 20, 1.4), CF(x0, 10, z), green, M.SmoothPlastic)
	end
	for z = -48, 28, 19 do
		Build.block(shop, V3(1.6, 20, 1.6), CF(x0 - 11.2, 10, z), C.White, M.SmoothPlastic)
	end
	local roof = CF(x0, 21.6, -10) * ANG(0, 0, rad(8))
	Build.block(shop, V3(28, 1, 82), roof, RGB(255, 210, 60), M.Metal)
	for i = 0, 19 do
		Build.block(
			shop,
			V3(28.2, 1.15, 1.2),
			roof * CF(0, 0, -39 + i * 4.1),
			(i % 2 == 0) and RGB(255, 255, 255) or RGB(255, 225, 110),
			M.Metal
		)
	end
	-- counter
	Build.block(shop, V3(3, 4, 40), CF(x0 + 2, 2, -10), RGB(170, 110, 60), M.Wood)
	Build.block(shop, V3(3.6, 0.5, 40.6), CF(x0 + 2, 4.25, -10), RGB(250, 240, 220), M.Marble)
	for z = -28, 8, 6 do
		Build.block(shop, V3(0.2, 3, 4), CF(x0 + 0.45, 2, z), RGB(140, 90, 50), M.Wood)
	end
	-- cash register
	local reg = CF(x0 + 2, 4.5, -2)
	Build.block(shop, V3(2, 1.2, 2.4), reg * CF(0, 0.6, 0), RGB(60, 64, 76), M.Metal)
	Build.wedge(shop, V3(2, 0.8, 1.4), reg * CF(0, 1.6, 0.4) * ANG(0, math.pi, 0), RGB(60, 64, 76), M.Metal)
	Build.block(shop, V3(0.1, 0.5, 1.4), reg * CF(-1.05, 1.5, 0), RGB(90, 255, 140), M.Neon)
	-- big scale
	local scale = CF(x0 - 3, 0.6, -40)
	Build.block(shop, V3(8, 0.8, 8), scale * CF(0, 0.4, 0), RGB(80, 84, 96), M.DiamondPlate)
	Build.block(shop, V3(1, 9, 1), scale * CF(0, 5, 3.6), RGB(80, 84, 96), M.Metal)
	local dial = scale * CF(0, 10, 3.6)
	Build.cylZ(shop, 0.8, 5, dial, RGB(255, 255, 255), M.SmoothPlastic)
	Build.torus(shop, dial * ANG(rad(90), 0, 0), 2.5, 0.25, 20, RGB(255, 200, 60), M.Metal)
	Build.block(shop, V3(0.2, 2.0, 0.1), dial * CF(0.5, 0.4, -0.45) * ANG(0, 0, rad(-30)), C.Red)
	collide(shop)
	-- NPC behind the counter
	buildNPC(shop, CFrame.lookAt(V3(x0 + 5.5, 0.6, -10), V3(x0 - 10, 0.6, -10)), RGB(255, 200, 60), RGB(255, 200, 40))
	-- sign
	bigSign(
		shop,
		CF(x0 - 13, 19, -10) * ANG(0, math.rad(-90), 0) * ANG(0, math.pi, 0),
		V3(30, 5.5, 1),
		"💰 SELL SCRAP 💰",
		RGB(50, 190, 90)
	)
	-- glowing sell pad on the floor in front of the counter
	local pad = Build.cylY(shop, 0.4, 14, CF(x0 - 5, 0.8, -10), RGB(90, 255, 130), M.Neon)
	pad.Name = "SellPad"
	pad.CanCollide = false
	pad.CanTouch = true
	pad.Transparency = 0.25
	Build.torus(shop, CF(x0 - 5, 0.9, -10), 7, 0.4, 24, RGB(255, 255, 255), M.SmoothPlastic)
	local padSign = Build.part(
		shop,
		"Part",
		{ Name = "PadText", Size = V3(10, 4, 0.2), CFrame = CF(x0 - 5, 5, -10) * ANG(0, rad(-90), 0), Transparency = 1, CanCollide = false }
	)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromScale(12, 3)
	bb.AlwaysOnTop = false
	bb.LightInfluence = 0
	bb.Parent = padSign
	local tl = Instance.new("TextLabel")
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(1, 1)
	tl.Font = Enum.Font.FredokaOne
	tl.Text = "SELL HERE"
	tl.TextScaled = true
	tl.TextColor3 = RGB(120, 255, 150)
	tl.Parent = bb
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Color = RGB(20, 80, 30)
	st.Parent = tl
	local coins = Instance.new("ParticleEmitter")
	coins.Name = "CoinFX"
	coins.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	coins.Color = ColorSequence.new(RGB(255, 220, 60))
	coins.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0) })
	coins.Lifetime = NumberRange.new(0.8, 1.4)
	coins.Rate = 0
	coins.Speed = NumberRange.new(14, 22)
	coins.SpreadAngle = Vector2.new(35, 35)
	coins.EmissionDirection = Enum.NormalId.Top
	coins.Acceleration = V3(0, -40, 0)
	coins.LightEmission = 1
	coins.Parent = pad
	local pp = promptPart(shop, CF(x0, 4.5, -10), V3(1, 3, 10))
	prompt(pp, "Sell Scrap", "Scrap Exchange", "Sell")
end

local function buildToolShop(hub: Instance)
	local shop = newModel("ToolShop", hub)
	local o = CF(-40, 0, -78)
	local red = RGB(235, 70, 70)
	Build.block(shop, V3(30, 0.6, 16), o * CF(0, 0.3, 0), RGB(200, 160, 110), M.WoodPlanks)
	-- pegboard back wall with tools on display
	Build.block(shop, V3(30, 16, 1), o * CF(0, 8.5, -7.5), RGB(214, 170, 120), M.WoodPlanks)
	Build.block(shop, V3(26, 10, 0.3), o * CF(0, 9, -6.85), RGB(240, 210, 160), M.Cardboard)
	for i, toolId in ipairs(Config.ToolOrder) do
		local tm, handle = ToolModels.create(toolId)
		local x = -11 + (i - 1) * 4.4
		local target = o * CF(x, 8, -6.2) * ANG(0, 0, rad(-12))
		local offset = handle.CFrame
		for _, d in ipairs(tm:GetDescendants()) do
			if d:IsA("BasePart") then
				d.CFrame = target * offset:Inverse() * d.CFrame
				d.Anchored = true
				d.CanCollide = false
			end
		end
		tm.Parent = shop
		local tag = Build.block(shop, V3(3.2, 0.8, 0.2), o * CF(x, 4.6, -6.6), Config.Tools[toolId].Color, M.SmoothPlastic)
		Build.sign(tag, Enum.NormalId.Front, Format.cash(Config.Tools[toolId].Price), C.White, RGB(30, 30, 30))
	end
	-- counter
	Build.block(shop, V3(22, 4, 3), o * CF(0, 2, 3), red, M.SmoothPlastic)
	Build.block(shop, V3(22.6, 0.5, 3.6), o * CF(0, 4.25, 3), RGB(250, 245, 235), M.Marble)
	-- striped awning
	for i = 0, 9 do
		local col = (i % 2 == 0) and red or C.White
		Build.wedge(shop, V3(3.1, 3, 8), o * CF(-13.5 + i * 3, 15.5, 2) * ANG(0, math.pi, 0), col, M.Fabric)
	end
	for _, x in ipairs({ -14.4, 14.4 }) do
		Build.block(shop, V3(1, 16, 1), o * CF(x, 8, 5.5), RGB(120, 80, 50), M.Wood)
	end
	collide(shop)
	buildNPC(shop, o * CF(4, 0.6, -2) * ANG(0, math.pi, 0), RGB(235, 70, 70), RGB(60, 60, 70))
	bigSign(shop, o * CF(0, 19, 5) * ANG(0, math.pi, 0), V3(20, 5, 1), "🔧 TOOL SHOP", RGB(230, 70, 70))
	local pp = promptPart(shop, o * CF(0, 3, 5), V3(16, 3, 1))
	prompt(pp, "Browse Tools", "Tool Shop", "Tools")
end

local function buildUpgradeLab(hub: Instance)
	local lab = newModel("UpgradeLab", hub)
	local o = CF(40, 0, -78)
	local purple = RGB(150, 90, 255)
	Build.block(lab, V3(30, 0.6, 16), o * CF(0, 0.3, 0), RGB(60, 50, 90), M.DiamondPlate)
	Build.block(lab, V3(30, 16, 1), o * CF(0, 8.5, -7.5), RGB(80, 60, 140), M.SmoothPlastic)
	for i = 0, 4 do
		Build.block(lab, V3(0.4, 14, 0.4), o * CF(-12 + i * 6, 8.5, -6.9), RGB(120, 230, 255), M.Neon)
	end
	-- holographic arrow
	local arrow = o * CF(0, 9, -5.5)
	Build.block(lab, V3(2.4, 5, 0.4), arrow * CF(0, -1.5, 0), RGB(90, 255, 140), M.Neon).Transparency = 0.2
	Build.wedge(lab, V3(0.4, 3, 2.6), arrow * CF(1.3, 2.5, 0) * ANG(0, rad(90), 0), RGB(90, 255, 140), M.Neon).Transparency = 0.2
	Build.wedge(lab, V3(0.4, 3, 2.6), arrow * CF(-1.3, 2.5, 0) * ANG(0, rad(-90), 0), RGB(90, 255, 140), M.Neon).Transparency = 0.2
	-- tech consoles
	for _, x in ipairs({ -9, 9 }) do
		local con = o * CF(x, 0, 0)
		Build.block(lab, V3(5, 4, 3), con * CF(0, 2.6, 0), RGB(70, 70, 90), M.Metal)
		Build.wedge(lab, V3(5, 1.6, 3), con * CF(0, 5.4, 0) * ANG(0, math.pi, 0), RGB(70, 70, 90), M.Metal)
		Build.block(lab, V3(4, 0.1, 2), con * CF(0, 5.5, 0.1) * ANG(rad(-28), 0, 0), RGB(120, 230, 255), M.Neon)
		for i = 0, 2 do
			Build.cylY(lab, 0.3, 0.5, con * CF(-1.4 + i * 1.4, 4.7, -1.2), ({ C.Red, C.Yellow, RGB(80, 255, 120) })[i + 1], M.Neon)
		end
	end
	-- counter
	Build.block(lab, V3(12, 4, 3), o * CF(0, 2, 3), purple, M.SmoothPlastic)
	Build.block(lab, V3(12.6, 0.5, 3.6), o * CF(0, 4.25, 3), RGB(230, 230, 250), M.Marble)
	for _, x in ipairs({ -14.4, 14.4 }) do
		Build.block(lab, V3(1, 16, 1), o * CF(x, 8, 5.5), RGB(60, 60, 80), M.Metal)
	end
	Build.block(lab, V3(30, 1, 12), o * CF(0, 16.5, 0), RGB(80, 60, 140), M.Metal)
	collide(lab)
	buildNPC(lab, o * CF(0, 0.6, -1) * ANG(0, math.pi, 0), RGB(240, 240, 255), RGB(150, 90, 255))
	bigSign(lab, o * CF(0, 19, 5) * ANG(0, math.pi, 0), V3(20, 5, 1), "⬆️ UPGRADES", purple)
	local pp = promptPart(lab, o * CF(0, 3, 5), V3(12, 3, 1))
	prompt(pp, "Buy Upgrades", "Upgrade Lab", "Upgrades")
end

local function buildMachineBay(hub: Instance)
	local bay = newModel("MachineBay", hub)
	local slots = {
		{ Id = "AutoWasher", X = -70 },
		{ Id = "MagnetCrane", X = -48 },
		{ Id = "RarityRadar", X = -26 },
		{ Id = "AutoSeller", X = 26 },
		{ Id = "PolishLab", X = 48 },
		{ Id = "Teleporter", X = 70 },
	}
	for _, s in ipairs(slots) do
		local o = CF(s.X, 0.6, 48)
		local pad = newModel("Pad_" .. s.Id, bay)
		Build.block(pad, V3(19, 0.8, 19), o * CF(0, 0, 0), RGB(70, 74, 86), M.DiamondPlate)
		for i = 0, 11 do
			local col = (i % 2 == 0) and RGB(255, 200, 40) or RGB(30, 30, 34)
			Build.block(pad, V3(1.6, 0.85, 0.8), o * CF(-8.8 + i * 1.6, 0.05, -9.4), col, M.SmoothPlastic)
			Build.block(pad, V3(1.6, 0.85, 0.8), o * CF(-8.8 + i * 1.6, 0.05, 9.4), col, M.SmoothPlastic)
		end
		collide(pad)
		local machine = MachineModels.create(s.Id, pad, o * CF(0, 0.4, 2))
		machine.Name = "Machine"
		pad:SetAttribute("MachineId", s.Id)
		local info = Build.part(pad, "Part", {
			Name = "InfoAnchor",
			Size = V3(1, 1, 1),
			CFrame = o * CF(0, 17, 0),
			Transparency = 1,
			CanCollide = false,
			CanQuery = false,
		})
		local _ = info
		local pp = promptPart(pad, o * CF(0, 3, -9), V3(10, 3, 1))
		if s.Id == "Teleporter" then
			prompt(pp, "Teleport", "Zone Teleporter", "Zones")
		else
			local def = Config.Machines[s.Id]
			local p = prompt(pp, "View Machine", def.Name, "Machines")
			p:SetAttribute("MachineId", s.Id)
		end
	end
end

----------------------------------------------------------------------
-- Perimeter, zone walls and gates
----------------------------------------------------------------------
local function buildPerimeter(map: Instance)
	local walls = newModel("Perimeter", map)
	local colors = { RGB(80, 150, 230), RGB(230, 90, 90), RGB(240, 180, 50), RGB(90, 190, 110) }
	local idx = 0
	local function run(a: Vector3, b: Vector3)
		local len = (b - a).Magnitude
		local n = math.ceil(len / 40)
		local dir = (b - a).Unit
		for i = 0, n - 1 do
			idx += 1
			local p0 = a + dir * (i * len / n)
			local p1 = a + dir * ((i + 1) * len / n)
			local mid = (p0 + p1) / 2
			Props.fencePanel(walls, CFrame.lookAt(mid, mid + dir) * ANG(0, rad(90), 0), len / n, 16, colors[(idx % #colors) + 1])
		end
	end
	run(V3(-132, 0, -100), V3(-132, 0, 852))
	run(V3(132, 0, -100), V3(132, 0, 852))
	run(V3(-132, 0, -100), V3(132, 0, -100))
	run(V3(-132, 0, 852), V3(132, 0, 852))
	-- hub side walls (between hub and the outer verge)
	for _, x in ipairs({ -96, 96 }) do
		for z = -86, 60, 24 do
			Props.junkPile(walls, CF(x + rng:NextNumber(-6, 6), 0, z), rng:NextNumber(7, 10))
		end
	end
end

local function buildGate(map: Instance, zoneId: string, z: number)
	local def = Config.Zones[zoneId]
	local gate = newModel("Gate_" .. zoneId, map)
	gate:SetAttribute("ZoneId", zoneId)
	local wallColor = RGB(90, 94, 108)
	-- walls either side
	for _, side in ipairs({ -1, 1 }) do
		local x0, x1 = side * 16, side * 132
		local len = math.abs(x1 - x0)
		local n = math.ceil(len / 38)
		for i = 0, n - 1 do
			local xa = x0 + (x1 - x0) * (i / n)
			local xb = x0 + (x1 - x0) * ((i + 1) / n)
			Props.fencePanel(gate, CF((xa + xb) / 2, 0, z), math.abs(xb - xa), 16, wallColor)
		end
	end
	-- gate frame
	for _, x in ipairs({ -16, 16 }) do
		Build.block(gate, V3(5, 26, 5), CF(x, 13, z), RGB(60, 62, 72), M.Metal)
		Build.block(gate, V3(5.6, 1.2, 5.6), CF(x, 26.4, z), def.Color, M.SmoothPlastic)
		for i = 0, 4 do
			Build.block(gate, V3(5.1, 1, 5.1), CF(x, 3 + i * 5, z) * ANG(0, 0, rad(30)), RGB(255, 200, 40), M.SmoothPlastic)
		end
	end
	Build.block(gate, V3(38, 4, 5), CF(0, 24, z), RGB(60, 62, 72), M.Metal)
	collide(gate)
	local sign = bigSign(gate, CF(0, 30, z) * ANG(0, math.pi, 0), V3(30, 6, 1), def.Emoji .. " " .. string.upper(def.Name), def.Color)
	local _ = sign
	-- energy barrier (client hides it once unlocked)
	local barrier = Build.part(gate, "Part", {
		Name = "Barrier",
		Size = V3(27, 22, 1.4),
		CFrame = CF(0, 11, z),
		Color = def.Color,
		Material = M.ForceField,
		Transparency = 0,
		CanCollide = true,
		CanQuery = true,
	})
	barrier:SetAttribute("ZoneId", zoneId)
	local bb = Instance.new("BillboardGui")
	bb.Name = "PriceTag"
	bb.Size = UDim2.fromScale(16, 6)
	bb.StudsOffset = V3(0, 1, 0)
	bb.LightInfluence = 0
	bb.MaxDistance = 140
	bb.Parent = barrier
	local tl = Instance.new("TextLabel")
	tl.Name = "Label"
	tl.BackgroundTransparency = 1
	tl.Size = UDim2.fromScale(1, 1)
	tl.Font = Enum.Font.FredokaOne
	tl.RichText = true
	tl.Text = string.format('🔒 %s\n<font color="#7CFF8C">%s</font>', def.Name, Format.cash(def.Price))
	tl.TextScaled = true
	tl.TextColor3 = C.White
	tl.Parent = bb
	local st = Instance.new("UIStroke")
	st.Thickness = 4
	st.Color = RGB(20, 20, 30)
	st.Parent = tl
	local gp = prompt(barrier, "Unlock", def.Name .. " (" .. Format.cash(def.Price) .. ")", "Gate")
	gp.Name = "GatePrompt"
	gp:SetAttribute("ZoneId", zoneId)
	gp.MaxActivationDistance = 16
end

----------------------------------------------------------------------
-- Zone decoration
----------------------------------------------------------------------
local function scatter(count: number, zMin: number, zMax: number, fn: (CFrame) -> ())
	for _ = 1, count do
		local x
		repeat
			x = rng:NextNumber(-112, 112)
		until math.abs(x) > 18
		local z = rng:NextNumber(zMin, zMax)
		fn(CF(x, 0, z) * ANG(0, rng:NextNumber(0, math.pi * 2), 0))
	end
end

local function buildJunkyard(map: Instance)
	local zone = newModel("JunkFields", map)
	local def = Config.Zones.Junkyard
	scatter(7, def.ZMin + 10, def.ZMax - 10, function(cf)
		Props.carWreck(zone, cf)
	end)
	scatter(6, def.ZMin + 10, def.ZMax - 10, function(cf)
		Props.tireStack(zone, cf)
	end)
	scatter(10, def.ZMin + 5, def.ZMax - 5, function(cf)
		Props.barrel(zone, cf, nil, false, rng:NextNumber() > 0.6)
	end)
	scatter(6, def.ZMin + 10, def.ZMax - 10, function(cf)
		Props.crate(zone, cf, rng:NextNumber(3, 5))
	end)
	scatter(6, def.ZMin + 10, def.ZMax - 10, function(cf)
		Props.junkPile(zone, cf, rng:NextNumber(6, 10))
	end)
	scatter(10, def.ZMin, def.ZMax, function(cf)
		Props.cone(zone, cf)
	end)
	-- container stacks along the edges
	for _, p in ipairs({ { -100, 120 }, { 100, 170 }, { -100, 230 }, { 100, 100 } }) do
		local base = CF(p[1], 0, p[2]) * ANG(0, rad(90 + rng:NextNumber(-8, 8)), 0)
		Props.container(zone, base)
		Props.container(zone, base * CF(rng:NextNumber(-2, 2), 10, 0) * ANG(0, rad(rng:NextNumber(-6, 6)), 0))
	end
	-- crushed car towers
	for _, p in ipairs({ { -60, 260 }, { 60, 90 }, { 70, 250 } }) do
		for i = 0, 2 do
			Props.crushedCube(zone, CF(p[1], i * 5, p[2]) * ANG(0, rad(rng:NextNumber(-15, 15)), 0))
		end
	end
	Props.crane(zone, CF(-85, 0, 175) * ANG(0, rad(-30), 0))
	for z = def.ZMin + 20, def.ZMax - 10, 45 do
		Props.lamp(zone, CF(-16, 0, z))
		Props.lamp(zone, CF(16, 0, z + 22) * ANG(0, math.pi, 0))
	end
end

local function buildRustCanyon(map: Instance)
	local zone = newModel("RustCanyon", map)
	local def = Config.Zones.RustCanyon
	scatter(6, def.ZMin + 10, def.ZMax - 10, function(cf)
		Props.girders(zone, cf)
	end)
	scatter(5, def.ZMin + 10, def.ZMax - 10, function(cf)
		Props.carWreck(zone, cf, RGB(255, 140, 60))
	end)
	scatter(8, def.ZMin + 5, def.ZMax - 5, function(cf)
		Props.barrel(zone, cf, RGB(255, 120, 40), false, rng:NextNumber() > 0.5)
	end)
	scatter(5, def.ZMin + 10, def.ZMax - 10, function(cf)
		Props.junkPile(zone, cf, rng:NextNumber(6, 9))
	end)
	for _, p in ipairs({ { -95, 330 }, { 95, 380 }, { -95, 420 } }) do
		Props.container(zone, CF(p[1], 0, p[2]) * ANG(0, rad(90), 0) * ANG(0, 0, rad(rng:NextNumber(-3, 3))), RGB(255, 130, 50))
	end
	for z = def.ZMin + 20, def.ZMax - 10, 50 do
		Props.lamp(zone, CF(-16, 0, z), RGB(255, 190, 120))
		Props.lamp(zone, CF(16, 0, z + 25) * ANG(0, math.pi, 0), RGB(255, 190, 120))
	end
end

local function buildToxicWaste(map: Instance)
	local zone = newModel("ToxicWaste", map)
	local def = Config.Zones.ToxicWaste
	scatter(7, def.ZMin + 15, def.ZMax - 15, function(cf)
		Props.toxicPool(zone, cf, rng:NextNumber(6, 11))
	end)
	scatter(14, def.ZMin + 5, def.ZMax - 5, function(cf)
		Props.barrel(zone, cf, RGB(255, 210, 40), true, rng:NextNumber() > 0.5)
	end)
	scatter(9, def.ZMin + 5, def.ZMax - 5, function(cf)
		Props.deadTree(zone, cf)
	end)
	for _, p in ipairs({ { -98, 520 }, { 98, 600 } }) do
		Props.container(zone, CF(p[1], 0, p[2]) * ANG(0, rad(90), 0), RGB(90, 200, 70))
	end
	-- green fog in the wasteland
	local fogPart = Build.part(zone, "Part", {
		Name = "ToxicFog",
		Size = V3(230, 2, 160),
		CFrame = CF(0, 2, (def.ZMin + def.ZMax) / 2),
		Transparency = 1,
		CanCollide = false,
		CanQuery = false,
	})
	local fog = Instance.new("ParticleEmitter")
	fog.Texture = "rbxasset://textures/particles/smoke_main.dds"
	fog.Color = ColorSequence.new(RGB(140, 255, 90))
	fog.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 6), NumberSequenceKeypoint.new(1, 12) })
	fog.Transparency =
		NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.85), NumberSequenceKeypoint.new(1, 1) })
	fog.Lifetime = NumberRange.new(6, 9)
	fog.Rate = 8
	fog.Speed = NumberRange.new(0.5, 1)
	fog.Shape = Enum.ParticleEmitterShape.Box
	fog.Parent = fogPart
	for z = def.ZMin + 20, def.ZMax - 10, 50 do
		Props.lamp(zone, CF(-16, 0, z), RGB(150, 255, 110))
		Props.lamp(zone, CF(16, 0, z + 25) * ANG(0, math.pi, 0), RGB(150, 255, 110))
	end
end

local function buildMeteorCrater(map: Instance)
	local zone = newModel("MeteorCrater", map)
	local def = Config.Zones.MeteorCrater
	local colors = { RGB(255, 90, 200), RGB(150, 110, 255), RGB(80, 220, 255) }
	scatter(14, def.ZMin + 10, def.ZMax - 10, function(cf)
		Props.crystals(zone, cf, colors[rng:NextInteger(1, 3)])
	end)
	-- the meteor itself
	local meteor = newModel("Meteor", zone)
	local center = CF(0, -2, 760)
	local rock = Build.ball(meteor, 22, center, RGB(60, 44, 70), M.Basalt)
	local _ = rock
	for _ = 1, 10 do
		local dir = rng:NextUnitVector()
		local p = center * CF(dir * 10.5)
		Build.block(
			meteor,
			V3(rng:NextNumber(4, 8), 0.5, 0.6),
			CFrame.lookAt(p.Position, p.Position + dir) * ANG(0, 0, rng:NextNumber(0, 3)),
			RGB(255, 90, 200),
			M.Neon
		)
	end
	Build.light(rock, RGB(255, 90, 200), 40, 3)
	collide(meteor)
	for z = def.ZMin + 15, def.ZMax - 10, 50 do
		Props.lamp(zone, CF(-40, 0, z), RGB(200, 140, 255))
		Props.lamp(zone, CF(40, 0, z + 25) * ANG(0, math.pi, 0), RGB(200, 140, 255))
	end
end

----------------------------------------------------------------------
function WorldBuilder.build()
	setupLighting()
	setupTerrain()

	root = folder("Scrapyard", workspace)
	local hub = folder("Hub", root)
	buildPlaza(hub)
	buildCleaningShed(hub)
	buildSellShop(hub)
	buildToolShop(hub)
	buildUpgradeLab(hub)
	buildMachineBay(hub)
	buildArch(hub, 72, "♻️ SCRAPYARD SIMULATOR ♻️", RGB(255, 140, 40))

	buildPerimeter(root)
	buildJunkyard(root)
	buildRustCanyon(root)
	buildToxicWaste(root)
	buildMeteorCrater(root)

	buildGate(root, "RustCanyon", 280)
	buildGate(root, "ToxicWaste", 470)
	buildGate(root, "MeteorCrater", 660)

	for _, id in ipairs(Config.ZoneOrder) do
		local def = Config.Zones[id]
		WorldBuilder.ZoneSpawns[id] = CF(0, 4, def.ZMin + 6)
	end

	local scraps = folder("Scraps", workspace)
	local _ = scraps
	return root
end

return WorldBuilder
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="20">
      <Properties>
        <string name="Name">StatCommands</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- StatCommands: chat commands to set your own Speed and Strength in YOUR game.
-- Put this Script in ServerScriptService.
--
-- Commands (type in chat):
--   /speed <number>      sets your WalkSpeed (default 16)
--   /strength <number>   sets your Strength stat (shown on the leaderboard)
--   /reset               restores defaults
--
-- Other scripts can read strength with: player:GetAttribute("Strength")

local Players = game:GetService("Players")

-- UserIds allowed to use commands. The game creator is always allowed.
-- Leave empty to allow only the creator; set ALLOW_EVERYONE to true for testing.
local ADMINS = {
	-- 12345678,
}
local ALLOW_EVERYONE = false

local DEFAULT_SPEED = 16
local DEFAULT_STRENGTH = 1
local MAX_VALUE = 1e6

local function isAdmin(player)
	if ALLOW_EVERYONE or player.UserId == game.CreatorId then
		return true
	end
	for _, id in ipairs(ADMINS) do
		if id == player.UserId then
			return true
		end
	end
	return false
end

local function applySpeed(player)
	-- Only override WalkSpeed after an admin used /speed; otherwise the game's
	-- Running Shoes upgrade controls speed.
	if not player:GetAttribute("SpeedOverride") then
		return
	end
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = player:GetAttribute("Speed")
	end
end

local function setStrength(player, value)
	player:SetAttribute("Strength", value)
	local strength = player:FindFirstChild("leaderstats") and player.leaderstats:FindFirstChild("Strength")
	if strength then
		strength.Value = value
	end
end

Players.PlayerAdded:Connect(function(player)
	-- Share the leaderstats folder with the game's DataService (Cash / Scraps).
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		leaderstats.Parent = player
	end

	local strength = Instance.new("NumberValue")
	strength.Name = "Strength"
	strength.Parent = leaderstats

	player:SetAttribute("Speed", DEFAULT_SPEED)
	setStrength(player, DEFAULT_STRENGTH)

	player.CharacterAdded:Connect(function(character)
		character:WaitForChild("Humanoid")
		applySpeed(player)
	end)

	player.Chatted:Connect(function(message)
		if not isAdmin(player) then
			return
		end

		local command, arg = message:lower():match("^/(%a+)%s*(%S*)")
		local value = tonumber(arg)
		if value then
			value = math.clamp(value, 0, MAX_VALUE)
		end

		if command == "speed" and value then
			player:SetAttribute("Speed", value)
			player:SetAttribute("SpeedOverride", true)
			applySpeed(player)
		elseif command == "strength" and value then
			setStrength(player, value)
		elseif command == "reset" then
			player:SetAttribute("Speed", DEFAULT_SPEED)
			player:SetAttribute("SpeedOverride", nil)
			applySpeed(player)
			setStrength(player, DEFAULT_STRENGTH)
		end
	end)
end)
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="21">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="22">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="23">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Scrapyard Simulator — client entry point.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local remotes = ReplicatedStorage:WaitForChild("Remotes")
local actionRemote = remotes:WaitForChild("Action") :: RemoteFunction

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local State = require(script.State)
local UIKit = require(script.UIKit)
local Sound = require(script.Sound)
local Notify = require(script.Notify)
local HUD = require(script.HUD)
local Panels = require(script.Panels)
local CleaningGame = require(script.CleaningGame)
local ToolController = require(script.ToolController)
local WorldFX = require(script.WorldFX)

-- Screen -------------------------------------------------------------
local screen = Instance.new("ScreenGui")
screen.Name = "ScrapyardUI"
screen.ResetOnSpawn = false
screen.IgnoreGuiInset = true
screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screen.Parent = player:WaitForChild("PlayerGui")

-- scale the whole UI with the screen size (phones -> big monitors)
local uiScale = Instance.new("UIScale")
uiScale.Parent = screen
local function rescale()
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local size = cam.ViewportSize
	uiScale.Scale = math.clamp(math.min(size.X / 1280, size.Y / 760), 0.5, 1.25)
end
rescale()
Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(rescale)

pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, true)
end)

-- Requests -----------------------------------------------------------
local function request(name: string, a: any?, b: any?): (boolean, any)
	local ok, result, extra = pcall(function()
		return actionRemote:InvokeServer(name, a, b)
	end)
	if not ok then
		return false, "Connection problem, try again"
	end
	return result == true, extra
end

-- Modules ------------------------------------------------------------
Notify.init(screen)
CleaningGame.init(screen, request)
Panels.init(screen, request, function(session, station)
	CleaningGame.start(session, station)
end)
HUD.init(screen, function(name, ctx)
	if CleaningGame.Active then
		return
	end
	Panels.open(name, ctx)
end, request)
ToolController.init(remotes, function()
	return CleaningGame.Active or Panels.isOpen()
end)
WorldFX.init(function(name, ctx)
	if CleaningGame.Active then
		return
	end
	Panels.open(name, ctx)
end)

-- Server events -------------------------------------------------------
local lastCash: number? = nil
local lastWeakToast = 0
remotes:WaitForChild("State").OnClientEvent:Connect(function(data)
	State.set(data)
	lastCash = data.Cash
end)

remotes:WaitForChild("Notify").OnClientEvent:Connect(function(text, kind)
	Notify.toast(text, kind)
end)

remotes:WaitForChild("Open").OnClientEvent:Connect(function(name, ctx)
	if name == "CloseCleaning" then
		CleaningGame.close()
		return
	end
	if CleaningGame.Active then
		return
	end
	Panels.open(name, ctx)
end)

remotes:WaitForChild("FX").OnClientEvent:Connect(function(payload)
	local kind = payload.Kind
	WorldFX.onFX(payload)
	if kind == "Collect" then
		local rarity = Config.Rarities[payload.Rarity]
		if rarity and rarity.Order >= 3 then
			Sound.play("Rare")
		else
			Sound.play("Collect", 0.9 + math.random() * 0.3)
		end
		Notify.item(payload.ScrapId, payload.Amount, {
			Lucky = payload.Lucky,
			New = payload.New,
			Sub = payload.Source == "Crane" and "🧲 MAGNET CRANE" or nil,
		})
		if payload.New then
			Notify.toast("✨ New scrap discovered: " .. Config.Scraps[payload.ScrapId].Name .. "!", payload.Rarity)
		end
	elseif kind == "Sell" then
		Notify.cash(payload.Amount)
		if payload.Source == "AutoSeller" then
			Notify.toast(string.format("🏭 Conveyor sold %d scrap for %s", payload.Count, Format.cash(payload.Amount)), "success")
		else
			Notify.banner("SOLD!", string.format("%d scrap for %s", payload.Count, Format.cash(payload.Amount)), UIKit.Colors.Green)
		end
	elseif kind == "Purchase" then
		Sound.play("Purchase")
		Notify.toast("✅ " .. payload.Text, "success")
	elseif kind == "ZoneUnlocked" then
		Sound.play("Purchase")
	elseif kind == "Machine" then
		Notify.toast(payload.Text, "info")
	elseif kind == "BackpackFull" then
		HUD.backpackFull()
	elseif kind == "TooWeak" then
		if os.clock() - lastWeakToast > 4 then
			lastWeakToast = os.clock()
			Notify.toast("This scrap is too tough! Buy a stronger tool. 🔧", "error")
		end
	end
end)

local _ = lastCash
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">CleaningGame</string>
            <string name="Source"><![CDATA[-- CleaningGame: the interactive scrubbing minigame at the wash stations.
--
-- The scrap sits in a tub covered in stains. Hold the mouse (or finger) and
-- scrub over each stain with the matching tool:
--   🧽 Sponge  -> Mud      🪥 Wire Brush -> Rust      💦 Power Spray -> Grease
-- The wrong tool barely works. As stains come off, the 3D model gradually
-- turns from rusty to shiny. Finish fast for up to 3 stars (more money).

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local ScrapModels = require(ReplicatedStorage.Shared.ScrapModels)
local UIKit = require(script.Parent.UIKit)
local Sound = require(script.Parent.Sound)
local Notify = require(script.Parent.Notify)

local CleaningGame = {}
CleaningGame.Active = false

local player = Players.LocalPlayer
local gui: ScreenGui
local request: (string, any?, any?) -> (boolean, any)

local root: Frame? = nil
local connections: { RBXScriptConnection } = {}
local controls: any = nil

local C = UIKit.Colors
local BRUSH_RADIUS = 34

local function getControls()
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local module = player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 5)
		return require(module :: ModuleScript):GetControls()
	end)
	if ok then
		controls = result
	end
	return controls
end

local function disconnectAll()
	for _, c in ipairs(connections) do
		c:Disconnect()
	end
	table.clear(connections)
end

function CleaningGame.close()
	disconnectAll()
	CleaningGame.Active = false
	local c = getControls()
	if c then
		c:Enable()
	end
	if root then
		local r = root
		root = nil
		local s = r:FindFirstChild("BounceScale") :: UIScale?
		if s then
			TweenService:Create(s, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0.6 }):Play()
		end
		TweenService:Create(r, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
		task.delay(0.2, function()
			r:Destroy()
		end)
	end
end

-- Irregular stain made of a few overlapping blobs.
local function makeStain(parent: Frame, spot, dirt): Frame
	local f = UIKit.new("Frame", {
		Name = "Stain",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(spot.X, spot.Y),
		Size = UDim2.fromScale(spot.Size, spot.Size),
		Rotation = spot.Rot,
		ZIndex = 86,
		Parent = parent,
	})
	UIKit.new("UIAspectRatioConstraint", { AspectRatio = 1, DominantAxis = Enum.DominantAxis.Width, Parent = f })
	local blobs = {
		{ 0.5, 0.5, 1.0 },
		{ 0.22, 0.35, 0.55 },
		{ 0.8, 0.3, 0.45 },
		{ 0.72, 0.78, 0.55 },
		{ 0.25, 0.75, 0.42 },
	}
	for i, b in ipairs(blobs) do
		local blob = UIKit.new("Frame", {
			Name = "Blob",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(b[1], b[2]),
			Size = UDim2.fromScale(b[3], b[3]),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 86,
			Parent = f,
		})
		UIKit.round(blob)
		UIKit.gradient(blob, dirt.Color, dirt.Color2, 45 + i * 30)
		if i == 1 then
			UIKit.stroke(blob, 2, UIKit.darken(dirt.Color2, 0.3), true).Transparency = 0.3
		end
	end
	-- specks / texture
	for _ = 1, 4 do
		local speck = UIKit.new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(math.random(25, 75) / 100, math.random(25, 75) / 100),
			Size = UDim2.fromScale(0.12, 0.12),
			BackgroundColor3 = UIKit.lighten(dirt.Color, 0.25),
			BackgroundTransparency = 0.3,
			ZIndex = 87,
			Parent = f,
		})
		UIKit.round(speck)
	end
	return f
end

local function setStainAlpha(stain: Frame, alpha: number)
	for _, d in ipairs(stain:GetDescendants()) do
		if d:IsA("Frame") then
			d.BackgroundTransparency = (d.Name == "Blob") and alpha or math.max(alpha, 0.3)
		end
	end
end

local function spawnBubble(layer: Frame, pos: Vector2, color: Color3?)
	local size = math.random(10, 26)
	local b = UIKit.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(pos.X, pos.Y),
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color or Color3.fromRGB(235, 250, 255),
		BackgroundTransparency = 0.35,
		ZIndex = 90,
		Parent = layer,
	})
	UIKit.round(b)
	UIKit.stroke(b, 1.5, Color3.fromRGB(150, 210, 255), true)
	local drift = Vector2.new(math.random(-40, 40), math.random(-70, -20))
	local tw = TweenService:Create(b, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.fromOffset(pos.X + drift.X, pos.Y + drift.Y),
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(size * 1.4, size * 1.4),
	})
	tw:Play()
	local st = b:FindFirstChildOfClass("UIStroke")
	if st then
		TweenService:Create(st, TweenInfo.new(0.7), { Transparency = 1 }):Play()
	end
	task.delay(0.72, function()
		b:Destroy()
	end)
end

local function sparkleBurst(layer: Frame, center: Vector2, count: number, color: Color3?)
	for _ = 1, count do
		local s = UIKit.label(layer, {
			Text = "✦",
			Font = Enum.Font.GothamBold,
			Size = UDim2.fromOffset(28, 28),
			Position = UDim2.fromOffset(center.X, center.Y),
			AnchorPoint = Vector2.new(0.5, 0.5),
			TextColor3 = color or Color3.fromRGB(255, 240, 120),
			ZIndex = 95,
			StrokeThickness = 0,
		})
		local a = math.random() * math.pi * 2
		local d = math.random(60, 180)
		TweenService:Create(s, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.fromOffset(center.X + math.cos(a) * d, center.Y + math.sin(a) * d),
			TextTransparency = 1,
			Rotation = math.random(-180, 180),
		}):Play()
		task.delay(0.62, function()
			s:Destroy()
		end)
	end
end

----------------------------------------------------------------------
function CleaningGame.start(session, stationIndex: number)
	if root then
		CleaningGame.close()
	end
	CleaningGame.Active = true
	local c = getControls()
	if c then
		c:Disable()
	end
	local def = Config.Scraps[session.ScrapId]
	local rarity = Config.Rarities[def.Rarity]

	-- backdrop
	local r = UIKit.new("Frame", {
		Name = "Cleaning",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(10, 30, 60),
		BackgroundTransparency = 0.35,
		Active = true,
		ZIndex = 80,
		Parent = gui,
	})
	root = r
	UIKit.new("UIGradient", {
		Color = ColorSequence.new(Color3.fromRGB(40, 120, 220), Color3.fromRGB(10, 20, 60)),
		Rotation = 90,
		Parent = r,
	})

	local main = UIKit.new("Frame", {
		Name = "Main",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(900, 600),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 81,
		Parent = r,
	})
	UIKit.pop(main, 0.7)

	-- title
	UIKit.label(main, {
		Text = "🫧 WASH STATION " .. stationIndex,
		Size = UDim2.new(0, 520, 0, 44),
		Position = UDim2.fromOffset(0, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 82,
		StrokeThickness = 4,
	})
	UIKit.label(main, {
		Text = string.format("%s  x%d", def.Name, session.Count),
		Size = UDim2.new(0, 420, 0, 30),
		Position = UDim2.fromOffset(2, 44),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = rarity.Color,
		ZIndex = 82,
		StrokeThickness = 3,
	})
	UIKit.rarityChip(main, rarity, { Position = UDim2.fromOffset(4, 80), Size = UDim2.fromOffset(110, 24), ZIndex = 82 })

	-- progress + timer
	local progBack, progFill = UIKit.bar(main, {
		Size = UDim2.fromOffset(340, 30),
		Position = UDim2.new(1, -150, 0, 14),
		AnchorPoint = Vector2.new(1, 0),
		Color = C.Green,
		ZIndex = 82,
	})
	local progText = UIKit.label(progBack, {
		Text = "CLEAN 0%",
		Size = UDim2.new(1, 0, 1, -4),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 85,
		StrokeThickness = 2,
	})
	local timerText = UIKit.label(main, {
		Text = "⏱ 0.0s",
		Size = UDim2.fromOffset(200, 28),
		Position = UDim2.new(1, -150, 0, 52),
		AnchorPoint = Vector2.new(1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 82,
		StrokeThickness = 2.5,
	})
	local starsText = UIKit.label(main, {
		Text = string.format("★★★ under %.0fs", session.ParTime),
		Size = UDim2.fromOffset(240, 24),
		Position = UDim2.new(1, -150, 0, 82),
		AnchorPoint = Vector2.new(1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = C.Yellow,
		ZIndex = 82,
		StrokeThickness = 2,
	})

	-- cancel
	UIKit.button(main, {
		Text = "✕",
		Color = C.Red,
		Size = UDim2.fromOffset(60, 60),
		Position = UDim2.new(1, 0, 0, 10),
		AnchorPoint = Vector2.new(1, 0),
		Radius = 30,
		ZIndex = 84,
		OnClick = function()
			request("CancelCleaning")
			CleaningGame.close()
		end,
	})

	-- the tub
	local tub = UIKit.new("Frame", {
		Name = "Tub",
		Size = UDim2.fromOffset(600, 430),
		Position = UDim2.fromOffset(0, 120),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClipsDescendants = true,
		Active = true,
		ZIndex = 83,
		Parent = main,
	})
	UIKit.corner(tub, 28)
	UIKit.gradient(tub, Color3.fromRGB(150, 225, 255), Color3.fromRGB(40, 130, 230))
	UIKit.stroke(tub, 6, C.Outline, true)
	-- water caustic stripes
	local caustics = UIKit.new(
		"Frame",
		{ BackgroundTransparency = 1, Size = UDim2.fromScale(1.6, 1.6), Position = UDim2.fromScale(-0.3, -0.3), ZIndex = 83, Parent = tub }
	)
	for i = 0, 9 do
		local stripe = UIKit.new("Frame", {
			Size = UDim2.new(0, 30, 1, 0),
			Position = UDim2.fromScale(i / 10, 0),
			Rotation = 30,
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 0.88,
			BorderSizePixel = 0,
			ZIndex = 83,
			Parent = caustics,
		})
		UIKit.round(stripe)
	end
	-- rim
	local rim = UIKit.new("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 89, Parent = tub })
	UIKit.corner(rim, 28)
	UIKit.stroke(rim, 10, Color3.fromRGB(240, 248, 255), true).Transparency = 0.2

	-- 3D scrap (dirty) + clean reference colours for the gradual reveal
	local dirtyModel = ScrapModels.create(session.ScrapId, false)
	local cleanModel = ScrapModels.create(session.ScrapId, true)
	local dirtyParts, cleanParts = {}, {}
	for _, d in ipairs(dirtyModel:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(dirtyParts, d)
		end
	end
	for _, d in ipairs(cleanModel:GetDescendants()) do
		if d:IsA("BasePart") then
			table.insert(cleanParts, d)
		end
	end
	local startColors = {}
	for i, p in ipairs(dirtyParts) do
		startColors[i] = p.Color
	end
	local vpf = UIKit.viewport(
		tub,
		dirtyModel,
		{ ZIndex = 84, Spin = true, SpinSpeed = 0.35, Zoom = 1.0, Size = UDim2.fromScale(0.9, 0.9), Position = UDim2.fromScale(0.05, 0.05) }
	)
	vpf.Ambient = Color3.fromRGB(190, 200, 220)

	-- stains
	local dirtLayer =
		UIKit.new("Frame", { Name = "Dirt", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 86, Parent = tub })
	local fxLayer = UIKit.new("Frame", { Name = "FX", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 90, Parent = tub })
	local stains = {}
	local totalHP = 0
	for i, spot in ipairs(session.Spots) do
		local dirt = Config.Cleaning.DirtTypes[spot.Type]
		local frame = makeStain(dirtLayer, spot, dirt)
		frame.ZIndex = 86 + (i % 3)
		stains[i] = { Spot = spot, Dirt = dirt, Frame = frame, HP = spot.HP, MaxHP = spot.HP }
		totalHP += spot.HP
		UIKit.pop(frame, 0.2)
	end

	-- tool palette
	local palette = UIKit.new("Frame", {
		Name = "Palette",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(270, 430),
		Position = UDim2.new(1, 0, 0, 120),
		AnchorPoint = Vector2.new(1, 0),
		ZIndex = 82,
		Parent = main,
	})
	UIKit.new("UIListLayout", { Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = palette })
	local selected = 1
	local toolButtons = {}
	local function selectTool(index: number)
		selected = index
		for i, b in ipairs(toolButtons) do
			local st = b:FindFirstChild("Select") :: UIStroke
			st.Enabled = i == index
			if i == index then
				UIKit.bump(b, 1.08)
			end
		end
		Sound.play("Click")
	end
	for i, tool in ipairs(Config.Cleaning.Tools) do
		local dirt = Config.Cleaning.DirtTypes[i]
		local b = UIKit.button(palette, {
			Text = "",
			Color = tool.Color,
			Size = UDim2.fromOffset(260, 120),
			LayoutOrder = i,
			ZIndex = 83,
			OnClick = function()
				selectTool(i)
			end,
		})
		local sel = UIKit.new("UIStroke", {
			Name = "Select",
			Thickness = 6,
			Color = Color3.fromRGB(255, 255, 255),
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
			Enabled = false,
			Parent = b,
		})
		local _ = sel
		UIKit.label(b, {
			Text = tool.Emoji,
			Font = Enum.Font.GothamBold,
			Size = UDim2.fromOffset(72, 72),
			Position = UDim2.fromOffset(14, 24),
			ZIndex = 86,
			StrokeThickness = 0,
		})
		UIKit.label(b, {
			Text = tool.Name,
			Size = UDim2.new(1, -110, 0, 34),
			Position = UDim2.fromOffset(96, 24),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 86,
			StrokeThickness = 2.5,
		})
		local legend = UIKit.new("Frame", {
			BackgroundColor3 = Color3.new(1, 1, 1),
			Size = UDim2.fromOffset(130, 30),
			Position = UDim2.fromOffset(96, 64),
			ZIndex = 86,
			Parent = b,
		})
		UIKit.round(legend)
		UIKit.gradient(legend, dirt.Color, dirt.Color2, 0)
		UIKit.stroke(legend, 2, C.Outline, true)
		UIKit.label(legend, {
			Text = "cleans " .. dirt.Name,
			Size = UDim2.new(1, -10, 1, -6),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 87,
			StrokeThickness = 1.5,
		})
		UIKit.label(b, {
			Text = tostring(i),
			Size = UDim2.fromOffset(30, 30),
			Position = UDim2.new(1, -10, 0, 8),
			AnchorPoint = Vector2.new(1, 0),
			ZIndex = 86,
			StrokeThickness = 2,
			TextColor3 = C.Yellow,
		})
		toolButtons[i] = b
		local _ = legend
	end
	selectTool(1)

	-- hint + cursor
	local hint = UIKit.label(main, {
		Text = "Hold & scrub over the stains! Match the tool to the stain.",
		Size = UDim2.new(0, 600, 0, 28),
		Position = UDim2.fromOffset(0, 560),
		ZIndex = 82,
		StrokeThickness = 2.5,
	})
	local cursor = UIKit.label(r, {
		Text = Config.Cleaning.Tools[1].Emoji,
		Font = Enum.Font.GothamBold,
		Size = UDim2.fromOffset(64, 64),
		AnchorPoint = Vector2.new(0.3, 0.3),
		ZIndex = 99,
		StrokeThickness = 0,
		Visible = false,
	})
	local ring = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(BRUSH_RADIUS * 2, BRUSH_RADIUS * 2),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 98,
		Visible = false,
		Parent = r,
	})
	UIKit.round(ring)
	UIKit.stroke(ring, 2.5, Color3.new(1, 1, 1), true).Transparency = 0.3

	-- state
	local scrubbing = false
	local pointer = Vector2.new()
	local lastMove = 0
	local lastPointer = Vector2.new()
	local started = os.clock()
	local finished = false
	local lastScrubSound = 0
	local lastWrongHint = 0
	local lastBubble = 0
	local remaining = totalHP

	local function inTub(p: Vector2): boolean
		local pos, size = tub.AbsolutePosition, tub.AbsoluteSize
		return p.X >= pos.X and p.Y >= pos.Y and p.X <= pos.X + size.X and p.Y <= pos.Y + size.Y
	end

	local function updateReveal(progress: number)
		for i, p in ipairs(dirtyParts) do
			local target = cleanParts[i]
			if target then
				p.Color = startColors[i]:Lerp(target.Color, progress)
			end
		end
		progFill.Size = UDim2.fromScale(progress, 1)
		progText.Text = string.format("CLEAN %d%%", math.floor(progress * 100))
	end

	local function finish()
		if finished then
			return
		end
		finished = true
		scrubbing = false
		local elapsed = os.clock() - started
		-- fully clean the model
		for i, p in ipairs(dirtyParts) do
			local target = cleanParts[i]
			if target then
				p.Color = target.Color
				p.Material = target.Material
				p.Reflectance = target.Reflectance
				p.Transparency = target.Transparency
			end
		end
		updateReveal(1)
		Sound.play("Sparkle")
		local center = tub.AbsoluteSize / 2
		sparkleBurst(fxLayer, center, 26)
		local shine = UIKit.label(tub, {
			Text = "SPARKLING CLEAN!",
			Size = UDim2.fromOffset(520, 70),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			TextColor3 = Color3.fromRGB(255, 250, 200),
			ZIndex = 96,
			StrokeThickness = 5,
		})
		UIKit.gradient(shine, Color3.fromRGB(255, 255, 255), C.Yellow, 90)
		UIKit.pop(shine, 0.3)
		hint.Text = "Polishing..."
		task.wait(0.9)
		shine:Destroy()

		local ok, result = request("FinishCleaning", session.Id)
		if not root or root ~= r then
			return
		end
		if not ok then
			Notify.toast(result or "Wash failed", "error")
			CleaningGame.close()
			return
		end

		-- result card
		local card = UIKit.new("Frame", {
			Name = "Result",
			Size = UDim2.fromOffset(460, 330),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 100,
			Parent = r,
		})
		UIKit.corner(card, 26)
		UIKit.gradient(card, Color3.fromRGB(255, 255, 255), Color3.fromRGB(210, 235, 255))
		UIKit.stroke(card, 6, C.Outline, true)
		UIKit.pop(card, 0.5)
		UIKit.label(card, {
			Text = "WASH COMPLETE!",
			Size = UDim2.new(1, -40, 0, 50),
			Position = UDim2.fromOffset(20, 16),
			TextColor3 = C.Blue,
			ZIndex = 101,
			StrokeThickness = 3.5,
		})
		local starHolder = UIKit.new("Frame", {
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(300, 90),
			Position = UDim2.new(0.5, 0, 0, 70),
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 101,
			Parent = card,
		})
		local starLabels = {}
		for i = 1, 3 do
			local s = UIKit.label(starHolder, {
				Text = "★",
				Font = Enum.Font.GothamBold,
				Size = UDim2.fromOffset(86, 86),
				Position = UDim2.fromOffset((i - 1) * 104, i == 2 and 0 or 8),
				TextColor3 = Color3.fromRGB(200, 205, 220),
				ZIndex = 102,
				StrokeThickness = 4,
			})
			starLabels[i] = s
		end
		UIKit.label(card, {
			Text = string.format("+%d Clean %s", result.Count, def.Name),
			Size = UDim2.new(1, -40, 0, 32),
			Position = UDim2.fromOffset(20, 168),
			TextColor3 = C.DarkText,
			ZIndex = 101,
			StrokeThickness = 0,
		})
		UIKit.label(card, {
			Text = "Worth " .. Format.cash(result.Value),
			Size = UDim2.new(1, -40, 0, 34),
			Position = UDim2.fromOffset(20, 202),
			TextColor3 = Color3.fromRGB(40, 190, 80),
			ZIndex = 101,
			StrokeThickness = 2.5,
		})
		UIKit.label(card, {
			Text = string.format("Time: %.1fs", elapsed),
			Size = UDim2.new(1, -40, 0, 22),
			Position = UDim2.fromOffset(20, 236),
			TextColor3 = C.Grey,
			Font = UIKit.BodyFont,
			ZIndex = 101,
			StrokeThickness = 0,
		})
		UIKit.button(card, {
			Text = "CONTINUE",
			Color = C.Green,
			Size = UDim2.fromOffset(220, 50),
			Position = UDim2.new(0.5, 0, 1, -14),
			AnchorPoint = Vector2.new(0.5, 1),
			ZIndex = 103,
			OnClick = function()
				CleaningGame.close()
			end,
		})
		task.spawn(function()
			for i = 1, result.Stars do
				task.wait(0.28)
				local s = starLabels[i]
				s.TextColor3 = C.Yellow
				UIKit.pop(s, 0.2)
				Sound.play("Sparkle", 0.8 + i * 0.15)
				sparkleBurst(card, Vector2.new(80 + (i - 1) * 104 + 43, 113), 8)
			end
		end)
		Notify.item(session.ScrapId, result.Count, { Clean = true, Sub = string.rep("★", result.Stars) .. " CLEANED" })
	end

	-- input ------------------------------------------------------------
	table.insert(
		connections,
		UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				local p = Vector2.new(input.Position.X, input.Position.Y)
				if inTub(p) and not finished then
					scrubbing = true
					pointer = p
					lastPointer = p
					lastMove = os.clock()
				end
			elseif input.UserInputType == Enum.UserInputType.Keyboard then
				if input.KeyCode == Enum.KeyCode.One then
					selectTool(1)
				elseif input.KeyCode == Enum.KeyCode.Two then
					selectTool(2)
				elseif input.KeyCode == Enum.KeyCode.Three then
					selectTool(3)
				end
			end
		end)
	)
	table.insert(
		connections,
		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				scrubbing = false
			end
		end)
	)
	table.insert(
		connections,
		UserInputService.InputChanged:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				local p = Vector2.new(input.Position.X, input.Position.Y)
				if (p - pointer).Magnitude > 1.5 then
					lastMove = os.clock()
				end
				pointer = p
			end
		end)
	)

	-- main loop ----------------------------------------------------------
	local inset = game:GetService("GuiService"):GetGuiInset()
	local wiggle = 0
	table.insert(
		connections,
		RunService.RenderStepped:Connect(function(dt)
			if finished then
				cursor.Visible = false
				ring.Visible = false
				return
			end
			local elapsed = os.clock() - started
			timerText.Text = string.format("⏱ %.1fs", elapsed)
			if elapsed > session.ParTime * 1.8 then
				starsText.Text = "★☆☆"
				starsText.TextColor3 = C.Grey
			elseif elapsed > session.ParTime then
				starsText.Text = string.format("★★☆ under %.0fs", session.ParTime * 1.8)
				starsText.TextColor3 = C.Orange
			end
			caustics.Position = UDim2.fromScale(-0.3 + math.sin(elapsed * 0.6) * 0.05, -0.3 + math.cos(elapsed * 0.4) * 0.05)

			-- cursor (screen position includes the top-bar inset; GUI coordinates do not)
			local mouse = UserInputService:GetMouseLocation() - inset
			local p = UserInputService.TouchEnabled and scrubbing and pointer or mouse
			local over = inTub(p)
			cursor.Visible = over
			ring.Visible = over
			cursor.Text = Config.Cleaning.Tools[selected].Emoji
			local rootPos = r.AbsolutePosition
			if scrubbing and os.clock() - lastMove < 0.12 then
				wiggle += dt * 30
			end
			cursor.Position = UDim2.fromOffset(p.X - rootPos.X, p.Y - rootPos.Y)
			cursor.Rotation = math.sin(wiggle) * 18
			ring.Position = UDim2.fromOffset(p.X - rootPos.X, p.Y - rootPos.Y)

			if not scrubbing or not over then
				return
			end
			local moving = os.clock() - lastMove < 0.12
			if not moving then
				return
			end
			local tubPos = tub.AbsolutePosition
			local local_ = p - tubPos
			-- bubbles while scrubbing
			if os.clock() - lastBubble > 0.05 then
				lastBubble = os.clock()
				spawnBubble(fxLayer, local_)
			end
			local scrubbedDirt = false
			for _, s in ipairs(stains) do
				if s.HP > 0 then
					local f = s.Frame
					local center = f.AbsolutePosition + f.AbsoluteSize / 2
					local radius = f.AbsoluteSize.X * 0.5
					if (center - p).Magnitude <= radius + BRUSH_RADIUS then
						local correct = Config.Cleaning.Tools[selected].Id == s.Dirt.Tool
						local mult = correct and 1 or Config.Cleaning.WrongToolMultiplier
						local dmg = session.ScrubRate * mult * dt
						s.HP -= dmg
						remaining -= math.min(dmg, s.HP + dmg)
						scrubbedDirt = true
						if not correct and os.clock() - lastWrongHint > 1.6 then
							lastWrongHint = os.clock()
							local need
							for _, t in ipairs(Config.Cleaning.Tools) do
								if t.Id == s.Dirt.Tool then
									need = t
								end
							end
							if need then
								hint.Text = string.format("%s needs the %s %s!", s.Dirt.Name, need.Emoji, need.Name)
								hint.TextColor3 = C.Orange
								UIKit.bump(hint, 1.1)
								UIKit.shake(f)
							end
						end
						local frac = math.clamp(s.HP / s.MaxHP, 0, 1)
						setStainAlpha(f, 1 - (0.25 + frac * 0.75))
						f.Size = UDim2.fromScale(s.Spot.Size * (0.55 + frac * 0.45), s.Spot.Size * (0.55 + frac * 0.45))
						if s.HP <= 0 then
							local burstAt = center - tubPos
							sparkleBurst(fxLayer, burstAt, 6, Color3.fromRGB(200, 240, 255))
							for _ = 1, 4 do
								spawnBubble(fxLayer, burstAt + Vector2.new(math.random(-20, 20), math.random(-20, 20)))
							end
							Sound.play("Collect", 1.4 + math.random() * 0.4)
							local tw = TweenService:Create(f, TweenInfo.new(0.2), { Size = UDim2.fromScale(0, 0) })
							tw:Play()
							task.delay(0.2, function()
								f:Destroy()
							end)
						end
					end
				end
			end
			if scrubbedDirt and os.clock() - lastScrubSound > 0.22 then
				lastScrubSound = os.clock()
				Sound.play("Scrub", 0.9 + math.random() * 0.3)
			end
			local progress = math.clamp(1 - remaining / totalHP, 0, 1)
			updateReveal(progress)
			local allClean = true
			for _, s in ipairs(stains) do
				if s.HP > 0 then
					allClean = false
					break
				end
			end
			if allClean then
				task.spawn(finish)
			end
			local _ = lastPointer
		end)
	)
end

function CleaningGame.init(screen: ScreenGui, requestFn)
	gui = screen
	request = requestFn
end

return CleaningGame
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[-- HUD: cash + backpack counters, the side menu, the goal tracker and the
-- zone banner.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Notify = require(script.Parent.Notify)

local HUD = {}

local player = Players.LocalPlayer
local cashText: TextLabel
local cashPill: Frame
local bagText: TextLabel
local bagPill: Frame
local bagFill: Frame
local goalFrame: Frame
local goalText: TextLabel
local goalSub: TextLabel
local goalFill: Frame
local zoneBanner: TextLabel
local badges: { [string]: Frame } = {}
local displayedCash = 0
local cashValue: NumberValue
local openPanel: (string, any?) -> ()
local requestAction: (string, any?) -> (boolean, any)

HUD.CurrentGoal = nil :: any

----------------------------------------------------------------------
-- Goals (light tutorial / progression tracker)
----------------------------------------------------------------------
local GOALS = {
	{
		Text = "Collect 5 scraps in the yard",
		Target = "Scrap",
		Progress = function(d)
			return d.ScrapsCollected, 5
		end,
	},
	{
		Text = "Wash scrap at a Wash Station",
		Target = "Wash",
		Progress = function(d)
			return d.ItemsCleaned, 1
		end,
	},
	{
		Text = "Sell clean scrap at the Scrap Exchange",
		Target = "Sell",
		Progress = function(d)
			return math.min(d.TotalEarned, 1), 1
		end,
	},
	{
		Text = "Buy the Steel Crowbar",
		Target = "Tools",
		Progress = function(d)
			return d.Tools.SteelCrowbar and 1 or 0, 1
		end,
	},
	{
		Text = "Unlock Rust Canyon",
		Target = "Gate_RustCanyon",
		Progress = function(d)
			return d.Zones.RustCanyon and 1 or 0, 1
		end,
	},
	{
		Text = "Build an Auto Washer",
		Target = "Pad_AutoWasher",
		Progress = function(d)
			return math.min(d.Machines.AutoWasher or 0, 1), 1
		end,
	},
	{
		Text = "Buy the Magnet Wand",
		Target = "Tools",
		Progress = function(d)
			return d.Tools.MagnetWand and 1 or 0, 1
		end,
	},
	{
		Text = "Unlock the Toxic Wasteland",
		Target = "Gate_ToxicWaste",
		Progress = function(d)
			return d.Zones.ToxicWaste and 1 or 0, 1
		end,
	},
	{
		Text = "Buy the Hydraulic Claw",
		Target = "Tools",
		Progress = function(d)
			return d.Tools.HydraulicClaw and 1 or 0, 1
		end,
	},
	{
		Text = "Unlock the Meteor Crater",
		Target = "Gate_MeteorCrater",
		Progress = function(d)
			return d.Zones.MeteorCrater and 1 or 0, 1
		end,
	},
	{
		Text = "Discover every scrap",
		Target = nil,
		Progress = function(d)
			local n = 0
			for _ in pairs(d.Discovered) do
				n += 1
			end
			local total = 0
			for _ in pairs(Config.Scraps) do
				total += 1
			end
			return n, total
		end,
	},
}

local function currentGoal(d)
	for i, g in ipairs(GOALS) do
		local have, need = g.Progress(d)
		if have < need then
			return i, g, have, need
		end
	end
	return nil
end

----------------------------------------------------------------------
local function menuButton(parent: Instance, key: string, label: string, color: Color3, order: number, panel: string)
	local holder = UIKit.new("Frame", {
		Name = key,
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(84, 98),
		LayoutOrder = order,
		Parent = parent,
	})
	local btn = UIKit.button(holder, {
		Color = color,
		Size = UDim2.fromOffset(78, 78),
		Position = UDim2.fromScale(0.5, 0),
		AnchorPoint = Vector2.new(0.5, 0),
		Radius = 20,
		StrokeThickness = 3.5,
		OnClick = function()
			if panel == "Hub" then
				local ok, err = requestAction("Teleport", "Hub")
				if not ok and err then
					Notify.toast(err, "error")
				end
			else
				openPanel(panel)
			end
		end,
	})
	local iconBox = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.new(1, -14, 1, -14),
		Position = UDim2.fromScale(0.5, 0.48),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 4,
		Parent = btn,
	})
	UIKit.icon(iconBox, key, { ZIndex = 4 })
	UIKit.label(holder, {
		Text = label,
		Size = UDim2.new(1, 8, 0, 22),
		Position = UDim2.new(0.5, 0, 1, -18),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 5,
		StrokeThickness = 2.5,
	})
	local badge = UIKit.new("Frame", {
		Name = "Badge",
		Size = UDim2.fromOffset(26, 26),
		Position = UDim2.new(1, -2, 0, -4),
		AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = UIKit.Colors.Red,
		Visible = false,
		ZIndex = 8,
		Parent = holder,
	})
	UIKit.round(badge)
	UIKit.stroke(badge, 2.5, UIKit.Colors.Outline, true)
	UIKit.label(badge, { Text = "!", Size = UDim2.fromScale(1, 1), ZIndex = 9, StrokeThickness = 1.5 })
	badges[panel] = badge
end

function HUD.init(gui: ScreenGui, open: (string, any?) -> (), request: (string, any?) -> (boolean, any))
	openPanel = open
	requestAction = request

	-- top-left counters
	local stats = UIKit.new("Frame", {
		Name = "Stats",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(260, 200),
		Position = UDim2.fromOffset(40, 54),
		Parent = gui,
	})
	UIKit.new("UIListLayout", { Padding = UDim.new(0, 14), SortOrder = Enum.SortOrder.LayoutOrder, Parent = stats })
	cashPill, cashText =
		UIKit.pill(stats, { Name = "Cash", Icon = "Cash", Color = Color3.fromRGB(70, 210, 90), LayoutOrder = 1, Text = "$0" })
	bagPill, bagText =
		UIKit.pill(stats, { Name = "Backpack", Icon = "Backpack", Color = Color3.fromRGB(255, 150, 50), LayoutOrder = 2, Text = "0/12" })
	local _, fill = UIKit.bar(bagPill, {
		Size = UDim2.new(1, -70, 0, 10),
		Position = UDim2.new(0, 58, 1, -6),
		Color = UIKit.Colors.Yellow,
		ZIndex = 6,
	})
	bagFill = fill
	bagText.Size = UDim2.new(1, -66, 0.62, 0)
	bagText.Position = UDim2.new(0, 56, 0.4, 0)

	-- goal tracker
	goalFrame = UIKit.new("Frame", {
		Name = "Goal",
		Size = UDim2.fromOffset(300, 74),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = 3,
		Parent = stats,
	})
	UIKit.corner(goalFrame, 16)
	UIKit.gradient(goalFrame, Color3.fromRGB(70, 74, 110), Color3.fromRGB(40, 42, 70))
	UIKit.stroke(goalFrame, 3, UIKit.Colors.Outline, true)
	UIKit.label(goalFrame, {
		Text = "🎯 GOAL",
		Size = UDim2.new(0, 120, 0, 20),
		Position = UDim2.fromOffset(12, 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = UIKit.Colors.Yellow,
		ZIndex = 3,
		StrokeThickness = 2,
	})
	goalText = UIKit.label(goalFrame, {
		Text = "",
		Size = UDim2.new(1, -24, 0, 22),
		Position = UDim2.fromOffset(12, 26),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 3,
		StrokeThickness = 2,
	})
	goalSub = UIKit.label(goalFrame, {
		Text = "",
		Size = UDim2.new(0, 70, 0, 16),
		Position = UDim2.new(1, -12, 0, 8),
		AnchorPoint = Vector2.new(1, 0),
		TextXAlignment = Enum.TextXAlignment.Right,
		ZIndex = 3,
		StrokeThickness = 1.5,
	})
	local _, gf = UIKit.bar(goalFrame, {
		Size = UDim2.new(1, -24, 0, 10),
		Position = UDim2.new(0, 12, 1, -16),
		Color = UIKit.Colors.Yellow,
		ZIndex = 4,
	})
	goalFill = gf

	-- side menu
	local menu = UIKit.new("Frame", {
		Name = "Menu",
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(180, 340),
		Position = UDim2.new(0, 24, 0.5, 40),
		AnchorPoint = Vector2.new(0, 0.5),
		Parent = gui,
	})
	UIKit.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(84, 98),
		CellPadding = UDim2.fromOffset(6, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = menu,
	})
	menuButton(menu, "Backpack", "Backpack", Color3.fromRGB(255, 150, 50), 1, "Inventory")
	menuButton(menu, "Tools", "Tools", Color3.fromRGB(240, 80, 80), 2, "Tools")
	menuButton(menu, "Upgrades", "Upgrades", Color3.fromRGB(80, 210, 110), 3, "Upgrades")
	menuButton(menu, "Machines", "Machines", Color3.fromRGB(70, 150, 255), 4, "Machines")
	menuButton(menu, "Zones", "Zones", Color3.fromRGB(170, 100, 255), 5, "Zones")
	menuButton(menu, "Hub", "Hub", Color3.fromRGB(255, 200, 50), 6, "Hub")

	-- zone banner
	zoneBanner = UIKit.label(gui, {
		Name = "ZoneBanner",
		Text = "",
		Size = UDim2.fromOffset(600, 70),
		Position = UDim2.new(0.5, 0, 0, 120),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextTransparency = 1,
		StrokeThickness = 5,
		ZIndex = 30,
	})
	local st = zoneBanner:FindFirstChildOfClass("UIStroke") :: UIStroke
	st.Transparency = 1

	-- cash counter animation
	cashValue = Instance.new("NumberValue")
	cashValue.Changed:Connect(function(v)
		cashText.Text = Format.cash(v)
	end)

	State.Changed.Event:Connect(HUD.update)
	if State.Data then
		HUD.update(State.Data)
	end
	local _ = player
end

function HUD.update(d)
	if not d then
		return
	end
	-- cash
	if d.Cash ~= displayedCash then
		local diff = d.Cash - displayedCash
		displayedCash = d.Cash
		TweenService:Create(cashValue, TweenInfo.new(0.5, Enum.EasingStyle.Quad), { Value = d.Cash }):Play()
		if diff > 0 then
			UIKit.bump(cashPill, 1.12)
		end
	end
	-- backpack
	local count, cap = State.itemCount(), State.capacity()
	bagText.Text = string.format("%d/%d", count, cap)
	local frac = cap > 0 and math.clamp(count / cap, 0, 1) or 0
	TweenService:Create(bagFill, TweenInfo.new(0.25), { Size = UDim2.fromScale(frac, 1) }):Play()
	local fillGrad = bagFill:FindFirstChildOfClass("UIGradient")
	if fillGrad then
		local c = frac >= 1 and UIKit.Colors.Red or (frac > 0.75 and UIKit.Colors.Orange or UIKit.Colors.Yellow)
		fillGrad.Color = ColorSequence.new(UIKit.lighten(c, 0.25), UIKit.darken(c, 0.1))
	end
	-- goal
	local index, goal, have, need = currentGoal(d)
	if goal then
		HUD.CurrentGoal = goal
		goalFrame.Visible = true
		goalText.Text = goal.Text
		goalSub.Text = string.format("%d/%d", math.min(have, need), need)
		TweenService:Create(goalFill, TweenInfo.new(0.3), { Size = UDim2.fromScale(math.clamp(have / need, 0, 1), 1) }):Play()
		if HUD.LastGoal and HUD.LastGoal ~= index then
			Notify.toast("🎯 Goal complete!", "success")
			UIKit.bump(goalFrame, 1.1)
		end
		HUD.LastGoal = index
	else
		HUD.CurrentGoal = nil
		goalFrame.Visible = false
	end
	-- "!" badges when something is affordable
	local cash = d.Cash
	local function anyUpgrade()
		for id, def in pairs(Config.Upgrades) do
			local lvl = d.Upgrades[id] or 0
			if lvl < def.MaxLevel and Config.UpgradeCost(id, lvl) <= cash then
				return true
			end
		end
		return false
	end
	local function anyTool()
		for id, def in pairs(Config.Tools) do
			if not d.Tools[id] and def.Price <= cash then
				return true
			end
		end
		return false
	end
	local function anyMachine()
		for id, def in pairs(Config.Machines) do
			local lvl = d.Machines[id] or 0
			if lvl < def.MaxLevel and Config.MachineCost(id, lvl) <= cash then
				return true
			end
		end
		return false
	end
	local function anyZone()
		for _, id in ipairs(Config.ZoneOrder) do
			local def = Config.Zones[id]
			if not d.Zones[id] then
				local prev = Config.ZoneOrder[def.Order - 1]
				return (not prev or d.Zones[prev]) and def.Price <= cash
			end
		end
		return false
	end
	badges.Upgrades.Visible = anyUpgrade()
	badges.Tools.Visible = anyTool()
	badges.Machines.Visible = anyMachine()
	badges.Zones.Visible = anyZone()
	badges.Inventory.Visible = count >= cap
end

function HUD.backpackFull()
	UIKit.shake(bagPill)
	UIKit.bump(bagPill, 1.15)
end

function HUD.showZone(name: string, color: Color3)
	zoneBanner.Text = name
	zoneBanner.TextColor3 = color
	local st = zoneBanner:FindFirstChildOfClass("UIStroke") :: UIStroke
	zoneBanner.TextTransparency = 1
	st.Transparency = 1
	TweenService:Create(zoneBanner, TweenInfo.new(0.4), { TextTransparency = 0 }):Play()
	TweenService:Create(st, TweenInfo.new(0.4), { Transparency = 0 }):Play()
	UIKit.pop(zoneBanner, 0.6)
	task.delay(2.5, function()
		if zoneBanner.Text == name then
			TweenService:Create(zoneBanner, TweenInfo.new(0.6), { TextTransparency = 1 }):Play()
			TweenService:Create(st, TweenInfo.new(0.6), { Transparency = 1 }):Play()
		end
	end)
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Notify</string>
            <string name="Source"><![CDATA[-- Notify: toasts, item pop-ups, big banners and floating cash.

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local ScrapModels = require(ReplicatedStorage.Shared.ScrapModels)
local UIKit = require(script.Parent.UIKit)
local Sound = require(script.Parent.Sound)

local Notify = {}

local gui: ScreenGui
local toastHolder: Frame
local itemHolder: Frame

local KIND_COLORS = {
	info = UIKit.Colors.Blue,
	success = UIKit.Colors.Green,
	error = UIKit.Colors.Red,
}

function Notify.init(screen: ScreenGui)
	gui = screen
	toastHolder = UIKit.new("Frame", {
		Name = "Toasts",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 520, 0, 300),
		Position = UDim2.new(0.5, 0, 0, 70),
		AnchorPoint = Vector2.new(0.5, 0),
		ZIndex = 50,
		Parent = gui,
	})
	UIKit.new("UIListLayout", {
		Padding = UDim.new(0, 8),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = toastHolder,
	})
	itemHolder = UIKit.new("Frame", {
		Name = "ItemPopups",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 340, 0, 260),
		Position = UDim2.new(0.5, 0, 1, -110),
		AnchorPoint = Vector2.new(0.5, 1),
		ZIndex = 40,
		Parent = gui,
	})
	UIKit.new("UIListLayout", {
		Padding = UDim.new(0, 6),
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = itemHolder,
	})
end

local order = 0

function Notify.toast(text: string, kind: string?)
	order += 1
	local k = kind or "info"
	local rarity = Config.Rarities[k]
	local color = rarity and rarity.Color or KIND_COLORS[k] or UIKit.Colors.Blue
	local toast = UIKit.new("Frame", {
		Name = "Toast",
		Size = UDim2.new(0, 480, 0, 46),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		ZIndex = 50,
		Parent = toastHolder,
	})
	UIKit.round(toast)
	if rarity then
		UIKit.gradient(toast, rarity.Color, rarity.Color2, 0)
	else
		UIKit.gradient(toast, UIKit.lighten(color, 0.15), UIKit.darken(color, 0.15))
	end
	UIKit.stroke(toast, 3, UIKit.Colors.Outline, true)
	UIKit.gloss(toast, 20)
	UIKit.label(toast, {
		Text = text,
		Size = UDim2.new(1, -30, 1, -12),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 52,
	})
	UIKit.pop(toast, 0.5)
	if k == "error" then
		Sound.play("Error")
	elseif rarity then
		Sound.play("Rare")
	end
	task.delay(k == "error" and 2.2 or 3.2, function()
		local s = toast:FindFirstChild("BounceScale") :: UIScale?
		if s then
			local t = TweenService:Create(s, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 })
			t:Play()
			t.Completed:Wait()
		end
		toast:Destroy()
	end)
	-- keep at most 4 toasts
	local toasts = {}
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(toasts, c)
		end
	end
	if #toasts > 4 then
		table.sort(toasts, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		toasts[1]:Destroy()
	end
end

-- "+1 Rusty Can" card with a 3D icon.
function Notify.item(scrapId: string, amount: number, opts: { [string]: any }?)
	local o = opts or {}
	local def = Config.Scraps[scrapId]
	if not def then
		return
	end
	local rarity = Config.Rarities[def.Rarity]
	order += 1
	local card = UIKit.new("Frame", {
		Name = "ItemPopup",
		Size = UDim2.new(0, 320, 0, 64),
		BackgroundColor3 = Color3.new(1, 1, 1),
		LayoutOrder = order,
		ZIndex = 40,
		Parent = itemHolder,
	})
	UIKit.corner(card, 16)
	UIKit.gradient(card, UIKit.lighten(rarity.Color, 0.35), rarity.Color2, 90)
	UIKit.stroke(card, 3, UIKit.Colors.Outline, true)
	local iconBox = UIKit.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.4,
		Size = UDim2.fromOffset(54, 54),
		Position = UDim2.fromOffset(5, 5),
		ZIndex = 41,
		Parent = card,
	})
	UIKit.corner(iconBox, 12)
	UIKit.viewport(iconBox, ScrapModels.create(scrapId, o.Clean == true), { ZIndex = 42, Spin = true, SpinSpeed = 1.6 })
	local prefix = o.Prefix or "+"
	UIKit.label(card, {
		Text = string.format("%s%d %s", prefix, amount, def.Name),
		Size = UDim2.new(1, -76, 0, 30),
		Position = UDim2.fromOffset(66, 6),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 42,
	})
	local sub = o.Sub or string.upper(rarity.Name)
	if o.Lucky then
		sub = "🍀 LUCKY x2!  " .. sub
	end
	if o.New then
		sub = "✨ NEW!  " .. sub
	end
	UIKit.label(card, {
		Text = sub,
		Size = UDim2.new(1, -76, 0, 20),
		Position = UDim2.fromOffset(66, 38),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 255, 210),
		ZIndex = 42,
		StrokeThickness = 2,
	})
	UIKit.pop(card, 0.4)
	task.delay(2.4, function()
		local tween = TweenService:Create(card, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
		tween:Play()
		for _, d in ipairs(card:GetDescendants()) do
			if d:IsA("TextLabel") then
				TweenService:Create(d, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
			elseif d:IsA("UIStroke") then
				TweenService:Create(d, TweenInfo.new(0.3), { Transparency = 1 }):Play()
			elseif d:IsA("ViewportFrame") then
				TweenService:Create(d, TweenInfo.new(0.3), { ImageTransparency = 1 }):Play()
			elseif d:IsA("Frame") then
				TweenService:Create(d, TweenInfo.new(0.3), { BackgroundTransparency = 1 }):Play()
			end
		end
		task.wait(0.32)
		card:Destroy()
	end)
	local items = {}
	for _, c in ipairs(itemHolder:GetChildren()) do
		if c:IsA("Frame") then
			table.insert(items, c)
		end
	end
	if #items > 3 then
		table.sort(items, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		items[1]:Destroy()
	end
end

-- Big centre banner (zone unlocked, machine built...).
function Notify.banner(title: string, subtitle: string?, color: Color3?)
	local c = color or UIKit.Colors.Yellow
	local holder = UIKit.new("Frame", {
		Name = "Banner",
		BackgroundTransparency = 1,
		Size = UDim2.new(0, 640, 0, 130),
		Position = UDim2.new(0.5, 0, 0.3, 0),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 60,
		Parent = gui,
	})
	-- rays
	local rays = UIKit.new("Frame", {
		BackgroundTransparency = 1,
		Size = UDim2.fromOffset(300, 300),
		Position = UDim2.fromScale(0.5, 0.5),
		AnchorPoint = Vector2.new(0.5, 0.5),
		ZIndex = 60,
		Parent = holder,
	})
	for i = 0, 7 do
		local ray = UIKit.new("Frame", {
			Size = UDim2.new(0, 26, 1, 0),
			Position = UDim2.fromScale(0.5, 0.5),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Rotation = i * 22.5,
			BackgroundColor3 = UIKit.lighten(c, 0.4),
			BackgroundTransparency = 0.55,
			BorderSizePixel = 0,
			ZIndex = 60,
			Parent = rays,
		})
		UIKit.new("UIGradient", {
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1),
				NumberSequenceKeypoint.new(0.5, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
			Rotation = 90,
			Parent = ray,
		})
	end
	local t = UIKit.label(holder, {
		Text = title,
		Size = UDim2.new(1, 0, 0, 78),
		Position = UDim2.fromScale(0.5, 0.38),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = UIKit.lighten(c, 0.3),
		ZIndex = 62,
		StrokeThickness = 5,
	})
	UIKit.gradient(t, Color3.new(1, 1, 1), c, 90)
	if subtitle then
		UIKit.label(holder, {
			Text = subtitle,
			Size = UDim2.new(1, 0, 0, 34),
			Position = UDim2.fromScale(0.5, 0.85),
			AnchorPoint = Vector2.new(0.5, 0.5),
			ZIndex = 62,
			StrokeThickness = 3,
		})
	end
	UIKit.pop(holder, 0.2)
	Sound.play("Purchase")
	local spin = true
	task.spawn(function()
		while spin and rays.Parent do
			rays.Rotation += 1
			task.wait()
		end
	end)
	task.delay(2.2, function()
		local s = holder:FindFirstChild("BounceScale") :: UIScale?
		if s then
			local tw = TweenService:Create(s, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.In), { Scale = 0 })
			tw:Play()
			tw.Completed:Wait()
		end
		spin = false
		holder:Destroy()
	end)
end

-- Floating "+$123" that drifts up from a screen position.
function Notify.floatText(text: string, position: UDim2, color: Color3?)
	local l = UIKit.label(gui, {
		Text = text,
		Size = UDim2.fromOffset(240, 44),
		Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = color or UIKit.Colors.Cash,
		ZIndex = 70,
		StrokeThickness = 3,
	})
	UIKit.pop(l, 0.3)
	local tween = TweenService:Create(l, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = position - UDim2.fromOffset(0, 70),
		TextTransparency = 1,
	})
	tween:Play()
	local st = l:FindFirstChildOfClass("UIStroke")
	if st then
		TweenService:Create(st, TweenInfo.new(1.2), { Transparency = 1 }):Play()
	end
	task.delay(1.25, function()
		l:Destroy()
	end)
end

function Notify.cash(amount: number)
	Sound.play("Cash")
	Notify.floatText("+" .. Format.cash(amount), UDim2.new(0, 190, 0, 70))
end

return Notify
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Panels</string>
            <string name="Source"><![CDATA[-- Panels: every pop-up menu (Backpack, Tools, Upgrades, Machines, Sell,
-- Zones, and the wash-station item picker).

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Format = require(ReplicatedStorage.Shared.Format)
local ScrapModels = require(ReplicatedStorage.Shared.ScrapModels)
local ToolModels = require(ReplicatedStorage.Shared.ToolModels)
local UIKit = require(script.Parent.UIKit)
local State = require(script.Parent.State)
local Notify = require(script.Parent.Notify)
local Sound = require(script.Parent.Sound)

local Panels = {}

type PanelDef = {
	Title: string,
	Emoji: string,
	Color: Color3,
	Size: UDim2?,
	Build: (Frame) -> (),
	Refresh: (Frame, any) -> (),
	Frame: Frame?,
	Content: Frame?,
}

local gui: ScreenGui
local overlay: Frame
local defs: { [string]: PanelDef } = {}
local current: string? = nil
local currentCtx: any = nil
local request: (string, any?, any?) -> (boolean, any)
local onStartCleaning: (any, number) -> ()

local C = UIKit.Colors

----------------------------------------------------------------------
-- Shared bits
----------------------------------------------------------------------
local function scrapViewport(parent: Instance, scrapId: string, clean: boolean, silhouette: boolean?, spin: boolean?)
	local holder = UIKit.new("Frame", {
		Name = "IconBox",
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.35,
		Size = UDim2.new(1, -16, 0, 104),
		Position = UDim2.fromOffset(8, 8),
		ZIndex = 14,
		Parent = parent,
	})
	UIKit.corner(holder, 12)
	local rarity = Config.Rarities[Config.Scraps[scrapId].Rarity]
	UIKit.gradient(holder, UIKit.lighten(rarity.Color, 0.6), UIKit.lighten(rarity.Color2, 0.3))
	local model = ScrapModels.create(scrapId, clean)
	if silhouette then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Color = Color3.fromRGB(30, 32, 50)
				d.Material = Enum.Material.SmoothPlastic
				d.Reflectance = 0
				d.Transparency = (d.Transparency > 0.9) and 1 or 0
			end
		end
	end
	UIKit.viewport(holder, model, { ZIndex = 15, Spin = spin, SpinSpeed = 0.7, Angle = 0.5 })
	return holder
end

local function starText(stars: number): string
	if stars <= 0 then
		return "DIRTY"
	end
	return string.rep("★", stars) .. string.rep("☆", 3 - stars)
end

local function priceButton(parent: Instance, opts)
	return UIKit.button(parent, opts)
end

local function emptyMessage(parent: Instance, text: string)
	UIKit.label(parent, {
		Name = "Empty",
		Text = text,
		Size = UDim2.new(1, -40, 0, 80),
		Position = UDim2.fromScale(0.5, 0.45),
		AnchorPoint = Vector2.new(0.5, 0.5),
		TextColor3 = C.DarkText,
		StrokeThickness = 0,
		ZIndex = 14,
	})
end

----------------------------------------------------------------------
-- Inventory
----------------------------------------------------------------------
local inventoryTab = "Backpack"

defs.Inventory = {
	Title = "Backpack",
	Emoji = "🎒",
	Color = Color3.fromRGB(255, 150, 50),
	Build = function(content)
		local top =
			UIKit.new("Frame", { Name = "Top", BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44), ZIndex = 13, Parent = content })
		local tabs = { { "Backpack", "🎒 Backpack" }, { "Collection", "📖 Collection" } }
		for i, t in ipairs(tabs) do
			UIKit.button(top, {
				Name = "Tab" .. t[1],
				Text = t[2],
				Color = C.Grey,
				Size = UDim2.fromOffset(160, 40),
				Position = UDim2.fromOffset((i - 1) * 170, 0),
				ZIndex = 14,
				OnClick = function()
					inventoryTab = t[1]
					Panels.refresh()
				end,
			})
		end
		local _, fill = UIKit.bar(top, {
			Name = "Capacity",
			Size = UDim2.new(0, 220, 0, 24),
			Position = UDim2.new(1, -10, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			Color = C.Orange,
			ZIndex = 14,
		})
		local _ = fill
		UIKit.label(top, {
			Name = "CapText",
			Text = "",
			Size = UDim2.new(0, 220, 0, 20),
			Position = UDim2.new(1, -10, 0.5, 0),
			AnchorPoint = Vector2.new(1, 0.5),
			ZIndex = 17,
			StrokeThickness = 2,
		})
		local body = UIKit.new("Frame", {
			Name = "Body",
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 1, -54),
			Position = UDim2.fromOffset(0, 54),
			ZIndex = 13,
			Parent = content,
		})
		UIKit.scrollGrid(body, UDim2.fromOffset(148, 196), 12)
	end,
	Refresh = function(content)
		local d = State.Data
		local top = content:FindFirstChild("Top") :: Frame
		for _, name in ipairs({ "Backpack", "Collection" }) do
			local tab = top:FindFirstChild("Tab" .. name) :: TextButton
			UIKit.setButton(tab, name == "Backpack" and "🎒 Backpack" or "📖 Collection", inventoryTab == name and C.Orange or C.Grey)
		end
		local count, cap = State.itemCount(), State.capacity()
		local barBack = top:FindFirstChild("Capacity") :: Frame
		local fill = barBack:FindFirstChild("Fill") :: Frame
		fill.Size = UDim2.fromScale(math.clamp(count / math.max(cap, 1), 0, 1), 1)
		local capText = top:FindFirstChild("CapText") :: TextLabel
		capText.Text = string.format("%d / %d", count, cap)

		local grid = (content:FindFirstChild("Body") :: Frame):FindFirstChild("Grid") :: ScrollingFrame
		UIKit.clear(grid)
		local old = grid.Parent:FindFirstChild("Empty")
		if old then
			old:Destroy()
		end

		if inventoryTab == "Backpack" then
			local stacks = State.stacks()
			if #stacks == 0 then
				emptyMessage(grid.Parent :: Instance, "Your backpack is empty!\nGrab a tool and collect scrap in the yard.")
				return
			end
			for i, s in ipairs(stacks) do
				local rarity = Config.Rarities[s.Def.Rarity]
				local card = UIKit.card(grid, rarity.Color, i)
				scrapViewport(card, s.Id, s.Stars > 0)
				UIKit.label(card, {
					Text = "x" .. s.Count,
					Size = UDim2.fromOffset(60, 26),
					Position = UDim2.new(1, -12, 0, 12),
					AnchorPoint = Vector2.new(1, 0),
					TextXAlignment = Enum.TextXAlignment.Right,
					ZIndex = 17,
					StrokeThickness = 2.5,
				})
				UIKit.label(card, {
					Text = s.Def.Name,
					Size = UDim2.new(1, -12, 0, 22),
					Position = UDim2.fromOffset(6, 116),
					TextColor3 = C.DarkText,
					StrokeThickness = 0,
					ZIndex = 16,
				})
				local status = UIKit.label(card, {
					Text = s.Stars > 0 and starText(s.Stars) or "🧽 DIRTY",
					Size = UDim2.new(1, -12, 0, 22),
					Position = UDim2.fromOffset(6, 138),
					TextColor3 = s.Stars > 0 and C.Yellow or Color3.fromRGB(190, 120, 70),
					ZIndex = 16,
					StrokeThickness = 2,
				})
				local _ = status
				UIKit.rarityChip(
					card,
					rarity,
					{ Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(110, 22) }
				)
			end
		else
			local ids = {}
			for id in pairs(Config.Scraps) do
				table.insert(ids, id)
			end
			table.sort(ids, function(a, b)
				local ra = Config.Rarities[Config.Scraps[a].Rarity].Order
				local rb = Config.Rarities[Config.Scraps[b].Rarity].Order
				if ra ~= rb then
					return ra < rb
				end
				return Config.Scraps[a].Value < Config.Scraps[b].Value
			end)
			for i, id in ipairs(ids) do
				local def = Config.Scraps[id]
				local rarity = Config.Rarities[def.Rarity]
				local found = d.Discovered[id] == true
				local card = UIKit.card(grid, found and rarity.Color or C.Grey, i)
				scrapViewport(card, id, true, not found)
				UIKit.label(card, {
					Text = found and def.Name or "???",
					Size = UDim2.new(1, -12, 0, 22),
					Position = UDim2.fromOffset(6, 116),
					TextColor3 = C.DarkText,
					StrokeThickness = 0,
					ZIndex = 16,
				})
				UIKit.label(card, {
					Text = found and ("Worth " .. Format.cash(def.Value) .. "+") or "Not found yet",
					Size = UDim2.new(1, -12, 0, 18),
					Position = UDim2.fromOffset(6, 140),
					TextColor3 = found and C.Cash or C.Grey,
					ZIndex = 16,
					StrokeThickness = 1.5,
				})
				UIKit.rarityChip(
					card,
					rarity,
					{ Position = UDim2.new(0.5, 0, 1, -8), AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(110, 22) }
				)
			end
		end
	end,
}

----------------------------------------------------------------------
-- Tools
----------------------------------------------------------------------
defs.Tools = {
	Title = "Tool Shop",
	Emoji = "🔧",
	Color = Color3.fromRGB(240, 80, 80),
	Size = UDim2.fromOffset(780, 500),
	Build = function(content)
		UIKit.scrollGrid(content, UDim2.fromOffset(226, 330), 14)
	end,
	Refresh = function(content)
		local d = State.Data
		local grid = content:FindFirstChild("Grid") :: ScrollingFrame
		UIKit.clear(grid)
		for i, id in ipairs(Config.ToolOrder) do
			local def = Config.Tools[id]
			local card = UIKit.card(grid, def.Color, i)
			local box = UIKit.new("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 0.3,
				Size = UDim2.new(1, -16, 0, 130),
				Position = UDim2.fromOffset(8, 8),
				ZIndex = 14,
				Parent = card,
			})
			UIKit.corner(box, 12)
			UIKit.gradient(box, UIKit.lighten(def.Color, 0.7), UIKit.lighten(def.Color, 0.3))
			local model = ToolModels.create(id)
			UIKit.viewport(box, model, { ZIndex = 15, Spin = true, SpinSpeed = 0.9, Zoom = 0.9 })
			UIKit.label(card, {
				Text = def.Name,
				Size = UDim2.new(1, -12, 0, 28),
				Position = UDim2.fromOffset(6, 142),
				TextColor3 = def.Color,
				ZIndex = 16,
				StrokeThickness = 2.5,
			})
			UIKit.label(card, {
				Text = def.Description,
				Size = UDim2.new(1, -20, 0, 36),
				Position = UDim2.fromOffset(10, 172),
				TextColor3 = C.DarkText,
				Font = UIKit.BodyFont,
				TextWrapped = true,
				StrokeThickness = 0,
				ZIndex = 16,
			})
			local minRarity = "Common"
			for _, r in ipairs(Config.RarityOrder) do
				if Config.Rarities[r].MinPower <= def.Power then
					minRarity = r
				end
			end
			UIKit.label(card, {
				Text = string.format("⚡ %d   📏 %d   🎯 x%d", def.Power, def.Range, def.Targets),
				Size = UDim2.new(1, -12, 0, 22),
				Position = UDim2.fromOffset(6, 212),
				ZIndex = 16,
				StrokeThickness = 2,
			})
			UIKit.label(card, {
				Text = "Mines up to " .. minRarity,
				Size = UDim2.new(1, -12, 0, 18),
				Position = UDim2.fromOffset(6, 238),
				TextColor3 = Config.Rarities[minRarity].Color,
				ZIndex = 16,
				StrokeThickness = 2,
			})
			local owned = d.Tools[id] == true
			local equipped = d.EquippedTool == id
			local text, color
			if equipped then
				text, color = "EQUIPPED", C.Grey
			elseif owned then
				text, color = "EQUIP", C.Blue
			else
				text = "BUY " .. Format.cash(def.Price)
				color = d.Cash >= def.Price and C.Green or C.Red
			end
			priceButton(card, {
				Text = text,
				Color = color,
				Size = UDim2.new(1, -24, 0, 46),
				Position = UDim2.new(0.5, 0, 1, -10),
				AnchorPoint = Vector2.new(0.5, 1),
				ZIndex = 16,
				OnClick = function()
					if equipped then
						return
					end
					local ok, err = request(owned and "EquipTool" or "BuyTool", id)
					if not ok then
						Notify.toast(err or "Can't do that", "error")
					elseif not owned then
						Notify.banner("NEW TOOL!", def.Name, def.Color)
					end
				end,
			})
		end
	end,
}

